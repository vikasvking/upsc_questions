<%# The exams Rankwise covers, with how many public questions each has (counts hidden until there are questions) %>
<section class="border-y border-slate-200/70 dark:border-slate-800 bg-white dark:bg-slate-900">
  <div class="mx-auto max-w-6xl px-6 py-5 flex flex-wrap items-center gap-2.5">
    <p class="mr-2 text-sm text-slate-600 dark:text-slate-400">Choose your exam</p>
    <% @exam_counts.each do |exam, count| %>
      <%= link_to new_registration_path, class: "inline-flex items-baseline gap-2 rounded-full border border-slate-300 dark:border-slate-700 px-3.5 py-2 text-sm text-slate-900 dark:text-slate-100 hover:border-brand-700 dark:hover:border-brand-400" do %>
        <span class="font-semibold"><%= exam.name %></span>
        <% if count %><span class="text-[13px] text-slate-600 dark:text-slate-400"><%= pluralize(number_with_delimiter(count), "question") %></span><% end %>
      <% end %>
    <% end %>
  </div>
</section>
