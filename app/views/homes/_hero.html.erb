<%# The top of the home page: headline, and the newest free sample question on an OMR-style answer sheet %>
<% q = @sample_question %>
<section class="relative isolate overflow-hidden bg-gradient-to-br from-white via-rose-50/70 to-indigo-50/70 dark:from-slate-950 dark:via-slate-950 dark:to-indigo-950/30">
  <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-40 h-[34rem] w-[34rem] rounded-full bg-brand-200/30 blur-3xl dark:bg-brand-700/15"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-48 -left-40 h-[30rem] w-[30rem] rounded-full bg-indigo-200/30 blur-3xl dark:bg-indigo-700/10"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pb-20 pt-12 sm:pt-16 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16 lg:pb-24 lg:pt-20">
    <div>
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/80 px-3.5 py-1.5 text-sm font-semibold text-brand-800 shadow-sm dark:border-brand-800 dark:bg-slate-900/80 dark:text-brand-200">
        <span class="h-2 w-2 rounded-full bg-emerald-500 ring-4 ring-emerald-500/15"></span>
        Exam practice, built around you
      </p>
      <h1 class="font-paper font-extrabold text-5xl sm:text-6xl lg:text-7xl leading-[0.98] tracking-tight text-slate-950 dark:text-white">
        Fill the bubble.<br>Know where you stand.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        Practice questions and timed tests for UPSC, JEE, NEET, SSC, Banking and CBSE, marked the way each exam marks.
        Try the newest sample question on the answer sheet, no sign-up needed.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= link_to "Start practising free", new_registration_path, class: "rounded-xl bg-brand-700 px-6 py-3.5 text-center font-semibold text-white shadow-lg shadow-brand-700/20 transition hover:-translate-y-0.5 hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700" %>
        <%= link_to "I have an account", new_session_path, class: "rounded-xl bg-white/80 px-6 py-3.5 text-center font-semibold text-slate-800 shadow-sm ring-1 ring-inset ring-slate-200 transition hover:bg-white dark:bg-slate-900/80 dark:text-slate-200 dark:ring-slate-700 dark:hover:bg-slate-900" %>
      </div>
      <p class="mt-4 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400"><span aria-hidden="true" class="text-emerald-600 dark:text-emerald-400">✓</span> Free while in beta. No payment details needed.</p>
    </div>

    <%# The answer sheet. Free samples only, so putting the answer in the page gives nothing away. %>
    <div class="overflow-hidden rounded-2xl border border-white/80 bg-white shadow-2xl shadow-slate-900/10 ring-1 ring-slate-900/5 dark:border-slate-700 dark:bg-slate-900 dark:shadow-black/30 dark:ring-white/5"
         data-controller="answer-sheet" data-answer-sheet-correct-value="<%= q.correct_answer %>">
      <div aria-hidden="true" class="flex w-[22px] shrink-0 flex-col items-center justify-around border-r border-brand-700/15 bg-brand-700/[0.05] py-3.5 dark:border-brand-400/20 dark:bg-brand-400/10">
        <% 14.times do %><span class="block h-1 w-2.5 bg-slate-800 dark:bg-slate-300"></span><% end %>
      </div>

      <div class="min-w-0 flex-1 p-5 sm:p-7 lg:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
          <p class="font-paper-semi font-bold text-[15px] text-brand-700 dark:text-brand-400"><%= q.example? ? "Example question" : "Newest sample question" %></p>
          <p class="text-[13px] text-slate-600 dark:text-slate-400"><%= q.where_from %></p>
        </div>

        <div class="mt-3.5 flex items-start gap-3">
          <p class="font-paper font-bold text-lg text-slate-900 dark:text-white">Q.</p>
          <p class="flex-1 text-lg leading-normal font-semibold text-slate-900 dark:text-white"><%= q.content %></p>
          <% if q.marks_label %><p class="mt-1 text-xs text-slate-600 dark:text-slate-400 whitespace-nowrap"><%= q.marks_label %></p><% end %>
        </div>

        <div class="mt-4 space-y-1.5">
          <% q.options.each do |letter, text| %>
            <div data-answer-sheet-target="option" data-letter="<%= letter %>"
                 class="flex gap-2.5 rounded-md border border-slate-100 dark:border-slate-800 px-2.5 py-2 text-[15px] text-slate-700 dark:text-slate-300
                        data-[correct=true]:bg-emerald-50 data-[correct=true]:border-emerald-300 dark:data-[correct=true]:bg-emerald-950/40 dark:data-[correct=true]:border-emerald-800">
              <span class="w-5 font-bold text-slate-900 dark:text-white"><%= letter %></span>
              <span><%= text %></span>
            </div>
          <% end %>
        </div>

        <div class="mt-5 pt-4 border-t-[1.5px] border-dashed border-brand-700/35 dark:border-brand-400/40">
          <p class="text-[13px] text-slate-600 dark:text-slate-400">Fill one bubble to answer</p>
          <div class="mt-3 flex flex-wrap gap-3.5">
            <% q.options.each do |letter, text| %>
              <button type="button" data-answer-sheet-target="bubble" data-letter="<%= letter %>" data-action="answer-sheet#pick"
                      aria-pressed="false" aria-label="Answer <%= letter %>: <%= text %>"
                      class="h-12 w-12 rounded-full border-2 border-brand-700 dark:border-brand-400 bg-white dark:bg-slate-900 font-paper-semi font-bold text-base text-brand-700 dark:text-brand-300 cursor-pointer
                             hover:bg-brand-50 dark:hover:bg-brand-950/40
                             aria-pressed:bg-slate-800 aria-pressed:border-slate-800 aria-pressed:text-white dark:aria-pressed:bg-slate-100 dark:aria-pressed:border-slate-100 dark:aria-pressed:text-slate-900
                             data-[correct=true]:border-emerald-600 data-[correct=true]:ring-4 data-[correct=true]:ring-emerald-600/25
                             focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-blue-700"><%= letter %></button>
            <% end %>
          </div>
        </div>

        <div aria-live="polite">
          <div data-answer-sheet-target="right" hidden class="mt-4 rounded-md bg-emerald-50 dark:bg-emerald-950/40 px-4 py-3.5 text-emerald-900 dark:text-emerald-200">
            <p class="font-bold">Correct.<% if q.show_stats? %> Lakshyank students get this right <%= q.right_pct %>% of the time.<% end %></p>
            <% if q.explanation.present? %><p class="mt-1.5 text-sm leading-relaxed"><%= q.explanation %></p><% end %>
          </div>
          <div data-answer-sheet-target="wrong" hidden class="mt-4 rounded-md bg-red-50 dark:bg-red-950/40 px-4 py-3.5 text-red-900 dark:text-red-200">
            <p class="font-bold">Not this one. The answer is <%= q.correct_answer %>, <%= q.correct_text %>.<% if q.show_stats? %> Lakshyank students get it right <%= q.right_pct %>% of the time.<% end %></p>
            <% if q.explanation.present? %><p class="mt-1.5 text-sm leading-relaxed"><%= q.explanation %></p><% end %>
          </div>
          <div data-answer-sheet-target="after" hidden class="mt-3.5 flex flex-wrap items-center gap-4 text-sm">
            <%= link_to(q.topic.present? ? "Practise more #{q.topic} questions" : "Practise more questions", new_registration_path,
                        class: "font-semibold text-brand-700 dark:text-brand-400 hover:underline") %>
            <button type="button" data-action="answer-sheet#clear" class="text-slate-600 dark:text-slate-400 underline cursor-pointer">Clear my answer</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
