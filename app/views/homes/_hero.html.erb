<section class="relative overflow-hidden">
  <div class="absolute inset-x-0 -top-24 h-[28rem] bg-gradient-to-b from-brand-50 to-transparent dark:from-brand-950/30 -z-10"></div>
  <div class="mx-auto max-w-6xl px-6 pt-16 pb-20 lg:pt-24 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white dark:bg-slate-900 ring-1 ring-slate-200 dark:ring-slate-800 px-3 py-1 text-sm text-slate-600 dark:text-slate-300">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Free while in beta
      </p>
      <h1 class="mt-5 text-4xl sm:text-5xl font-semibold tracking-tight text-slate-900 dark:text-white leading-[1.1]">
        Practise smarter.<br><span class="text-brand-700 dark:text-brand-400">Rank higher.</span>
      </h1>
      <p class="mt-5 text-lg text-slate-600 dark:text-slate-400 max-w-xl">
        Topic-wise practice and timed tests for UPSC, JEE, NEET, SSC, Banking and CBSE. See every explanation, track your progress, and find out exactly where you stand against the toppers.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <%= link_to "Start practising free", new_registration_path, class: "rounded-lg bg-brand-700 px-5 py-3 text-center text-sm font-medium text-white shadow-sm hover:bg-brand-800" %>
        <%= link_to "I already have an account", new_session_path, class: "rounded-lg bg-white dark:bg-slate-900 px-5 py-3 text-center text-sm font-medium text-slate-700 dark:text-slate-200 ring-1 ring-slate-200 dark:ring-slate-700 hover:bg-slate-50" %>
      </div>
      <p class="mt-4 text-sm text-slate-500">No payment details needed. Teachers get their own workspace.</p>
    </div>

    <!-- Example of the practice screen (illustration, not live data) -->
    <div class="relative sm:pb-10">
      <div class="rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-slate-200 dark:ring-slate-800 shadow-xl shadow-slate-200/60 dark:shadow-none p-6 space-y-4">
        <div class="flex items-center justify-between text-sm">
          <span class="text-slate-500">Example · Indian Polity · Q2 of 20</span>
          <span class="rounded-full bg-emerald-50 text-emerald-700 px-2 py-0.5 text-xs font-medium">✓ Correct</span>
        </div>
        <p class="font-medium text-slate-900 dark:text-white">Which Article of the Constitution provides the Right to Constitutional Remedies?</p>
        <div class="grid grid-cols-2 gap-2 text-sm">
          <div class="rounded-lg ring-1 ring-slate-200 dark:ring-slate-700 px-3 py-2 text-slate-600 dark:text-slate-300">A. Article 14</div>
          <div class="rounded-lg ring-1 ring-slate-200 dark:ring-slate-700 px-3 py-2 text-slate-600 dark:text-slate-300">B. Article 19</div>
          <div class="rounded-lg ring-1 ring-slate-200 dark:ring-slate-700 px-3 py-2 text-slate-600 dark:text-slate-300">C. Article 21</div>
          <div class="rounded-lg bg-emerald-50 dark:bg-emerald-950/40 ring-1 ring-emerald-300 px-3 py-2 font-medium text-emerald-800 dark:text-emerald-300">D. Article 32</div>
        </div>
        <p class="text-sm text-slate-500 border-t border-slate-100 dark:border-slate-800 pt-3">Article 32 lets citizens go to the Supreme Court to enforce Fundamental Rights.</p>
      </div>
      <div class="relative mt-4 sm:mt-0 sm:absolute sm:bottom-0 sm:-left-8 inline-block rounded-xl bg-white dark:bg-slate-900 ring-1 ring-slate-200 dark:ring-slate-800 shadow-lg px-4 py-3">
        <p class="text-xs text-slate-500">Example test result</p>
        <p class="text-sm font-semibold text-slate-900 dark:text-white">🥉 Rank 3 of 41 · 37.3 / 40 marks</p>
      </div>
    </div>
  </div>
</section>
