<section id="pricing" class="mx-auto max-w-6xl px-6 pb-20 scroll-mt-16">
  <div class="rounded-3xl bg-brand-700 dark:bg-brand-900 px-8 py-12 sm:px-12 grid md:grid-cols-[1fr_auto] gap-8 items-center text-white">
    <div>
      <p class="text-sm text-brand-100">Pricing</p>
      <h2 class="mt-1 text-3xl font-semibold tracking-tight">Free while in beta</h2>
      <p class="mt-3 text-brand-100 max-w-xl">Everything is included: all exams and topics, timed tests, explanations, ranks and topper comparison. We'll tell you well in advance before any paid plan starts.</p>
    </div>
    <div class="flex flex-col sm:flex-row md:flex-col gap-3">
      <%= link_to "Create free account", new_registration_path, class: "rounded-lg bg-white px-5 py-3 text-center text-sm font-medium text-brand-800 hover:bg-brand-50" %>
      <%= link_to "Log in", new_session_path, class: "rounded-lg px-5 py-3 text-center text-sm font-medium text-white ring-1 ring-white/40 hover:bg-white/10" %>
    </div>
  </div>
</section>
