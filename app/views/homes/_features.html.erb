<%# What Rankwise does that a PDF paper or a form in a group chat cannot (every item here is a real feature) %>
<%
  h3 = "font-paper-semi font-bold text-[21px] leading-snug text-slate-900 dark:text-white"
  body = "mt-2 text-[15px] leading-relaxed text-slate-700 dark:text-slate-300"
  chip = "rounded border border-brand-700/35 dark:border-brand-400/40 px-2 py-0.5 text-slate-900 dark:text-slate-100"
  marking = [["UPSC Prelims", "UPSC_PRELIMS"], ["JEE Main, NEET", "JEE_MAIN"], ["SSC CGL, CHSL", "SSC_CGL"], ["IBPS", "IBPS"], ["CBSE X, XII", "CBSE_XII"]]
  num = ->(n) { n.round(2).to_s.sub(/\.0\z/, "") }
  # a sample question grid: answered, marked for review, skipped, not yet
  grid = %w[a a m a s o a m o o]
%>
<section id="features" class="bg-white dark:bg-slate-900 border-y border-slate-200/70 dark:border-slate-800 scroll-mt-16">
  <div class="mx-auto max-w-6xl px-6 py-20 grid lg:grid-cols-[1fr_2fr] gap-14">
    <div class="lg:sticky lg:top-24 self-start">
      <h2 class="font-paper font-extrabold text-4xl sm:text-[44px] leading-[1.05] text-slate-900 dark:text-white">Built like the real exam. Fair for the whole class.</h2>
      <p class="mt-4 leading-relaxed text-slate-700 dark:text-slate-300">The things a PDF paper or a form in a group chat can’t do for you.</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-12">
      <div>
        <h3 class="<%= h3 %>">Every student gets a different paper</h3>
        <p class="<%= body %>">In strict tests the questions and the options are shuffled for each student, so answers can’t be passed along a classroom.</p>
        <div aria-hidden="true" class="mt-3.5 space-y-1.5 text-[13px] text-slate-600 dark:text-slate-400">
          <% [["Riya", %w[3 1 4 2]], ["Arjun", %w[2 4 1 3]]].each do |name, order| %>
            <div class="flex items-center gap-1.5"><span class="w-12"><%= name %></span><% order.each do |n| %><span class="<%= chip %>">Q<%= n %></span><% end %></div>
          <% end %>
        </div>
      </div>

      <div>
        <h3 class="<%= h3 %>">Leaving the test is noticed</h3>
        <p class="<%= body %>">Switch to another tab or app once and you get a warning. Do it again and you’re blocked until your teacher lets you back in. The Android app blocks screenshots too.</p>
      </div>

      <div>
        <h3 class="<%= h3 %>">Marked the way your exam marks</h3>
        <p class="<%= body %>">Each exam’s own negative marking, so your practice score means what your real score will.</p>
        <table class="mt-3.5 w-full max-w-xs text-sm text-slate-700 dark:text-slate-300">
          <thead class="text-[13px] text-slate-600 dark:text-slate-400"><tr><th class="py-1 text-left font-semibold">Exam</th><th class="py-1 text-right font-semibold">Right</th><th class="py-1 text-right font-semibold">Wrong</th></tr></thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% marking.each do |label, code| %>
              <% e = Exam::BY_CODE.fetch(code) %>
              <tr><td class="py-1"><%= label %></td><td class="py-1 text-right tabular-nums">+<%= num.(e.correct) %></td><td class="py-1 text-right tabular-nums"><%= e.wrong.zero? ? "0" : "−#{num.(e.wrong)}" %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div>
        <h3 class="<%= h3 %>">Review before you submit</h3>
        <p class="<%= body %>">Mark questions for review and come back to them. The test stays open until you submit or the time runs out, like the computer-based exams.</p>
        <div aria-hidden="true" class="mt-3.5 flex flex-wrap gap-1.5">
          <% grid.each_with_index do |s, i| %>
            <span class="relative grid h-[30px] w-[30px] place-items-center rounded-md text-xs font-semibold <%= { "a" => "bg-slate-800 text-white dark:bg-slate-100 dark:text-slate-900", "m" => "bg-slate-800 text-white dark:bg-slate-100 dark:text-slate-900", "s" => "bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300", "o" => "border border-slate-300 text-slate-600 dark:border-slate-600 dark:text-slate-400" }.fetch(s) %>">
              <%= i + 1 %>
              <% if s == "m" %><span class="absolute -top-1 -right-1 h-2.5 w-2.5 rounded-full bg-violet-600 ring-2 ring-white dark:ring-slate-900"></span><% end %>
            </span>
          <% end %>
        </div>
      </div>

      <div>
        <h3 class="<%= h3 %>">A separate rank for every exam</h3>
        <p class="<%= body %>">Your UPSC rank is only against UPSC students and your NEET rank only against NEET students, with the toppers’ numbers to aim for.</p>
      </div>

      <div>
        <h3 class="<%= h3 %>">See exactly what to fix</h3>
        <p class="<%= body %>">Topic progress shows which questions you still get wrong, and your dashboard points you to your weakest topic next.</p>
      </div>

      <div>
        <h3 class="<%= h3 %>">Retake as often as you like</h3>
        <p class="<%= body %>">Practise a test again once it closes. Your first attempt keeps its rank, so retakes are pure practice.</p>
      </div>

      <div>
        <h3 class="<%= h3 %>">Safe for school students</h3>
        <p class="<%= body %>">Students under 18 join with a consent code sent to a parent’s email.</p>
      </div>
    </div>
  </div>
</section>
