<%
  input = "mt-1 block w-full rounded-lg border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-700"
  label = "text-sm font-medium text-slate-700 dark:text-slate-300"
%>
<footer class="border-t border-slate-200/70 dark:border-slate-800">
  <div id="contact" class="scroll-mt-16">
    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="mx-auto max-w-6xl px-6 pt-8">
        <p class="rounded-lg px-4 py-3 text-sm <%= flash[:alert].present? ? "bg-red-50 text-red-800 dark:bg-red-950/40 dark:text-red-300" : "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300" %>" role="status">
          <%= flash[:alert].presence || flash[:notice] %>
        </p>
      </div>
    <% end %>

    <% if @contact_open %>
      <div class="mx-auto max-w-6xl px-6 py-14 grid lg:grid-cols-[2fr_3fr] gap-10">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Contact us</h2>
          <p class="mt-3 text-slate-600 dark:text-slate-400">Want a custom plan for your school or coaching, or have a question? Write to us and the Rankwise team will reply by email.</p>
        </div>

        <%= form_with model: @contact_message, url: contact_messages_path, class: "grid sm:grid-cols-2 gap-4" do |f| %>
          <% if @contact_message.errors.any? %>
            <div class="sm:col-span-2 rounded-lg bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300" role="alert">
              <p class="font-medium">Please fix this:</p>
              <ul class="mt-1 list-disc pl-5"><% @contact_message.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
            </div>
          <% end %>

          <div>
            <%= f.label :name, "Your name", class: label %>
            <%= f.text_field :name, required: true, maxlength: 100, autocomplete: "name", class: input %>
          </div>
          <div>
            <%= f.label :email, "Email", class: label %>
            <%= f.email_field :email, required: true, maxlength: 254, autocomplete: "email", class: input %>
          </div>
          <div>
            <%= f.label :phone, "Phone (optional)", class: label %>
            <%= f.telephone_field :phone, maxlength: 20, autocomplete: "tel", class: input %>
          </div>
          <div>
            <%= f.label :organisation, "School or coaching (optional)", class: label %>
            <%= f.text_field :organisation, maxlength: 150, autocomplete: "organization", class: input %>
          </div>
          <div class="sm:col-span-2">
            <%= f.label :topic, "About", class: label %>
            <%= f.select :topic, ContactMessage::TOPICS.map { |k, v| [v, k] }, {}, class: input %>
          </div>
          <div class="sm:col-span-2">
            <%= f.label :message, class: label %>
            <%= f.text_area :message, required: true, rows: 5, maxlength: 3000, class: input,
                  placeholder: "For a custom plan: how many students and teachers, which exams, and how many tests a month." %>
          </div>

          <%# Hidden from people; bots that fill it in are ignored %>
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="contact_website">Website</label>
            <input type="text" name="website" id="contact_website" tabindex="-1" autocomplete="off">
          </div>

          <div class="sm:col-span-2 flex items-center justify-between gap-4">
            <p class="text-xs text-slate-500">We only use your details to reply to you.</p>
            <%= f.submit "Send message", class: "rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-brand-800 cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="border-t border-slate-200/70 dark:border-slate-800">
    <div class="mx-auto max-w-6xl px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
      <div class="flex items-center gap-2">
        <span class="h-6 w-6 rounded-md bg-brand-700 text-white grid place-items-center text-xs font-semibold">R</span>
        <span class="font-semibold text-slate-900 dark:text-white">Rankwise</span>
      </div>
      <p>&copy; <%= Time.current.year %> Rankwise. Practice for UPSC, JEE, NEET, SSC, Banking and CBSE.</p>
    </div>
  </div>
</footer>
