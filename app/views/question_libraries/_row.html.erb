<%# One library question in the test form's picker. Ticking it moves the card into "In This Test" (see search_script). %>
<label class="library-row-item flex items-start gap-4 p-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 cursor-pointer hover:border-brand-800/40 transition-colors" data-question-id="<%= q.id %>">
  <div class="mt-1">
    <%= check_box_tag "test_session[question_ids][]", q.id, false, id: "library_q_#{q.id}", class: "question-checkbox library-repository-checkbox accent-brand-800 h-4 w-4 rounded" %>
  </div>
  <div class="space-y-1.5 flex-1 min-w-0">
    <div class="flex items-center gap-x-2 flex-wrap gap-y-1">
      <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"><%= exam_name(q.exam_type) %></span>
      <span class="inline-block px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300"><%= q.topic %></span>
      <span class="text-xs font-bold font-mono text-slate-400 ml-auto"><%= q.year %></span>
    </div>
    <p class="text-xs font-semibold text-slate-900 dark:text-white leading-relaxed"><%= q.content %></p>
  </div>
</label>
