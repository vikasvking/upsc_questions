<%
  topics  = @progress.topic_stats
  shown   = (topics.select(&:started?).sort_by { |t| [-t.progress_pct, t.topic] } + topics.reject(&:started?)).first(3)
  focus   = @progress.focus_topic
  cmp     = @comparison
  top_score = cmp[:top][:score]
  my_score  = cmp[:me].score.to_f
  bar_pct   = top_score.to_f.positive? ? [(my_score / top_score * 100).round, 100].min : 0
  card    = "bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 shadow-[0_1px_2px_rgba(15,23,42,0.04)] p-5"
%>
<section class="grid grid-cols-1 lg:grid-cols-3 gap-4">

  <!-- This week -->
  <div class="<%= card %> space-y-4">
    <div class="flex items-baseline justify-between">
      <h2 class="font-semibold text-slate-900 dark:text-white">This week</h2>
      <span class="text-sm text-slate-500">target 25/day</span>
    </div>
    <div class="flex justify-between">
      <% @streak_days.each do |day| %>
        <%
          circle =
            if day[:target_fulfilled] then "bg-brand-700 text-white font-medium"
            elsif day[:is_today] then "ring-2 ring-brand-300 text-brand-800 dark:text-brand-200 font-medium"
            else "bg-slate-100 dark:bg-slate-800 text-slate-400"
            end
        %>
        <div class="flex flex-col items-center gap-1.5" title="<%= day[:solved_count] %> questions">
          <span class="text-xs text-slate-400"><%= day[:day_name] %></span>
          <span class="grid h-9 w-9 place-items-center rounded-full text-sm <%= circle %>"><%= day[:day_number] %></span>
        </div>
      <% end %>
    </div>
    <p class="text-sm text-slate-500">Today: <span class="font-medium text-slate-900 dark:text-white"><%= @streak_days.last&.dig(:solved_count).to_i %></span> answered</p>
  </div>

  <!-- Topic progress -->
  <div class="<%= card %> space-y-4">
    <div class="flex items-baseline justify-between">
      <h2 class="font-semibold text-slate-900 dark:text-white">Topic progress</h2>
      <span class="text-sm text-slate-500"><%= @progress.topics_completed_count %> of <%= topics.size %> done</span>
    </div>
    <% if shown.any? %>
      <% shown.each do |t| %>
        <div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-700 dark:text-slate-300 truncate pr-2"><%= t.topic %><% if t.completed? %> <span class="text-emerald-600">✓</span><% end %></span>
            <span class="text-slate-500 tabular-nums shrink-0"><%= t.solved %>/<%= t.total %></span>
          </div>
          <div class="mt-1.5 h-1.5 rounded-full bg-slate-100 dark:bg-slate-800">
            <div class="h-1.5 rounded-full <%= t.completed? ? "bg-emerald-500" : "bg-brand-600" %>" style="width: <%= t.progress_pct %>%"></div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500">No questions uploaded yet.</p>
    <% end %>
    <%= link_to "All topics →", question_bank_path, class: "inline-block text-sm font-medium text-brand-700 dark:text-brand-300" %>
  </div>

  <!-- You vs top 10 -->
  <div class="<%= card %> space-y-3">
    <div class="flex items-baseline justify-between">
      <h2 class="font-semibold text-slate-900 dark:text-white">You vs top <%= cmp[:top_count].positive? ? cmp[:top_count] : Leaderboard::TOP_N %> · <%= cmp[:exam].name %></h2>
      <span class="text-sm text-slate-500">rank score</span>
    </div>
    <% if @rank_exams.size > 1 %>
      <div class="flex flex-wrap gap-1.5">
        <% @rank_exams.each do |e| %>
          <%= link_to e.name, dashboard_path(exam: e.code),
                class: "rounded-full px-2.5 py-0.5 text-xs font-medium #{e.code == cmp[:exam].code ? "bg-brand-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300"}" %>
        <% end %>
      </div>
    <% end %>
    <div class="flex items-end gap-3">
      <p class="text-3xl font-semibold text-slate-900 dark:text-white tabular-nums"><%= number_with_delimiter(my_score.round) %></p>
      <p class="pb-1 text-sm text-slate-500">top avg <%= top_score ? number_with_delimiter(top_score.round) : "—" %></p>
    </div>
    <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800"><div class="h-2 rounded-full bg-brand-600" style="width: <%= bar_pct %>%"></div></div>
    <% if focus %>
      <p class="text-sm text-slate-500">Focus next:
        <%= link_to focus.topic, dashboard_path(topic: focus.topic), class: "font-medium text-brand-700 dark:text-brand-300" %>
        <%= focus.started? ? "(#{focus.accuracy_pct}% accuracy)" : "(not started)" %>
      </p>
    <% end %>

    <details class="group text-sm">
      <summary class="cursor-pointer text-slate-500 hover:text-slate-900 dark:hover:text-white list-none">
        <span class="group-open:hidden">Show full comparison ▾</span><span class="hidden group-open:inline">Hide ▴</span>
      </summary>
      <table class="mt-3 w-full text-sm">
        <thead><tr class="text-xs text-slate-400"><th class="text-left font-normal pb-1"></th><th class="text-right font-normal pb-1">You</th><th class="text-right font-normal pb-1">Top</th><th class="text-right font-normal pb-1">All</th></tr></thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% Leaderboard::METRICS.each do |key, label, _| %>
            <% mine = cmp[:me][key] %>
            <% better = metric_better?(key, mine, cmp[:top][key]) %>
            <tr>
              <td class="py-1.5 text-slate-500"><%= label %></td>
              <td class="py-1.5 text-right font-medium <%= better.nil? ? "text-slate-900 dark:text-white" : (better ? "text-emerald-600" : "text-red-600") %>"><%= metric_value(key, mine) %></td>
              <td class="py-1.5 text-right text-slate-700 dark:text-slate-300"><%= metric_value(key, cmp[:top][key]) %></td>
              <td class="py-1.5 text-right text-slate-400"><%= metric_value(key, cmp[:platform][key]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="mt-2 text-xs text-slate-400 leading-relaxed">
        Ranked only against <%= cmp[:exam].name %> students, on <%= cmp[:exam].name %> questions. Each solved question earns 10 points on the 1st try, 6 on the 2nd, 3 after that, plus up to 2 for speed (full at 30 s, none at 2 min).
        <% if (at = Leaderboard.computed_at(cmp[:exam].code)) %>Updated <%= time_ago_in_words(at) %> ago.<% end %>
        <%= link_to "Change the exam you're preparing for", profile_path, class: "text-brand-700 dark:text-brand-300" %>
      </p>
    </details>
  </div>
</section>
