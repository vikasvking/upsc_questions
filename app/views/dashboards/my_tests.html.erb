<%# Every test and topic practice the student has started (DashboardsController#my_tests) %>
<%
  pill = "rounded-full px-3 py-1.5 text-xs font-bold"
  link = "text-xs font-bold text-brand-800 dark:text-brand-400 hover:underline whitespace-nowrap"
%>
<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl">My Tests</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Every test and practice you have started, newest first. Open any of them to see your marks and answers again.</p>
      </div>
      <div class="flex flex-wrap gap-2" role="navigation" aria-label="Show">
        <% DashboardsController::MY_TESTS_KINDS.each do |key, label| %>
          <%= link_to label, my_tests_dashboard_path(kind: key),
                      class: "#{pill} #{key == @kind ? "bg-brand-800 text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800"}",
                      aria: { current: (key == @kind ? "page" : nil) } %>
        <% end %>
      </div>
    </div>

    <% if @rows.empty? %>
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-10 text-center space-y-3">
        <p class="text-sm text-slate-600 dark:text-slate-400">
          <%= { "tests" => "You haven't started a teacher test yet.", "practice" => "You haven't practised a topic yet." }.fetch(@kind, "You haven't started a test or a practice yet.") %>
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <%= link_to "Browse all tests", all_tests_dashboard_path, class: "rounded-lg bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold px-4 py-2.5" %>
          <%= link_to "Practise a topic", question_bank_path, class: "rounded-lg border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold px-4 py-2.5" %>
        </div>
      </div>
    <% else %>
      <ul class="divide-y divide-slate-200 dark:divide-slate-800 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">
        <% @rows.each do |row| %>
          <li class="px-4 sm:px-5 py-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
            <%# what it was %>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">
                <%= row.test_session ? row.title : "#{row.title} (topic practice)" %>
              </p>
              <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400 flex flex-wrap gap-x-3 gap-y-0.5">
                <% if row.test_session %><span><%= exam_name(row.test_session.exam_type) %></span><% end %>
                <% if row.retake_number %><span class="font-semibold text-slate-600 dark:text-slate-300">Retake <%= row.retake_number %>, practice</span><% end %>
                <% if row.attempt.ended_early? %><span class="font-semibold text-red-700 dark:text-red-400" title="<%= row.attempt.ended_reason %>">Ended early: you left the test</span><% end %>
                <span><%= row.finished_at ? "Submitted" : "Started" %> <%= l(row.shown_at, format: :short) %></span>
              </p>
            </div>

            <%# how it went %>
            <div class="sm:w-72 text-xs text-slate-600 dark:text-slate-400">
              <% case row.status
                 when :in_progress %>
                <% answered, total = row.progress %>
                <span class="font-semibold text-amber-700 dark:text-amber-400">In progress</span>, <%= answered %> of <%= pluralize(total, "question") %> answered
              <% when :blocked %>
                <span class="font-semibold text-red-700 dark:text-red-400">Blocked</span>, ask your teacher to let you continue
              <% when :waiting %>
                <span class="font-semibold text-slate-800 dark:text-slate-200">Submitted</span>,
                results <%= row.release_at ? "at #{l(row.release_at, format: :short)}" : "after the test closes" %>
              <% when :done %>
                <% s = row.summary %>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                  <% if row.test_session %>
                    <span class="text-sm font-semibold text-slate-900 dark:text-white font-mono"><%= marks_text(s[:marks]) %> / <%= marks_text(s[:max_marks]) %></span>
                  <% else %>
                    <span class="text-sm font-semibold text-slate-900 dark:text-white"><%= s[:correct] %> of <%= s[:total] %> correct</span>
                  <% end %>
                  <span><%= s[:percentage] %>%</span>
                  <% if (rank = row.rank) %>
                    <span class="font-semibold text-amber-700 dark:text-amber-400">Rank <%= rank.first %> of <%= rank.last %></span>
                  <% end %>
                  <% unless s[:passed].nil? %>
                    <span class="<%= s[:passed] ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400" %>"><%= s[:passed] ? "Passed" : "Not passed" %></span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%# what to do next %>
            <div class="sm:w-28 sm:text-right">
              <% case row.status
                 when :in_progress %>
                <%= link_to "Resume", arena_dashboard_path(row.token), class: link %>
              <% when :blocked %>
                <%= link_to "Test page", test_intro_dashboard_path(row.test_session), class: link %>
              <% when :waiting %>
                <%= link_to "Details", test_results_dashboard_path(token: row.token), class: link %>
              <% when :done %>
                <%= link_to "View answers", test_results_dashboard_path(token: row.token), class: link %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <%= render "shared/list_pager", total: @total, noun: "attempt" %>
    <% end %>
  </div>
</div>
