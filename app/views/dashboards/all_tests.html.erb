<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl">All Tests</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Every test from your teachers. Live tests are listed first.</p>
      </div>
      <%= link_to "🎟️ Have a PIN?", join_test_sessions_path, class: "shrink-0 text-xs font-bold text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3 py-2 rounded-lg" %>
    </div>

    <!-- Filters: changing a dropdown reloads the list -->
    <%= form_with url: all_tests_dashboard_path, method: :get, id: "test-filters", class: "flex flex-col sm:flex-row flex-wrap gap-3 sm:items-end bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800" do %>
      <div class="flex-1">
        <%= label_tag :exam, "Exam", class: "text-xs font-bold text-slate-400" %>
        <%= select_tag :exam, options_for_select((Current.user.exam_codes.any? ? [["My exams", "mine"]] : []) + [["All exams", "all"]] + @exam_options, @exam || @exam_choice),
              class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white" %>
      </div>
      <% if @institution_options.any? %>
        <div class="flex-1">
          <%= label_tag :institution, "School / coaching", class: "text-xs font-bold text-slate-400" %>
          <%= select_tag :institution, options_for_select(@institution_options.map { |i| [i.name, i.id] }, @institution&.id), include_blank: "Any",
                class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white" %>
        </div>
      <% end %>
      <div class="flex-1">
        <%= label_tag :teacher, "Teacher", class: "text-xs font-bold text-slate-400" %>
        <%= select_tag :teacher, options_for_select(@teacher_options.map { |t| [t.display_name, t.id] }, @teacher_id), include_blank: "Any teacher",
              class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white" %>
      </div>
      <div class="flex-1">
        <%= label_tag :subject, "Subject", class: "text-xs font-bold text-slate-400" %>
        <%= select_tag :subject, options_for_select(@subject_options, @subject), include_blank: "All subjects",
              class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white" %>
      </div>
      <label class="flex items-center gap-2 sm:pb-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 cursor-pointer">
        <%= check_box_tag :attempted, "1", @show_attempted, class: "h-4 w-4 accent-brand-700" %>
        Show tests I've attempted
      </label>
      <div class="flex gap-2">
        <%= submit_tag "Filter", name: nil, class: "rounded-xl bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold px-4 py-2.5 cursor-pointer" %>
        <% if @exam || @subject || @institution || @teacher_id || params[:exam] == "all" || @show_attempted %>
          <%= link_to "Clear", all_tests_dashboard_path, class: "rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 text-xs font-bold px-4 py-2.5 bg-white dark:bg-slate-950" %>
        <% end %>
      </div>
    <% end %>

    <p class="text-xs text-slate-500 dark:text-slate-400">
      <%= pluralize(@tests.size, "test") %>
      <%= "in #{@exam}" if @exam %><%= " with #{@subject} questions" if @subject %>
      <% if @hidden_attempted.positive? %>
        · <%= @hidden_attempted == 1 ? "1 test you've attempted is hidden." : "#{@hidden_attempted} tests you've attempted are hidden." %>
        <%= link_to "Show them", all_tests_dashboard_path(request.query_parameters.merge("attempted" => "1")),
                    class: "font-bold text-brand-800 dark:text-brand-400 hover:underline" %>
      <% end %>
    </p>

    <% if @tests.any? %>
      <%# grouped like the list is sorted: open now, opening soon, closed. Columns follow the space available: 1 to 4 %>
      <% @tests.group_by(&:window_status).each do |status, tests| %>
        <section class="space-y-3 pt-2">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            <%= { live: "Open now", upcoming: "Opening soon", closed: "Closed" }.fetch(status) %>
          </h2>
          <div class="@container">
            <div class="grid gap-3 @xl:grid-cols-2 @4xl:grid-cols-3 @6xl:grid-cols-4">
              <% tests.each do |test| %>
                <%= render "dashboards/test_card", test: test, mine: @my_attempts_by_test[test.id], questions: @question_counts[test.id].to_i %>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    <% else %>
      <div class="text-center py-12 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
        <% if @hidden_attempted.positive? %>
          <p class="text-sm font-bold text-slate-700 dark:text-slate-300">You've attempted every test here</p>
          <%= link_to "Show attempted tests", all_tests_dashboard_path(request.query_parameters.merge("attempted" => "1")),
                      class: "text-xs font-bold text-brand-800 dark:text-brand-400 mt-1 inline-block" %>
        <% else %>
          <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No tests match these filters</p>
          <%= link_to "Show all tests", all_tests_dashboard_path, class: "text-xs font-bold text-brand-800 dark:text-brand-400 mt-1 inline-block" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function () {
    const form = document.getElementById("test-filters");
    if (!form) return;
    form.querySelectorAll("select, input[type=checkbox]").forEach((s) => s.addEventListener("change", () => form.requestSubmit()));
  })();
</script>
