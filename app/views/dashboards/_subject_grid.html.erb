<!-- Custom Hidden Scrollbar Track (Perfect for clean web view and native touch swapping) -->
<div class="flex overflow-x-auto gap-6 pb-6 pt-2 scroll-smooth snap-x snap-mandatory [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">

  <% @subjects.each do |subject_name| %>
    <%# Pull dynamic metadata configurations or assign clear fallbacks if topic doesn't match predefined values %>
    <% meta = @progress_map[subject_name] || { mastered: 0, icon: "📚", count: Question.where(topic: subject_name).count } %>

    <!-- Subject Card Container (Locked to a fixed layout width for clean swipe metrics) -->
    <div class="w-80 flex-shrink-0 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl flex flex-col justify-between group hover:border-rose-800 dark:hover:border-rose-500 shadow-sm transition-all hover:-translate-y-0.5 snap-start">
      <div>
        <div class="flex justify-between items-start">
          <div class="text-3xl bg-white dark:bg-slate-950 p-3 rounded-xl border border-slate-100 dark:border-slate-850 shadow-sm"><%= meta[:icon] %></div>
          <span class="text-[10px] font-bold text-rose-800 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 px-2.5 py-1 rounded-full uppercase tracking-wider">
            <%= meta[:count] %> Questions
          </span>
        </div>

        <h3 class="font-extrabold text-slate-900 dark:text-white text-lg mt-4 truncate" title="<%= subject_name %>">
          <%= subject_name %>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">
          Comprehensive historical question assets and PYQs mapped strictly to dynamic syllabus targets.
        </p>
      </div>

      <!-- Progress Indicator & Action Trigger Links -->
      <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-slate-800/80">
        <div class="flex justify-between text-xs font-bold text-slate-600 dark:text-slate-400 mb-1.5">
          <span>Module Mastery</span>
          <span class="text-rose-800 dark:text-rose-400 font-bold"><%= meta[:mastered] %>%</span>
        </div>

        <!-- Standard Burgundy Progress Bar Component Indicator -->
        <div class="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
          <div class="bg-rose-800 dark:bg-rose-500 h-full rounded-full transition-all duration-500" style="width: <%= meta[:mastered] %>%"></div>
        </div>

        <!-- 🚀 QUOTES REMOVED BELOW: It is now evaluated as a core Ruby command -->
        <%= link_to "Practice Questions →", dashboard_path(topic: subject_name), class: "mt-4 text-xs font-black text-rose-800 dark:text-rose-400 block group-hover:text-rose-900 cursor-pointer" %>
      </div>
    </div>
  <% end %>

</div>
