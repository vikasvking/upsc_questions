<%# locals: test, mine (the student's attempt or nil), subjects (array of topic names) %>
<% label, label_class = window_badge_for(test) %>
<% style = style_for_test(test) %>
<div class="bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 shadow-[0_1px_2px_rgba(15,23,42,0.04)] p-5 flex flex-col justify-between gap-4 <%= style[:stripe] %>">
  <div class="min-w-0">
    <div class="flex flex-wrap gap-1.5">
      <%= kind_badge_for(test) %>
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= label_class %>"><%= label %></span>
      <%= audience_chip(test) %>
    </div>
    <h3 class="mt-2 font-semibold text-slate-900 dark:text-white truncate" title="<%= test.title %>"><%= test.title %></h3>
    <div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
      <%= exam_chip(test.exam_type) %>
      <span class="truncate"><%= [subjects.presence&.join(", "), "#{test.duration_minutes} min"].compact.join(" · ") %></span>
    </div>
    <p class="text-xs text-slate-400 mt-1">by <%= test.author_name %></p>
  </div>

  <% primary = "self-start rounded-lg px-3.5 py-2 text-sm font-medium #{style[:button]}" %>
  <% secondary = "self-start rounded-lg px-3.5 py-2 text-sm font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200" %>
  <% if mine&.blocked? %>
    <span class="text-sm font-medium text-red-700 dark:text-red-400">🚫 Blocked — ask your teacher</span>
  <% elsif mine&.finished? || (mine && mine.expired?) %>
    <% rank, of = @ranks_by_test && @ranks_by_test[test.id] %>
    <div class="flex items-center gap-3">
      <%= link_to (test.results_released? ? "See result" : "Submitted"), test_results_dashboard_path(token: mine.token), class: secondary %>
      <% if rank %><span class="text-sm text-slate-500">Rank <span class="font-semibold text-slate-900 dark:text-white">#<%= rank %></span> of <%= of %></span><% end %>
    </div>
  <% elsif mine %>
    <%= link_to "Resume test", test_intro_dashboard_path(test), class: primary %>
  <% elsif test.window_status == :closed %>
    <span class="text-sm text-slate-400">Missed</span>
  <% elsif test.open_access? %>
    <%= link_to (test.window_status == :live ? "Start test" : "View details"), test_intro_dashboard_path(test), class: (test.window_status == :live ? primary : secondary) %>
  <% else %>
    <%= link_to "#{style[:icon]} Enter PIN", join_test_sessions_path, class: (test.window_status == :live ? primary : secondary) %>
  <% end %>
</div>
