<%# A compact test card: the whole card opens the test (or its result once submitted).
    locals: test, mine (the student's latest attempt or nil), questions (how many questions the test has) %>
<%
  locked = !mine && @locked_test_ids&.include?(test.id) # listed, but outside the student's tier
  rank, of = @ranks_by_test && @ranks_by_test[test.id]
  done = mine && !mine.blocked? && (mine.finished? || mine.expired?)
  href = done ? test_results_dashboard_path(token: mine.token) : test_intro_dashboard_path(test)
  short = "%-d %b, %H:%M" # 5 Oct, 10:00

  # Where the student stands with this test, coloured, on every card (so the lines of a row stay level)
  state, tone =
    if mine&.blocked? then ["Blocked, ask your teacher", "text-red-700 dark:text-red-400"]
    elsif done && rank then ["Rank #{rank} of #{of}", "text-emerald-700 dark:text-emerald-400"]
    elsif done && mine.results_released? then ["Result ready", "text-emerald-700 dark:text-emerald-400"]
    elsif done then ["Submitted", "text-slate-700 dark:text-slate-300"]
    elsif mine then ["In progress", "text-amber-700 dark:text-amber-400"]
    elsif locked then ["🔒 Upgrade to unlock", "text-amber-700 dark:text-amber-400"]
    else
      case test.window_status
      when :upcoming then ["Opens #{l(test.starts_at, format: short)}", "text-amber-700 dark:text-amber-400"]
      when :closed   then ["Closed", "text-slate-500 dark:text-slate-400"]
      else test.ends_at ? ["Closes #{l(test.ends_at, format: short)}", "text-emerald-700 dark:text-emerald-400"] : ["Start test", "text-brand-700 dark:text-brand-300"]
      end
    end
  pill = "ml-1.5 inline-block rounded-md px-1.5 py-px align-[2px] text-xs font-medium"
%>
<%= link_to href, class: "group flex flex-col justify-between gap-2.5 rounded-xl bg-white dark:bg-slate-900 px-4 py-3.5 ring-1 ring-slate-200/80 dark:ring-slate-800 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-shadow hover:ring-2 hover:ring-brand-600 dark:hover:ring-brand-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600" do %>
  <div class="flex items-start gap-2">
    <%# title and its labels flow together, two lines at most %>
    <div class="min-w-0 flex-1 line-clamp-2 leading-snug">
      <h3 class="inline text-base font-semibold text-slate-900 dark:text-white"><%= test.title %></h3>
      <% if test.strict_mode? %>
        <span class="<%= pill %> bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300">Strict</span>
      <% elsif test.pin_required? %>
        <span class="<%= pill %> bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">PIN</span>
      <% end %>
      <% if test.free_sample? %>
        <span class="<%= pill %> bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">Free</span>
      <% end %>
    </div>
    <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-400 group-hover:text-brand-700 dark:group-hover:text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  </div>
  <div class="space-y-1 text-[13px]">
    <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-slate-600 dark:text-slate-400">
      <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-1.5 py-px text-slate-600 dark:text-slate-300"><%= exam_name(test.exam_type) %></span>
      <span><strong class="font-semibold text-slate-900 dark:text-white"><%= questions %></strong> <%= questions == 1 ? "question" : "questions" %></span>
      <span><strong class="font-semibold text-slate-900 dark:text-white"><%= test.duration_minutes %></strong> min</span>
    </p>
    <p class="font-semibold <%= tone %>"><%= state %></p>
  </div>
<% end %>
