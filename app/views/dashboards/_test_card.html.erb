<%# locals: test, mine (the student's attempt or nil), subjects (array of topic names) %>
<% label, label_class = test_window_badge(test) %>
<div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-200/60 dark:border-slate-800 flex items-center justify-between gap-3 shadow-sm">
  <div class="min-w-0 space-y-1">
    <div class="flex flex-wrap gap-1">
      <span class="inline-block text-[9px] font-black px-1.5 py-0.5 rounded tracking-wide uppercase <%= label_class %>"><%= label %></span>
      <span class="inline-block text-[9px] font-black px-1.5 py-0.5 rounded tracking-wide uppercase <%= test.open_access? ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-400" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300" %>"><%= test.open_access? ? "Open" : "🔐 PIN" %></span>
      <span class="inline-block text-[9px] font-black px-1.5 py-0.5 rounded tracking-wide uppercase bg-rose-50 text-rose-800 dark:bg-rose-950/40 dark:text-rose-400"><%= test.exam_type %></span>
    </div>
    <h5 class="text-sm font-bold text-slate-900 dark:text-white truncate"><%= test.title %></h5>
    <p class="text-[11px] text-slate-400 truncate">
      <%= subjects.presence&.join(", ") || "No questions yet" %> · <%= test.duration_minutes %> min · by <%= test.user.email_address.split("@").first.capitalize %>
    </p>
  </div>

  <% if mine&.finished? || (mine && mine.expired?) %>
    <%= link_to "Result", test_results_dashboard_path(token: mine.token), class: "shrink-0 text-xs font-black text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg" %>
  <% elsif mine %>
    <%= link_to "Resume →", test_intro_dashboard_path(test), class: "shrink-0 text-xs font-black text-rose-800 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 px-3 py-1.5 rounded-lg border border-rose-100 dark:border-rose-900/40" %>
  <% elsif test.window_status == :closed %>
    <span class="shrink-0 text-xs font-bold text-slate-400">Missed</span>
  <% elsif test.open_access? %>
    <%= link_to "View →", test_intro_dashboard_path(test), class: "shrink-0 text-xs font-black text-rose-800 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 px-3 py-1.5 rounded-lg border border-rose-100 dark:border-rose-900/40" %>
  <% else %>
    <%= link_to "🔑 Enter PIN", join_test_sessions_path, class: "shrink-0 text-xs font-bold text-slate-500 hover:text-rose-800 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3 py-1.5 rounded-lg" %>
  <% end %>
</div>
