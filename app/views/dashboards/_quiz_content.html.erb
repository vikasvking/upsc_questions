<%= form_with url: submit_answer_dashboard_path, method: :post, class: "bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/60 dark:border-slate-800/80 shadow-sm p-6 sm:p-8 flex flex-col justify-between min-h-[480px]" do |form| %>
  <%= hidden_field_tag :token, @attempt.token %>
  <%= hidden_field_tag :n, @position %>
  <%= hidden_field_tag :question_id, @question.id %>
  <%= hidden_field_tag :duration_seconds, 0, id: "time-elapsed-tracker" %>

  <div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4">
      <%= link_to_if @position > 1, "← Previous", arena_dashboard_path(@attempt.token, n: @position - 1), class: "text-xs font-bold text-slate-500 hover:text-brand-800" %>
      <span class="text-sm font-semibold text-brand-800 dark:text-brand-400">
        Question <%= @position %> of <%= @questions.size %>
      </span>
      <%= link_to_if @position < @questions.size, "Next →", arena_dashboard_path(@attempt.token, n: @position + 1), class: "text-xs font-bold text-slate-500 hover:text-brand-800" %>
    </div>

    <div class="text-slate-900 dark:text-white text-base leading-relaxed font-semibold">
      <%= @question.content %>
    </div>

    <div class="grid grid-cols-1 gap-3 pt-2">
      <% [["A", @question.option_a], ["B", @question.option_b], ["C", @question.option_c], ["D", @question.option_d]].each do |letter, option_text| %>
        <% next if option_text.blank? %>
        <label class="flex items-start gap-x-3.5 p-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800/60 cursor-pointer hover:border-brand-800/40 transition-colors group">
          <%= radio_button_tag :answer_choice, letter, @previous_attempt&.chosen_option == letter, class: "mt-1 accent-brand-800 dark:accent-brand-500 h-4 w-4" %>
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white">
            <strong class="text-brand-800 dark:text-brand-400"><%= letter %>.</strong> <%= option_text %>
          </span>
        </label>
      <% end %>
    </div>

    <% if @previous_attempt %>
      <p class="text-xs text-slate-400">
        <%= @previous_attempt.chosen_option == "SKIPPED" ? "You skipped this question earlier." : "Saved answer: #{@previous_attempt.chosen_option}. Pick another option and submit to change it." %>
      </p>
    <% end %>
  </div>

  <div class="mt-8 flex items-center justify-between border-t border-slate-200 dark:border-slate-800 pt-4 gap-4">
    <%= link_to "Skip Question ↷",
                skip_question_dashboard_path(token: @attempt.token, question_id: @question.id, n: @position),
                data: { turbo_method: :post },
                class: "text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-brand-800 dark:hover:text-brand-400 border border-slate-200 dark:border-slate-800 rounded-lg px-4 py-2.5 transition-colors bg-white dark:bg-slate-950" %>

    <%= form.submit "Save Answer & Next", class: "rounded-lg bg-brand-800 dark:bg-brand-700 hover:bg-brand-900 dark:hover:bg-brand-600 text-white font-bold text-sm px-6 py-2.5 shadow-sm transition-all cursor-pointer" %>
  </div>
<% end %>
