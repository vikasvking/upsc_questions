<div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm mb-8 transition-colors duration-200">
  <div class="mb-4">
    <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500">Lifetime Profile Analytics</h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Your global execution footprint calculated across all exam parameters.</p>
  </div>

  <!-- 4-Column Grid Structure (Translates cleanly into a Flutter GridView widget later) -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-2">

    <!-- 1. Overall Completion Progress Indicator Card -->
    <div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-100 dark:border-slate-850 flex flex-col justify-between">
      <div>
        <p class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Overall Completion</p>
        <p class="text-2xl font-black text-slate-900 dark:text-white mt-1"><%= @overall_completion_pct %>%</p>
      </div>
      <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden mt-3">
        <div class="bg-rose-800 dark:bg-rose-500 h-full rounded-full" style="width: <%= @overall_completion_pct %>%"></div>
      </div>
    </div>

    <!-- 2. Correct Answers Tracker Card -->
    <div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-100 dark:border-slate-850">
      <p class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Correct Answers</p>
      <p class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1"><%= @lifetime_correct_count %></p>
      <p class="text-[9px] text-slate-400 mt-1">High-yield items mastered</p>
    </div>

    <!-- 3. Incorrect Answers Tracker Card -->
    <div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-100 dark:border-slate-850">
      <p class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Wrong Answers</p>
      <p class="text-2xl font-black text-rose-800 dark:text-rose-400 mt-1"><%= @lifetime_wrong_count %></p>
      <p class="text-[9px] text-slate-400 mt-1">Flagged for remedial drilling</p>
    </div>

    <!-- 4. Global Accuracy Percentage Card -->
    <div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-100 dark:border-slate-850 flex flex-col justify-between">
      <div>
        <p class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Global Accuracy</p>
        <p class="text-2xl font-black text-slate-900 dark:text-white mt-1"><%= @global_accuracy_pct %>%</p>
      </div>
      <span class="text-[9px] font-bold px-2 py-0.5 rounded-md inline-block w-fit mt-2 <%= @global_accuracy_pct >= 70 ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600' : 'bg-amber-50 dark:bg-amber-950/40 text-amber-600' %>">
        <%= @global_accuracy_pct >= 70 ? 'Target Rank Pace' : 'Below Cut-off Threshold' %>
      </span>
    </div>

  </div>
</div>
