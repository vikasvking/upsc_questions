<div class="space-y-6">
  <!-- Test Info Card -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-rose-800 dark:text-rose-400">Active Module</p>
    <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">UPSC Prelims Mock Set</h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Syllabus Section: Indian Polity</p>
  </div>

  <!-- Countdown Timer Card -->
  <!-- Live Tracking stopwatch Card -->
<div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm relative overflow-hidden">
  <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 tracking-widest">Time Elapsed</p>
  <p id="live-stopwatch-display" class="text-2xl font-black text-rose-800 dark:text-rose-400 mt-1 font-mono tracking-tight">00:00:00</p>

  <!-- 🚀 FINISH TEST BUTTON WITH CONFIRMATION BLOCK -->
  <%= button_to "Finish Session 📥", finish_test_dashboard_path, method: :post,
                data: { turbo_confirm: "Are you sure you want to finish the test? Your responses will be finalized." },
                class: "w-full mt-4 text-center font-bold text-xs bg-white dark:bg-slate-950 text-rose-800 dark:text-rose-400 border border-rose-800/30 dark:border-slate-800/80 hover:bg-rose-50 dark:hover:bg-rose-950/20 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer" %>
</div>

<script>
(function() {
  function initializeStopwatch() {
    const display = document.getElementById('live-stopwatch-display');
    const hiddenTracker = document.getElementById('time-elapsed-tracker');
    if (!display) return;

    // Sync to backend initialization epochs timestamp parameters
    const startTime = <%= session[:test_start_time] || Time.current.to_i %>;

    setInterval(() => {
      const now = Math.floor(Date.now() / 1000);
      const elapsed = now - startTime;

      const hrs = String(Math.floor(elapsed / 3600)).padStart(2, '0');
      const mins = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
      const secs = String(elapsed % 60).padStart(2, '0');

      display.innerText = `${hrs}:${mins}:${secs}`;
      if (hiddenTracker) hiddenTracker.value = elapsed;
    }, 1000);
  }

  document.addEventListener("turbo:load", initializeStopwatch);
})();
</script>


  <!-- Question Navigation Grid Matrix -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-4 tracking-widest">Question Grid</p>

    <!-- Replace the Question Grid loop on line 17 with this -->
<div class="grid grid-cols-6 gap-2">
  <% @questions.each do |q| %>
    <% if q.q_no == @question.q_no %>
      <%= link_to q.q_no, dashboard_path(topic: @topic, q_no: q.q_no), class: "h-9 w-full flex items-center justify-center rounded-lg text-xs font-bold bg-rose-800 text-white shadow-sm ring-2 ring-offset-2 ring-rose-800 dark:ring-offset-slate-950" %>
    <% else %>
      <%= link_to q.q_no, dashboard_path(topic: @topic, q_no: q.q_no), class: "h-9 w-full flex items-center justify-center rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/40" %>
    <% end %>
  <% end %>
</div>

  </div>

  <!-- Next Scheduled Challenge Section -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 tracking-widest">Next Queue</p>
    <p class="text-xs font-bold text-slate-800 dark:text-white mt-1">Macro Economics Assessment</p>
  </div>
</div>
