<div class="space-y-6">
  <!-- Test Info Card -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-rose-800 dark:text-rose-400">Active Module</p>
    <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">UPSC Prelims Mock Set</h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Syllabus Section: Indian Polity</p>
  </div>

  <!-- Countdown Timer Card -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 tracking-widest">Time Remaining</p>
    <p class="text-2xl font-black text-rose-800 dark:text-rose-400 mt-1 font-mono tracking-tight">00 : 15 : 30</p>
  </div>

  <!-- Question Navigation Grid Matrix -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-4 tracking-widest">Question Grid</p>

    <div class="grid grid-cols-6 gap-2">
      <!-- Question Numbers 1 to 30 Loop -->
      <% (1..30).each do |num| %>
        <% if num == 30 %>
          <!-- Active Question Style: Burgundy fill -->
          <button class="h-9 w-full flex items-center justify-center rounded-lg text-xs font-bold bg-rose-800 text-white shadow-sm ring-2 ring-offset-2 ring-rose-800 dark:ring-offset-slate-900 cursor-pointer"><%= num %></button>
        <% elsif num <= 14 %>
          <!-- Completed Question Style: Muted slate fill -->
          <button class="h-9 w-full flex items-center justify-center rounded-lg text-xs font-bold bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-700 cursor-pointer"><%= num %></button>
        <% else %>
          <!-- Unanswered/Remaining Style: Clear border outline -->
          <button class="h-9 w-full flex items-center justify-center rounded-lg text-xs font-semibold border border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/40 cursor-pointer"><%= num %></button>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Next Scheduled Challenge Section -->
  <div class="bg-slate-50 dark:bg-slate-900 rounded-2xl p-5 border border-slate-200/60 dark:border-slate-800 shadow-sm">
    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 tracking-widest">Next Queue</p>
    <p class="text-xs font-bold text-slate-800 dark:text-white mt-1">Macro Economics Assessment</p>
  </div>
</div>
