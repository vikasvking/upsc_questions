<div class="space-y-6 pt-2">
  <div>
    <h3 class="text-sm font-black uppercase tracking-widest text-slate-400 dark:text-slate-500">Available Test Series & Blueprints</h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Select a master curriculum module stream or enter an instructor passcode PIN below to begin.</p>
  </div>

  <!-- 2-Section Grid (Translates cleanly into layout widgets for your upcoming Flutter app later) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

    <!-- Section Left: Master Core Syllabus Series Track -->
    <div class="space-y-3 bg-slate-50/50 dark:bg-slate-900/30 p-5 rounded-2xl border border-slate-200/60 dark:border-slate-800">
      <h4 class="text-xs font-black uppercase tracking-wider text-rose-800 dark:text-rose-400 flex items-center gap-x-2">
        <span>📚</span> General Curriculum Test Tracks
      </h4>

      <div class="space-y-2">
        <% if @available_subjects.any? %>
          <% @available_subjects.each do |subject| %>
            <% total_q = Question.where(topic: subject).count %>
            <% exam_type = Question.where(topic: subject).first&.exam_type || "GEN" %>

            <div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-200/60 dark:border-slate-850 flex items-center justify-between shadow-sm group hover:border-rose-800/40 transition-colors">
              <div>
                <span class="inline-block text-[8px] font-black bg-slate-100 dark:bg-slate-800 text-slate-500 px-1.5 py-0.5 rounded tracking-wide mb-1 uppercase"><%= exam_type %> Core</span>
                <h5 class="text-sm font-bold text-slate-900 dark:text-white"><%= subject %></h5>
                <p class="text-[10px] text-slate-400 mt-0.5"><%= total_q %> Adaptive mock metrics loaded</p>
              </div>
              <%= link_to "Open Module →", dashboard_path(topic: subject), class: "text-xs font-black text-rose-800 dark:text-rose-400 hover:text-rose-900 bg-rose-50 dark:bg-rose-950/40 px-3 py-1.5 rounded-lg border border-rose-200/40 shadow-sm transition-all" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-400 italic py-4 pl-2">No subjects loaded in database pool tracks yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Section Right: Live Teacher-Assigned Custom Passcode Papers -->
    <div class="space-y-3 bg-slate-50/50 dark:bg-slate-900/30 p-5 rounded-2xl border border-slate-200/60 dark:border-slate-800">
      <h4 class="text-xs font-black uppercase tracking-wider text-rose-800 dark:text-rose-400 flex items-center gap-x-2">
        <span>🔐</span> Live Classroom Passcode Challenges
      </h4>

      <div class="space-y-2">
        <% if @custom_teacher_tests.any? %>
          <% @custom_teacher_tests.each do |test| %>
            <div class="bg-white dark:bg-slate-950 p-4 rounded-xl border border-slate-200/60 dark:border-slate-850 flex items-center justify-between shadow-sm">
              <div>
                <span class="inline-block text-[8px] font-black bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-400 px-1.5 py-0.5 rounded tracking-wide mb-1 uppercase"><%= test.exam_type %> Live</span>
                <h5 class="text-sm font-bold text-slate-900 dark:text-white truncate max-w-[180px]"><%= test.title %></h5>
                <p class="text-[10px] text-slate-400 mt-0.5">Faculty Creator: <%= test.user.email_address.split('@').first.capitalize %></p>
              </div>

              <!-- Clean Unlock PIN action flow -->
              <%= link_to join_test_sessions_path, class: "text-xs font-bold text-slate-500 hover:text-rose-800 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3 py-1.5 rounded-lg shadow-sm flex items-center gap-x-1.5" do %>
                <span>🔑</span> Unlock Paper
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-8 bg-white dark:bg-slate-950 rounded-xl border border-slate-200/60 dark:border-slate-850">
            <span class="text-lg block">📥</span>
            <p class="text-[11px] text-slate-400 font-medium mt-1">No custom classroom papers deployed yet.</p>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
