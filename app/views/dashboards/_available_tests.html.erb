<section class="space-y-4">
  <div class="flex items-baseline justify-between">
    <h2 class="font-semibold text-slate-900 dark:text-white">Latest tests</h2>
    <%= link_to "View all →", all_tests_dashboard_path, class: "text-sm font-medium text-brand-700 dark:text-brand-300 hover:underline" %>
  </div>

  <% if @latest_tests.any? %>
    <div class="@container">
      <div class="grid gap-3 @xl:grid-cols-2 @4xl:grid-cols-3">
        <% @latest_tests.each do |test| %>
          <%= render "dashboards/test_card", test: test, mine: @my_attempts_by_test[test.id], questions: @question_counts[test.id].to_i %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-slate-200/70 dark:ring-slate-800 px-6 py-10 text-center">
      <p class="text-slate-600 dark:text-slate-300">No live or upcoming tests right now.</p>
      <p class="mt-1 text-sm text-slate-500">
        <%= link_to "See past tests", all_tests_dashboard_path, class: "font-medium text-brand-700 dark:text-brand-300" %> or
        <%= link_to "practise by subject", question_bank_path, class: "font-medium text-brand-700 dark:text-brand-300" %>.
      </p>
    </div>
  <% end %>
</section>
