<% test = @test_session %>
<div class="py-16 min-h-screen flex items-center justify-center transition-colors duration-200 w-full">
  <div class="mx-auto max-w-xl px-6 text-center space-y-6">
    <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-50 dark:bg-brand-950/40 border border-brand-200 dark:border-brand-900/40 text-3xl shadow-sm"><%= test ? style_for_test(test)[:icon] : "⏱️" %></div>
    <% if test %>
      <div class="flex flex-wrap justify-center gap-1.5"><%= kind_badge_for(test) %> <%= exam_chip(test.exam_type) %></div>
    <% end %>

    <% if alert %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-3 border border-red-200 dark:border-red-900/40 text-xs text-red-800 dark:text-red-300 font-bold"><%= alert %></div>
    <% end %>
    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-3 border border-emerald-200 dark:border-emerald-900/40 text-xs text-emerald-800 dark:text-emerald-300 font-bold"><%= notice %></div>
    <% end %>

    <div class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= test ? test.title : "#{@topic} Practice" %></h1>
      <p class="text-sm text-slate-500 dark:text-slate-400"><%= @locked ? "🔒 Upgrade your membership to take this test." : "Read the rules before you start." %></p>
    </div>

    <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 text-left space-y-3.5 text-xs text-slate-600 dark:text-slate-400 leading-relaxed shadow-sm">
      <p class="font-bold text-xs text-brand-800 dark:text-brand-400">Rules</p>
      <div class="flex gap-x-2"><span>•</span> <span><strong><%= @total_q_count %> questions</strong>.</span></div>

      <% if test %>
        <div class="flex gap-x-2"><span>•</span> <span>Time limit: <strong><%= test.duration_minutes %> minutes</strong> from when you press Start. The test submits itself when time runs out.</span></div>
        <% if test.starts_at %>
          <div class="flex gap-x-2"><span>•</span> <span>Opens: <strong><%= l(test.starts_at, format: :long) %></strong></span></div>
        <% end %>
        <% if test.ends_at %>
          <div class="flex gap-x-2"><span>•</span> <span>Closes: <strong><%= l(test.ends_at, format: :long) %></strong>. If you start late, you only get the time left until then.</span></div>
        <% end %>
        <div class="flex gap-x-2"><span>•</span> <span>Pass mark: <strong><%= test.pass_mark_percentage %>%</strong>. You can take this test once.</span></div>
        <% if test.strict_mode? %>
          <div class="flex gap-x-2 text-red-700 dark:text-red-400"><span>•</span> <span><strong>🛡️ Strict test.</strong> Stay on the test page until you submit. Switching to another tab or app, opening another page, or closing the page counts as leaving. The first time is a warning; the second time you are <strong>blocked</strong> and only your teacher can let you continue.</span></div>
          <div class="flex gap-x-2"><span>•</span> <span>Marks, rank and answers are shown after the test closes<%= " at #{l(test.ends_at, format: :long)}" if test.ends_at %>.</span></div>
        <% end %>
      <% else %>
        <div class="flex gap-x-2"><span>•</span> <span>No time limit. A stopwatch shows how long you have been practising.</span></div>
      <% end %>
      <div class="flex gap-x-2"><span>•</span> <span>You can move between questions and change answers until you press Finish.</span></div>
    </div>

    <% if @locked %>
      <%# Test outside the student's tier: what unlocks it, instead of the Start button %>
      <div class="rounded-2xl bg-amber-50 dark:bg-amber-950/30 ring-1 ring-amber-200 dark:ring-amber-900/60 p-5 text-left space-y-3">
        <p class="text-sm font-semibold text-amber-900 dark:text-amber-200">
          <%= Current.user.free_tier? ? "🌱 You're on the free trial: only the #{Tiers::FREE_SAMPLE_TESTS} 🎁 sample tests are included." : "⭐ Your Plus plan covers #{Current.user.allowed_exam_codes.map { |c| exam_name(c) }.to_sentence.presence || "your school's exams"} — this test is for #{exam_name(test.exam_type)}." %>
        </p>
        <ul class="text-xs text-slate-700 dark:text-slate-300 space-y-1.5">
          <% if Current.user.free_tier? %>
            <li>⭐ <strong>Plus</strong> — free through your school's plan: school tests and public tests in your exams.</li>
          <% end %>
          <li>⚔️ <strong>Warrior</strong> — every exam, all public tests and practice.</li>
        </ul>
      </div>
    <% end %>

    <div class="flex gap-4 pt-2">
      <%= link_to "Cancel & Go Back", dashboard_path, class: "flex-1 text-center font-bold text-sm border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-950 px-4 py-3 rounded-xl hover:bg-slate-100 transition-colors shadow-sm" %>

      <% if test %>
        <% if @locked %>
          <%= link_to "See upgrade options", membership_path, class: "flex-1 text-center font-bold text-sm bg-amber-500 hover:bg-amber-600 text-white px-4 py-3 rounded-xl shadow-sm" %>
        <% elsif @existing_attempt&.blocked? %>
          <span class="flex-1 text-center font-bold text-sm bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900/40 px-4 py-3 rounded-xl">🚫 Blocked — ask your teacher</span>
        <% elsif @existing_attempt&.finished? %>
          <%= link_to (@existing_attempt.retake? ? "View Last Result" : "View My Result"), test_results_dashboard_path(token: @existing_attempt.token), class: "flex-1 text-center font-bold text-sm #{@can_retake ? "border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-950 hover:bg-slate-100" : "bg-brand-800 hover:bg-brand-900 text-white"} px-4 py-3 rounded-xl shadow-sm" %>
          <% if @can_retake %>
            <%= button_to "↻ Retake Test", start_test_dashboard_path(test_session_id: test.id, retake: 1), method: :post, form_class: "flex-1", class: "w-full text-center font-bold text-sm bg-brand-800 hover:bg-brand-900 text-white px-4 py-3 rounded-xl shadow-sm cursor-pointer" %>
          <% end %>
        <% elsif @existing_attempt %>
          <%= button_to "Resume Test", start_test_dashboard_path(test_session_id: test.id), method: :post, form_class: "flex-1", class: "w-full text-center font-bold text-sm bg-brand-800 hover:bg-brand-900 text-white px-4 py-3 rounded-xl shadow-sm cursor-pointer" %>
        <% elsif test.window_status == :upcoming %>
          <span class="flex-1 text-center font-bold text-sm bg-slate-100 dark:bg-slate-900 text-slate-400 px-4 py-3 rounded-xl">Not open yet</span>
        <% elsif test.window_status == :closed %>
          <span class="flex-1 text-center font-bold text-sm bg-slate-100 dark:bg-slate-900 text-slate-400 px-4 py-3 rounded-xl">Test closed</span>
        <% else %>
          <%= button_to "Start Test", start_test_dashboard_path(test_session_id: test.id), method: :post, form_class: "flex-1", class: "w-full text-center font-bold text-sm bg-brand-800 hover:bg-brand-900 text-white px-4 py-3 rounded-xl shadow-sm cursor-pointer" %>
        <% end %>
      <% else %>
        <%= button_to (@resume_attempt ? "Resume Practice" : "Start Practice"), start_test_dashboard_path(topic: @topic), method: :post, form_class: "flex-1", class: "w-full text-center font-bold text-sm bg-brand-800 hover:bg-brand-900 text-white px-4 py-3 rounded-xl shadow-sm cursor-pointer" %>
      <% end %>
    </div>

    <% if test && !@locked && @existing_attempt&.finished? && !@existing_attempt.blocked? %>
      <p class="text-xs text-slate-500 text-center">
        <% if @can_retake %>
          You can retake this test as many times as you like<%= " (taken #{pluralize(@attempt_count, "time")} so far)" if @attempt_count.to_i > 1 %>. Retakes are practice: your rank stays from your first attempt.
        <% elsif test.ends_at %>
          You can retake this test for practice after it closes at <%= l(test.ends_at, format: :long) %>.
        <% end %>
      </p>
    <% end %>
  </div>
</div>
