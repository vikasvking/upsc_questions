<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-6 gap-4">
      <div>
        <h1 class="text-3xl font-semibold text-slate-900 dark:text-white"><%= @topic %> Results</h1>
        <p class="text-sm text-slate-500 mt-1">
          Submitted <%= l(@attempt.finished_at, format: :long) %>
          <% if @attempt.test_session %>
            · Pass mark <%= @attempt.test_session.pass_mark_percentage %>%
          <% end %>
        </p>
      </div>
      <%= link_to "Back to Dashboard", dashboard_path, class: "shrink-0 text-xs font-bold bg-brand-800 text-white px-4 py-2.5 rounded-xl hover:bg-brand-900 shadow-sm" %>
    </div>

    <% if alert %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-3 border border-red-200 dark:border-red-900/40 text-xs text-red-800 dark:text-red-300 font-bold"><%= alert %></div>
    <% end %>
    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-3 border border-emerald-200 dark:border-emerald-900/40 text-xs text-emerald-800 dark:text-emerald-300 font-bold"><%= notice %></div>
    <% end %>

    <% if @my_result %>
      <div class="rounded-2xl bg-gradient-to-br from-amber-50 to-white dark:from-amber-950/30 dark:to-slate-950 border border-amber-200 dark:border-amber-900/50 p-5 flex flex-wrap items-center gap-6">
        <div>
          <p class="text-xs font-bold text-amber-700 dark:text-amber-400">Your rank</p>
          <p class="text-4xl font-semibold text-slate-900 dark:text-white"><%= @my_result.rank <= 3 ? %w[🥇 🥈 🥉][@my_result.rank - 1] : "" %> #<%= @my_result.rank %> <span class="text-base font-bold text-slate-500">of <%= @ranked_count %></span></p>
        </div>
        <div>
          <p class="text-xs font-bold text-slate-400">Marks</p>
          <p class="text-2xl font-semibold text-slate-900 dark:text-white"><%= marks_text(@my_result.marks) %> <span class="text-sm font-bold text-slate-500">/ <%= marks_text(@my_result.max_marks) %></span></p>
        </div>
        <div>
          <p class="text-xs font-bold text-slate-400">Time taken</p>
          <p class="text-2xl font-semibold text-slate-900 dark:text-white"><%= duration_text(@my_result.time_taken) %></p>
        </div>
        <p class="basis-full text-xs text-slate-500"><%= exam_name(@attempt.test_session.exam_type) %> marking: <%= @attempt.exam.marking_text %>. Equal marks → less time ranks higher. Your rank can change as more students submit.</p>
      </div>
    <% end %>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
      <div class="bg-emerald-50/40 dark:bg-emerald-950/10 p-5 rounded-2xl border border-emerald-100 dark:border-emerald-900/40">
        <p class="text-xs font-bold text-emerald-700 dark:text-emerald-400">Correct</p>
        <p class="text-3xl font-semibold text-emerald-600 mt-1"><%= @summary[:correct] %></p>
      </div>
      <div class="bg-red-50/40 dark:bg-red-950/10 p-5 rounded-2xl border border-red-100 dark:border-red-900/40">
        <p class="text-xs font-bold text-red-700 dark:text-red-400">Wrong</p>
        <p class="text-3xl font-semibold text-red-700 mt-1"><%= @summary[:wrong] %></p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800">
        <p class="text-xs font-bold text-slate-400">Skipped / Not attempted</p>
        <p class="text-3xl font-semibold text-slate-900 dark:text-white mt-1"><%= @summary[:skipped] + @summary[:unattempted] %></p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800">
        <p class="text-xs font-bold text-slate-400">Score</p>
        <p class="text-3xl font-semibold text-slate-900 dark:text-white mt-1"><%= @summary[:percentage] %>%</p>
        <% unless @summary[:passed].nil? %>
          <p class="text-xs font-semibold mt-1 <%= @summary[:passed] ? "text-emerald-600" : "text-red-700" %>"><%= @summary[:passed] ? "PASSED" : "NOT PASSED" %></p>
        <% end %>
      </div>
    </div>

    <% if @attempt.test_session && Rating.can_rate_test?(Current.user, @attempt.test_session) %>
      <%= render "ratings/form", kind: "test", id: @attempt.test_session_id,
            rating: @attempt.test_session.ratings.find_by(user: Current.user), title: "How was this test?" %>
    <% end %>

    <div class="space-y-6">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Answer Review</h3>

      <% @questions.each_with_index do |q, i| %>
        <% resp = @responses[q.id] %>
        <div class="p-6 rounded-2xl border bg-slate-50/50 dark:bg-slate-900/30 <%= resp&.is_correct ? "border-emerald-200 dark:border-emerald-900/50" : "border-slate-200 dark:border-slate-800" %>">
          <div class="flex justify-between items-start gap-4 mb-3">
            <span class="text-xs font-semibold bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 px-2.5 py-1 rounded-lg text-slate-700 dark:text-slate-300">Q<%= i + 1 %></span>

            <% if resp.nil? %>
              <span class="text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 px-2.5 py-0.5 rounded-full">Not attempted</span>
            <% elsif resp.chosen_option == "SKIPPED" %>
              <span class="text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200 px-2.5 py-0.5 rounded-full">Skipped</span>
            <% elsif resp.is_correct %>
              <span class="text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full">✓ Correct</span>
            <% else %>
              <span class="text-xs font-bold bg-red-50 text-red-700 border border-red-200 px-2.5 py-0.5 rounded-full">✗ Wrong</span>
            <% end %>
          </div>

          <p class="text-sm font-semibold text-slate-900 dark:text-white leading-relaxed mb-4"><%= q.content %></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs mb-4">
            <div class="p-2 rounded bg-white dark:bg-slate-950 border border-slate-100 dark:border-slate-800"><strong class="text-emerald-700 dark:text-emerald-400">Correct answer:</strong> <%= q.correct_answer %></div>
            <div class="p-2 rounded bg-white dark:bg-slate-950 border border-slate-100 dark:border-slate-800"><strong class="text-slate-500">Your answer:</strong> <%= resp&.chosen_option || "None" %></div>
          </div>

          <% if q.explanation.present? %>
            <div class="p-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-100 dark:border-slate-800 space-y-1">
              <p class="text-xs font-semibold text-brand-800 dark:text-brand-400">Explanation</p>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed"><%= q.explanation %></p>
            </div>
          <% end %>
          <div class="mt-3"><%= render "question_reports/form", question: q %></div>
        </div>
      <% end %>
    </div>

  </div>
</div>
