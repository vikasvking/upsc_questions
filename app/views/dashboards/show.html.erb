<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Test Breadcrumb navigation bar Info Row -->
    <div class="flex items-center gap-x-3">
      <%= link_to "← Quit Practice Session", root_path, class: "text-xs font-bold bg-slate-100 dark:bg-slate-900 hover:bg-slate-200 text-slate-600 dark:text-slate-400 px-3 py-1.5 rounded-lg transition-colors border border-slate-200 dark:border-slate-800" %>
      <h2 class="text-sm font-bold text-slate-400 dark:text-slate-500">Practice Arena Center</h2>
    </div>

    <!-- 2-Column Side-by-Side Responsive Grid System Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- Left Panel Map: Controls, Timers, Questions Numbers (Span 4) -->
      <div class="lg:col-span-4">
        <%= render "dashboards/quiz_sidebar" %>
      </div>

      <!-- Right Panel Map: Active MCQ Interactive Card Arena (Span 8) -->
      <div class="lg:col-span-8">
        <%= render "dashboards/quiz_content" %>
      </div>

    </div>

  </div>
</div>
