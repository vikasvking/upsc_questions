<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Workspace Greetings Row Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-slate-200 dark:border-slate-800 pb-6 gap-4">
      <div>
        <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">Aspirant Workspace</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Track your operational analytics and select a target module to begin practicing.</p>
      </div>
    </div>

    <!-- Streak Calendar Strip Component -->
    <%= render "dashboards/streak_calendar" %>

    <!-- 🚀 NEW ANALYTICS METRIC CARDS ROW -->
    <%= render "dashboards/analytics_cards" %>

    <!-- Main Subject Selection Portfolio Grid -->
    <div class="space-y-4">
      <h3 class="text-base font-extrabold uppercase tracking-wider text-slate-400 dark:text-slate-500 text-xs tracking-widest">Syllabus Subjects Portfolio</h3>
      <%= render "dashboards/subject_grid" %>
    </div>

  </div>
</div>
