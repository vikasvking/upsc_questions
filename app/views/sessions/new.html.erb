<div class="min-h-[calc(100vh-4rem)] flex flex-col justify-center px-6 py-12">
  <div class="mx-auto w-full max-w-sm">
    <div class="text-center">
      <a href="<%= root_path %>" class="inline-grid h-10 w-10 place-items-center rounded-xl bg-brand-700 text-white font-semibold">R</a>
      <h1 class="mt-5 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Welcome back</h1>
      <p class="mt-2 text-sm text-slate-500">Log in to continue your practice and keep your streak going.</p>
    </div>

    <div class="mt-8 rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-slate-200/70 dark:ring-slate-800 shadow-sm px-6 py-7">
      <% if alert %>
        <div class="mb-5 rounded-lg bg-red-50 dark:bg-red-950/40 px-3 py-2.5 text-sm text-red-800 dark:text-red-300 ring-1 ring-red-200 dark:ring-red-900/50"><%= alert %></div>
      <% end %>
      <% if notice %>
        <div class="mb-5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 px-3 py-2.5 text-sm text-emerald-800 dark:text-emerald-300 ring-1 ring-emerald-200 dark:ring-emerald-900/50"><%= notice %></div>
      <% end %>

      <%= form_with url: session_path, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= form.email_field :email_address, value: params[:email_address], required: true, autofocus: true, autocomplete: "email", class: "mt-1.5 block w-full rounded-lg border-0 py-2.5 px-3 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-600 bg-white dark:bg-slate-950 text-slate-900 dark:text-white" %>
        </div>
        <div>
          <div class="flex items-center justify-between">
            <%= form.label :password, "Password", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
            <%= link_to "Forgot password?", new_password_path, class: "text-sm text-brand-700 dark:text-brand-300 hover:underline" %>
          </div>
          <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1.5 block w-full rounded-lg border-0 py-2.5 px-3 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-600 bg-white dark:bg-slate-950 text-slate-900 dark:text-white" %>
        </div>
        <%= form.submit "Log in", class: "w-full rounded-lg bg-brand-700 px-3 py-2.5 text-sm font-medium text-white hover:bg-brand-800 cursor-pointer" %>
      <% end %>

      <p class="mt-6 text-center text-sm text-slate-500">New here? <%= link_to "Create a free account", new_registration_path, class: "font-medium text-brand-700 dark:text-brand-300 hover:underline" %></p>
    </div>
  </div>
</div>
