<div class="py-16 px-6">
  <div class="mx-auto max-w-lg text-center space-y-5">
    <div class="inline-grid h-14 w-14 place-items-center rounded-2xl bg-sky-50 dark:bg-sky-950/40 text-3xl">⏳</div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Your teacher account is waiting for approval</h1>
    <% if notice %><p class="rounded-lg bg-emerald-50 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300"><%= notice %></p><% end %>
    <p class="text-slate-600 dark:text-slate-400">An admin checks every new teacher account before it can create tests and questions. This keeps answer keys away from students. You'll be able to use the teacher pages as soon as it's approved.</p>
    <div class="flex justify-center gap-3">
      <%= link_to "Complete my profile", profile_path, class: "rounded-lg bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2.5" %>
      <%= link_to "Log out", session_path, data: { turbo_method: :delete }, class: "rounded-lg ring-1 ring-slate-200 dark:ring-slate-800 text-sm px-4 py-2.5 text-slate-600 dark:text-slate-300" %>
    </div>
  </div>
</div>
