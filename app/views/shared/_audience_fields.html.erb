<%# "Visible to" for a test or question. locals: prefix ("test_session", "question" or nil for top-level params), record %>
<%
  choices = audience_choices(record)
  name = ->(field) { prefix ? "#{prefix}[#{field}]" : field.to_s }
  current = params.dig(prefix, :visibility).presence || params[:visibility].presence || record.visibility
  granted_users = params.dig(:audience, :user_ids) ? Array(params.dig(:audience, :user_ids)).map(&:to_i) : record.granted_ids("User")
  granted_insts = params.dig(:audience, :institution_ids) ? Array(params.dig(:audience, :institution_ids)).map(&:to_i) : record.granted_ids("Institution")
  granted_batches = params.dig(:audience, :batch_ids) ? Array(params.dig(:audience, :batch_ids)).map(&:to_i) : record.granted_ids("Batch")
  chosen_inst = (params.dig(prefix, :institution_id).presence || params[:institution_id].presence || record.institution_id).to_i
  box = "rounded-xl ring-1 ring-slate-200 dark:ring-slate-800 p-3 max-h-56 overflow-y-auto space-y-1.5"
  sel = "mt-1 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white"
%>
<div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4" data-controller="audience">
  <div>
    <p class="text-xs font-bold text-slate-400 dark:text-slate-500">Visible to</p>
    <div class="mt-2 grid grid-cols-1 sm:grid-cols-3 gap-2">
      <% Audience::VISIBILITIES.each do |value, label| %>
        <label class="flex items-start gap-2 p-3 rounded-xl ring-1 ring-slate-200 dark:ring-slate-800 cursor-pointer has-[:checked]:ring-2 has-[:checked]:ring-brand-700 text-sm">
          <%= radio_button_tag name.(:visibility), value, current == value, id: "#{prefix}_visibility_#{value}", class: "mt-0.5 accent-brand-700", data: { action: "audience#toggle" } %>
          <span class="text-slate-900 dark:text-white"><%= label %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div data-audience-target="institution" class="<%= "hidden" unless current == "institution" %>">
    <% if choices.own_institutions.any? %>
      <%= label_tag name.(:institution_id), "Which school or coaching", class: "text-xs font-bold text-slate-400" %>
      <%= select_tag name.(:institution_id), options_for_select(choices.own_institutions.map { |i| [i.label, i.id] }, chosen_inst), class: sel %>
      <p class="mt-1 text-xs text-slate-500">Only its approved students (and its teachers) will see this.</p>
    <% else %>
      <p class="text-sm text-amber-800 dark:text-amber-300">You're not a teacher at any school or coaching yet. <%= link_to "Join or add one", institutions_path, class: "underline" %>.</p>
    <% end %>
  </div>

  <div data-audience-target="selected" class="<%= "hidden" unless current == "selected" %> grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div>
      <p class="text-xs font-bold text-slate-400">Students<% if choices.students.size >= 300 %> (first 300; add others by email)<% end %></p>
      <div class="mt-1 <%= box %>">
        <%= hidden_field_tag "audience[user_ids][]", "", id: nil %>
        <% choices.students.each do |s| %>
          <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
            <%= check_box_tag "audience[user_ids][]", s.id, granted_users.include?(s.id), id: "aud_user_#{s.id}" %> <%= s.display_name %>
          </label>
        <% end %>
        <% if choices.students.empty? %><p class="text-xs text-slate-500">No students at your schools or coachings yet.</p><% end %>
      </div>
      <%= text_area_tag "audience[emails]", params.dig(:audience, :emails), rows: 2, placeholder: "Add students by email, separated by commas", class: "#{sel} text-xs" %>
    </div>
    <div>
      <p class="text-xs font-bold text-slate-400">Whole schools or coachings</p>
      <div class="mt-1 <%= box %>">
        <%= hidden_field_tag "audience[institution_ids][]", "", id: nil %>
        <% choices.all_institutions.each do |i| %>
          <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
            <%= check_box_tag "audience[institution_ids][]", i.id, granted_insts.include?(i.id), id: "aud_inst_#{i.id}" %> <%= i.label %>
          </label>
        <% end %>
      </div>
    </div>
    <div>
      <p class="text-xs font-bold text-slate-400">Batches <%= link_to "(manage)", batches_path, class: "font-normal text-brand-700 dark:text-brand-300" unless Current.user.staff? %></p>
      <div class="mt-1 <%= box %>">
        <%= hidden_field_tag "audience[batch_ids][]", "", id: nil %>
        <% choices.batches.each do |b| %>
          <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
            <%= check_box_tag "audience[batch_ids][]", b.id, granted_batches.include?(b.id), id: "aud_batch_#{b.id}" %> <%= b.name %><%= " (#{b.user.display_name})" if Current.user.staff? %>
          </label>
        <% end %>
        <% if choices.batches.empty? %><p class="text-xs text-slate-500">No batches yet.</p><% end %>
      </div>
    </div>
  </div>
</div>
