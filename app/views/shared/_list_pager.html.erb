<%# Footer for paged lists (ExamListing#paginate). locals: total (rows matching the filters), noun ("question") %>
<%
  keep = request.query_parameters.except("page")
  first = total.zero? ? 0 : (@page - 1) * @per_page + 1
  last  = [@page * @per_page, total].min
  button = "rounded-lg px-3 py-1.5 ring-1 ring-slate-200 dark:ring-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800"
%>
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-slate-500">
    <span><%= number_with_delimiter(first) %>–<%= number_with_delimiter(last) %> of <%= pluralize(number_with_delimiter(total), noun) %></span>
    <span class="text-slate-300 dark:text-slate-700">·</span>
    <span>Show
      <% ExamListing::PER_PAGE_CHOICES.each do |n| %>
        <% if n == @per_page %>
          <strong class="text-slate-900 dark:text-white"><%= n %></strong>
        <% else %>
          <%= link_to n, url_for(keep.merge("per" => n)), class: "text-brand-700 dark:text-brand-300 hover:underline" %>
        <% end %>
      <% end %>
      per page</span>
  </div>
  <% if @page > 1 || @next_page %>
    <div class="flex gap-2">
      <% if @page > 1 %>
        <%= link_to "← Previous", url_for(keep.merge("page" => @page - 1)), class: button %>
      <% end %>
      <% if @next_page %>
        <%= link_to "Next →", url_for(keep.merge("page" => @next_page)), class: button %>
      <% end %>
    </div>
  <% end %>
</div>
