<!-- app/views/question_banks/show.html.erb -->
<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Title Header Row -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">Question Bank Repository</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Select an active testing stream from the grid below to initialize adaptive mock challenges.</p>
    </div>

    <!-- Syllabus Portfolio Block -->
    <div class="space-y-4">
      <h3 class="text-base font-extrabold uppercase text-slate-400 dark:text-slate-500 text-xs tracking-widest">Syllabus Subjects Portfolio</h3>

      <!-- 🚀 FIX: Change "dashboards/subject_grid" if it's stored in dashboards, or keep it explicitly mapped like this: -->
      <%= render "subject_grid" %>
    </div>

  </div>
</div>
