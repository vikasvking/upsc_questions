<% labels = { "all" => "All", "solved" => "Solved", "wrong" => "Not yet correct", "not_attempted" => "Not attempted" } %>
<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">

    <div class="border-b border-slate-200 dark:border-slate-800 pb-6 space-y-4">
      <%= link_to "← Question Bank", question_bank_path, class: "text-xs font-bold text-brand-800 dark:text-brand-400 hover:underline" %>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl"><%= topic_icon(@topic) %> <%= @topic %></h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            <%= @stat.solved %> of <%= @stat.total %> solved · <%= pluralize(@stat.attempts, "attempt") %>
            <% if @stat.accuracy_pct %> · <%= @stat.accuracy_pct %>% accuracy<% end %>
            <% if @stat.completed? %> · <span class="font-bold text-emerald-700 dark:text-emerald-400">✓ Completed</span><% end %>
          </p>
        </div>
        <%= link_to "Practice this topic →", dashboard_path(topic: @topic), class: "shrink-0 text-center text-xs font-semibold text-white bg-brand-800 hover:bg-brand-900 px-4 py-2.5 rounded-xl shadow-sm" %>
      </div>
      <div class="h-2 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
        <div class="h-full rounded-full <%= @stat.completed? ? "bg-emerald-600" : "bg-brand-800 dark:bg-brand-500" %>" style="width: <%= @stat.progress_pct %>%"></div>
      </div>
    </div>

    <% if alert %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 ring-1 ring-red-200 dark:ring-red-900/40 text-sm text-red-800 dark:text-red-300"><%= alert %></div>
    <% end %>
    <% if Current.user.free_tier? %>
      <div class="rounded-xl bg-pink-50 dark:bg-pink-950/30 px-4 py-3 ring-1 ring-pink-200 dark:ring-pink-900/50 text-sm text-pink-900 dark:text-pink-200 flex flex-wrap items-center justify-between gap-2">
        <span>🌱 Free trial: you can see every question, and answer the 🎁 sample questions once each.</span>
        <%= link_to "Unlock all questions →", membership_path, class: "font-medium underline" %>
      </div>
    <% end %>

    <!-- Filter tabs -->
    <div class="flex flex-wrap gap-2">
      <% labels.each do |key, label| %>
        <%= link_to question_bank_topic_path(name: @topic, filter: key),
              class: "text-xs font-bold px-3 py-1.5 rounded-full border #{@filter == key ? "bg-brand-800 text-white border-brand-800" : "bg-white dark:bg-slate-950 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-800"}" do %>
          <%= label %> (<%= @filter_counts[key] %>)
        <% end %>
      <% end %>
    </div>

    <% if @questions.empty? %>
      <p class="text-sm text-slate-500 py-8 text-center">No questions in this list.</p>
    <% end %>

    <div class="space-y-4">
      <% @questions.each do |q| %>
        <% s = @question_stats[q.id] %>
        <% last = s.last_response %>
        <% if q.locked_for?(Current.user) %>
          <%# Free members see the question, but only Plus and Warrior can answer it %>
          <div id="q-<%= q.id %>" class="scroll-mt-6 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="text-xs font-semibold bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 px-2.5 py-1 rounded-lg text-slate-700 dark:text-slate-300">#<%= @numbers[q.id] %></span>
              <span class="text-xs font-mono text-slate-400"><%= [(exam_name(q.exam_type) if q.exam_type.present?), q.year].compact_blank.join(" · ") %></span>
              <span class="ml-auto text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-500 border border-slate-200 dark:bg-slate-800 dark:text-slate-400 dark:border-slate-700">🔒 Plus / Warrior</span>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white leading-relaxed"><%= q.content %></p>
            <div class="mt-3 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800/60 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">🔒 Upgrade to attempt</p>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Plus or Warrior unlocks this question, its answer and explanation.</p>
              </div>
              <%= link_to "See plans", membership_path, class: "shrink-0 self-start sm:self-auto rounded-lg bg-slate-700 hover:bg-slate-800 dark:bg-slate-600 dark:hover:bg-slate-500 text-white text-xs font-bold px-4 py-2" %>
            </div>
          </div>
          <% next %>
        <% end %>
        <div id="q-<%= q.id %>" class="scroll-mt-6 p-5 rounded-2xl border bg-slate-50/50 dark:bg-slate-900/30 <%= s.solved? ? "border-emerald-200 dark:border-emerald-900/50" : "border-slate-200 dark:border-slate-800" %> <%= "ring-2 ring-offset-2 dark:ring-offset-slate-950 #{flash[:answered_correct] ? "ring-emerald-500" : "ring-red-500"}" if q.id == @answered_id %>">
          <% if q.id == @answered_id %>
            <p class="mb-3 text-sm font-semibold <%= flash[:answered_correct] ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400" %>">
              <%= flash[:answered_correct] ? "✓ Correct!" : "✗ Not quite. The correct answer is highlighted below." %>
            </p>
          <% end %>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="text-xs font-semibold bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 px-2.5 py-1 rounded-lg text-slate-700 dark:text-slate-300">#<%= @numbers[q.id] %></span>
            <span class="text-xs font-mono text-slate-400"><%= [(exam_name(q.exam_type) if q.exam_type.present?), q.year].compact_blank.join(" · ") %></span>
            <span class="ml-auto text-xs font-bold px-2.5 py-0.5 rounded-full
              <%= if s.solved? then "bg-emerald-50 text-emerald-700 border border-emerald-200"
                  elsif s.attempted? then "bg-red-50 text-red-700 border border-red-200"
                  else "bg-slate-100 text-slate-500 border border-slate-200" end %>">
              <% if s.attempted? %>
                Attempted <%= pluralize(s.attempts, "time") %> · correct <%= s.correct_attempts %>
              <% else %>
                Not attempted
              <% end %>
            </span>
          </div>

          <p class="text-sm font-semibold text-slate-900 dark:text-white leading-relaxed"><%= q.content %></p>

          <!-- Practise this one question: pick an option and check -->
          <%= form_with url: question_bank_answer_path, method: :post, class: "single-practice mt-3" do %>
            <%= hidden_field_tag :question_id, q.id, id: nil %>
            <%= hidden_field_tag :filter, @filter, id: nil %>
            <%= hidden_field_tag :duration_seconds, 0, id: nil, class: "js-duration" %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <% [["A", q.option_a], ["B", q.option_b], ["C", q.option_c], ["D", q.option_d]].each do |letter, text| %>
                <% next if text.blank? %>
                <%
                  box = "bg-white dark:bg-slate-950 border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300"
                  if s.attempted?
                    if letter == q.correct_answer
                      box = "bg-emerald-50 dark:bg-emerald-950/30 border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 font-bold"
                    elsif last && letter == last.chosen_option
                      box = "bg-red-50 dark:bg-red-950/30 border-red-300 dark:border-red-800 text-red-800 dark:text-red-300"
                    end
                  end
                %>
                <label class="flex items-start gap-2 p-2.5 rounded-lg border cursor-pointer has-[:checked]:ring-2 has-[:checked]:ring-brand-700 <%= box %>">
                  <%= radio_button_tag :answer_choice, letter, false, id: "q#{q.id}_#{letter}", class: "mt-0.5 accent-brand-800" %>
                  <span><strong><%= letter %>.</strong> <%= text %></span>
                </label>
              <% end %>
            </div>
            <div class="mt-3 flex items-center gap-3">
              <%= submit_tag (s.attempted? ? "Try again" : "Check answer"), name: nil, class: "rounded-lg bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold px-4 py-2 cursor-pointer" %>
              <span class="text-xs text-slate-400">Counts as one attempt. Not part of any test.</span>
            </div>
          <% end %>

          <% if s.attempted? %>
            <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
              Your last answer: <strong><%= last&.chosen_option %></strong> · Correct answer: <strong class="text-emerald-700 dark:text-emerald-400"><%= q.correct_answer %></strong>
            </p>
            <% if q.explanation.present? %>
              <div class="mt-3 p-3 rounded-xl bg-white dark:bg-slate-950 border border-slate-100 dark:border-slate-800">
                <p class="text-xs font-semibold text-brand-800 dark:text-brand-400">Explanation</p>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-1"><%= q.explanation %></p>
              </div>
            <% end %>
          <% else %>
            <p class="mt-3 text-xs text-slate-400">Answer and explanation appear after you attempt this question in a practice or test.</p>
          <% end %>
          <div class="mt-3"><%= render "question_reports/form", question: q %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Time each single-question practice from when the question first scrolls into view
  // (so reading time counts), falling back to the first click on its options.
  (function () {
    const forms = document.querySelectorAll("form.single-practice");
    const seen = new Map();
    const observer = "IntersectionObserver" in window ? new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting && !seen.has(e.target)) seen.set(e.target, Date.now()); });
    }, { threshold: 0.5 }) : null;

    forms.forEach((form) => {
      const card = form.closest("[id^='q-']") || form;
      if (observer) observer.observe(card);
      form.addEventListener("change", () => { if (!seen.has(card)) seen.set(card, Date.now()); });
      form.addEventListener("submit", () => {
        const start = seen.get(card);
        const secs = start ? Math.round((Date.now() - start) / 1000) : 0;
        form.querySelector(".js-duration").value = Math.max(secs, 1);
      });
    });
  })();
</script>
