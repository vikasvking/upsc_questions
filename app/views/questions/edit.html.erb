<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div>
      <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">Modify Question Asset</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Make changes below to update this question's options, correct answer, or explanation rationale.</p>
    </div>

    <div class="bg-slate-50 dark:bg-slate-900 px-6 py-8 shadow-xl rounded-2xl border border-slate-200 dark:border-slate-800">

      <% if @question.errors.any? %>
        <div class="mb-6 rounded-xl bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50">
          <ul class="list-disc pl-5 text-xs text-red-800 dark:text-red-400 space-y-1">
            <% @question.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @question, class: "space-y-6" do |form| %>

        <!-- Meta Configuration Row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= form.label :exam_type, "Exam Portfolio", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
            <%= form.select :exam_type, [["UPSC", "UPSC"], ["SSC", "SSC"], ["BANKING", "BANKING"], ["CBSE", "CBSE"], ["JEE", "JEE"]], {}, class: "mt-1.5 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
          </div>
          <div>
            <%= form.label :year, "Exam Year (Optional)", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
            <%= form.number_field :year, class: "mt-1.5 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
          </div>
          <div>
            <%= form.label :q_no, "Question Number", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
            <%= form.text_field :q_no, required: true, class: "mt-1.5 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
          </div>
        </div>

        <!-- Topic Category -->
        <div>
          <%= form.label :topic, "Syllabus Topic Section Name", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
          <%= form.text_field :topic, required: true, class: "mt-2 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
        </div>

        <!-- Main Content Core Prompt Statement -->
        <div>
          <%= form.label :content, "Question Prompt Statement Statement", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
          <%= form.text_area :content, rows: 4, required: true, class: "mt-2 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800 leading-relaxed font-sans" %>
        </div>

        <!-- Four Multiple Choice Inputs Grid -->
        <div class="border-t border-slate-200 dark:border-slate-800 pt-6 space-y-4">
          <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Multiple Choice Core Option Fields</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= form.label :option_a, "Option A text", class: "block text-xs font-semibold text-slate-600 dark:text-slate-400" %>
              <%= form.text_field :option_a, class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
            </div>
            <div>
              <%= form.label :option_b, "Option B text", class: "block text-xs font-semibold text-slate-600 dark:text-slate-400" %>
              <%= form.text_field :option_b, class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
            </div>
            <div>
              <%= form.label :option_c, "Option C text", class: "block text-xs font-semibold text-slate-600 dark:text-slate-400" %>
              <%= form.text_field :option_c, class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
            </div>
            <div>
              <%= form.label :option_d, "Option D text", class: "block text-xs font-semibold text-slate-600 dark:text-slate-400" %>
              <%= form.text_field :option_d, class: "mt-1 block w-full rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800" %>
            </div>
          </div>
        </div>

        <!-- Correct Key Selection -->
        <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
          <%= form.label :correct_answer, "Identify Correct Answer Key", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
          <%= form.select :correct_answer, [["Option A", "A"], ["Option B", "B"], ["Option C", "C"], ["Option D", "D"]], {}, class: "mt-2 block w-28 rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white font-black focus:ring-2 focus:ring-brand-800 text-sm" %>
        </div>

        <!-- Textbook Explanation Rationale -->
        <div>
          <%= form.label :explanation, "Textbook Rationale Explanation", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
          <%= form.text_area :explanation, rows: 4, class: "mt-2 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-800 leading-relaxed font-mono text-xs" %>
        </div>

        <!-- Form Button Controls Row -->
        <div class="flex gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <%= link_to "Discard Changes", questions_path, class: "flex-1 text-center font-bold text-xs border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-950 px-4 py-3 rounded-xl hover:bg-slate-100 transition-colors shadow-sm" %>
          <%= form.submit "Apply Repository Changes", class: "flex-1 justify-center rounded-xl bg-brand-800 dark:bg-brand-700 px-4 py-3 text-xs font-bold text-white shadow-md hover:bg-brand-900 dark:hover:bg-brand-600 transition-colors cursor-pointer transform hover:-translate-y-0.5" %>
        </div>

      <% end %>
    </div>

  </div>
</div>
