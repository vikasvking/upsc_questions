<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Workspace Header Row Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 dark:border-slate-800 pb-6 gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Question Management Hub</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Total Loaded Repository: <strong class="text-brand-800 dark:text-brand-400"><%= @questions.count %></strong> Questions</p>
      </div>
      <div class="flex flex-wrap gap-2">
      <%= link_to "Add Question ➕", new_question_path, class: "rounded-xl border border-brand-800 text-brand-800 dark:text-brand-300 bg-white dark:bg-slate-950 font-bold text-xs px-4 py-2.5 shadow-sm text-center" %>
      <%= link_to "Import More Questions 📥", upload_form_questions_path, class: "rounded-xl bg-brand-800 hover:bg-brand-900 dark:bg-brand-700 dark:hover:bg-brand-600 text-white font-bold text-xs px-4 py-2.5 shadow-sm text-center transition-all cursor-pointer" %>
      </div>
    </div>

    <!-- Active Flash Banner Alerts Notification Display -->
    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-900/50 animate-fadeIn">
        <p class="text-xs font-bold text-emerald-800 dark:text-emerald-400 flex items-center gap-x-2"><span>✓</span> <%= notice %></p>
      </div>
    <% end %>

    <% if alert %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50">
        <p class="text-xs font-bold text-red-800 dark:text-red-400 flex items-center gap-x-2"><span>🔒</span> <%= alert %></p>
      </div>
    <% end %>

    <!-- Questions Management Table Matrix Container -->
    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm bg-white dark:bg-slate-900">
      <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
        <thead class="bg-slate-50 dark:bg-slate-950 font-bold text-slate-900 dark:text-slate-300">
          <tr>
            <th class="px-4 py-3.5">Portfolio</th>
            <th class="px-4 py-3.5">Year</th>
            <th class="px-4 py-3.5">Syllabus Topic Category</th>
            <th class="px-6 py-3.5">Question Prompt Content Snippet</th>
            <th class="px-4 py-3.5 text-center">Correct Key</th>
            <th class="px-4 py-3.5 texe-right"> Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-400">
          <% if @questions.any? %>
            <% @questions.each do |question| %>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-950/30 transition-colors">
                <!-- Exam Type Portfolio Capsule -->
                <td class="px-4 py-3.5 font-bold">
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold bg-brand-50 dark:bg-brand-950/40 text-brand-800 dark:text-brand-400 border border-brand-200/40">
                    <%= question.exam_type %>
                  </span>
                </td>

                <!-- Exam Year -->
                <td class="px-4 py-3.5 font-bold font-mono text-slate-900 dark:text-white">
                  <%= question.year.presence || "Mock" %>
                </td>


                <!-- Topic Capsule -->
                <td class="px-4 py-3.5">
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                    <%= question.topic %>
                  </span>
                </td>

                <!-- Content Prompt Snippet -->
                <td class="px-6 py-3.5 max-w-md truncate font-medium text-slate-600 dark:text-slate-400" title="<%= question.content %>">
                  <%= question.content %>
                </td>

                <!-- Correct Answer Key -->
                <td class="px-4 py-3.5 text-center font-semibold text-emerald-600 dark:text-emerald-400 bg-slate-50/30 dark:bg-slate-950/10">
                  <%= question.correct_answer %>
                </td>
                <td class="px-4 py-3.5 text-right whitespace-nowrap">
                  <% if Current.user.admin? || question.user_id == Current.user.id %>
                    <%= link_to "Edit 📝", edit_question_path(question), class: "text-xs font-semibold text-brand-800 dark:text-brand-400 hover:text-brand-900 dark:hover:text-brand-300 transition-colors bg-brand-50 dark:bg-brand-950/40 px-2.5 py-1 rounded-lg border border-brand-200/40 shadow-sm" %>
                  <% else %>
                    <button type="button"
                            data-creator="<%= question.user&.email_address || "another teacher" %>"
                            onclick="window.showNotCreator(this.dataset.creator)"
                            title="Only the creator or an admin can edit this question"
                            class="text-xs font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-900 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 cursor-not-allowed">🔒 Edit</button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <!-- Fallback Empty State Display Matrix -->
            <tr>
              <td colspan="6" class="text-center py-12 text-slate-400 font-medium bg-slate-50/50 dark:bg-slate-950/10">
                The question repository is currently empty. Click the button on top to ingest your Excel question sets.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<!-- Pop-up shown when a teacher tries to edit someone else's question -->
<dialog id="not-creator-dialog" class="rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50 max-w-sm w-[90vw] m-auto">
  <div class="p-6 space-y-3 bg-white dark:bg-slate-900">
    <p class="text-2xl">🔒</p>
    <h3 class="text-base font-semibold text-slate-900 dark:text-white">You are not the creator of this question</h3>
    <p class="text-sm text-slate-600 dark:text-slate-400">Only <strong id="not-creator-name"></strong> or an admin can edit it.</p>
    <form method="dialog" class="pt-2">
      <button class="w-full rounded-xl bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold py-2.5 cursor-pointer">OK</button>
    </form>
  </div>
</dialog>

<script>
  window.showNotCreator = function (creator) {
    const dialog = document.getElementById("not-creator-dialog");
    document.getElementById("not-creator-name").textContent = creator; // textContent keeps it escaped
    dialog.showModal();
  };
</script>
