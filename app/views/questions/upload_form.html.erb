<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Title Header Row -->
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">Admin Data Ingestion</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Upload and seed your core exam repository from standard historical spreadsheet formats.</p>
    </div>

    <!-- Download Reference Sample Link Strip -->
    <div class="bg-rose-50/50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 shadow-sm">
      <div class="flex items-center gap-x-3">
        <span class="text-xl">📋</span>
        <div>
          <h4 class="text-xs font-bold text-slate-900 dark:text-white">Required Ingestion Format</h4>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Ensure your upload columns match our required system column sequences.</p>
        </div>
      </div>
      <%= link_to "Download Sample Sheet 📥", download_template_questions_path, class: "text-xs font-black text-white bg-rose-800 hover:bg-rose-900 dark:bg-rose-700 dark:hover:bg-rose-600 px-3.5 py-2 rounded-xl transition-all shadow-sm text-center cursor-pointer" %>
    </div>

    <!-- Alert / Notice Notification Banners -->
    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-900/50 animate-fadeIn">
        <p class="text-xs font-bold text-emerald-800 dark:text-emerald-400 flex items-center gap-x-2"><span>✓</span> <%= notice %></p>
      </div>
    <% end %>

    <% if alert %>
      <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 p-4 border border-rose-200 dark:border-rose-900/50 animate-fadeIn">
        <p class="text-xs font-bold text-rose-800 dark:text-rose-400 flex items-center gap-x-2"><span>✗</span> <%= alert %></p>
      </div>
    <% end %>

    <!-- Ingestion Form Container Box -->
    <div class="bg-slate-50 dark:bg-slate-900 px-6 py-8 shadow-xl rounded-2xl border border-slate-200 dark:border-slate-800">
      <%= form_with url: import_questions_path, multipart: true, local: true, class: "space-y-6" do |form| %>

        <!-- Exam Type Stream Selector Dropdown Input -->
        <div>
          <%= form.label :exam_type, "Select Target Exam Portfolio", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
          <div class="mt-2">
            <%= form.select :exam_type,
                            [["UPSC Civil Services", "UPSC"], ["SSC CGL / CHSL", "SSC"], ["Banking (SBI/IBPS)", "BANKING"], ["CBSE Class X", "CBSE"], ["IIT JEE Main", "JEE"]],
                            {},
                            { class: "block w-full rounded-xl border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white focus:ring-2 focus:ring-inset focus:ring-rose-800 dark:focus:ring-rose-500 sm:text-sm" } %>
          </div>
          <p class="mt-1 text-[10px] text-slate-400">All questions in the attached file will automatically be categorized under this stream portfolio.</p>
        </div>

        <!-- Optional Exam Year Parameter Selection Input -->
        <div>
          <%= form.label :year, "Exam Year Source (Optional - Leave blank for Custom Mock Questions)", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
          <div class="mt-2">
            <%= form.number_field :year, placeholder: "e.g., 2026", class: "block w-full rounded-xl border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-rose-800 dark:focus:ring-rose-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm" %>
          </div>
          <p class="mt-1 text-[10px] text-slate-400">Sets the timeline token mapped into historical PYQ metrics if applicable.</p>
        </div>

        <!-- Dynamic Drag & Drop File Field Input Container -->
        <div>
          <label class="block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200">Select Excel Spreadsheet Template File</label>
          <div class="mt-2 flex justify-center rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 px-6 py-10 bg-white dark:bg-slate-950/30 hover:border-rose-800/40 transition-colors relative group">
            <div class="text-center space-y-2">
              <div class="text-3xl">📊</div>
              <div class="flex text-xs leading-6 text-slate-600 dark:text-slate-400 justify-center">
                <span class="relative font-bold text-rose-800 dark:text-rose-400 hover:text-rose-900 cursor-pointer">Click to browse file</span>
              </div>
              <p class="text-[10px] text-slate-400">Accepts only standard simplified spreadsheet formats (.xlsx)</p>

              <!-- Hidden Native Input Layer positioned cleanly across the active click zone -->
              <%= form.file_field :file, accept: '.xlsx', required: true, id: "excel-uploader-input", class: "absolute inset-0 opacity-0 cursor-pointer w-full h-full" %>
            </div>
          </div>
          <!-- File Name Indicator Text Hook -->
          <p id="file-name-indicator" class="mt-3 text-xs font-mono font-bold text-rose-800 dark:text-rose-400 hidden bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-2.5 rounded-lg shadow-sm w-fit"></p>
        </div>

        <!-- Submit Buttons Action row -->
        <div class="flex gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <%= link_to "Cancel & Return", dashboard_path, class: "flex-1 text-center font-bold text-xs border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-950 px-4 py-3 rounded-xl hover:bg-slate-100 transition-colors shadow-sm" %>
          <%= form.submit "Execute Data Import Ingestion", id: "submit-ingestion-trigger", class: "flex-1 justify-center rounded-xl bg-rose-800 dark:bg-rose-700 px-4 py-3 text-xs font-bold text-white shadow-md hover:bg-rose-900 dark:hover:bg-rose-600 transition-colors cursor-pointer transform hover:-translate-y-0.5" %>
        </div>

      <% end %>
    </div>

  </div>
</div>

<!-- Reactive Script helper to notify the administrator what file was attached -->
<script>
  document.addEventListener("turbo:load", () => {
    const input = document.getElementById('excel-uploader-input');
    const indicator = document.getElementById('file-name-indicator');

    if (input && indicator) {
      input.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
          // Extracts the active file array list properties natively
          indicator.innerText = `📎 Attached file: ${e.target.files[0].name}`;
          indicator.classList.remove('hidden');
        } else {
          indicator.classList.add('hidden');
        }
      });
    }
  });
</script>
