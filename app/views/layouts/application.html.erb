<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Upsc Question" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Upsc Question">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
  // 1. Core theme applicator function (safe to execute instantly anywhere)
  function applyTheme() {
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
      document.getElementById('theme-toggle-sun')?.classList.remove('hidden');
      document.getElementById('theme-toggle-moon')?.classList.add('hidden');
    } else {
      document.documentElement.classList.remove('dark');
      document.getElementById('theme-toggle-sun')?.classList.add('hidden');
      document.getElementById('theme-toggle-moon')?.classList.remove('hidden');
    }
  }

  // 2. Instantly parse on initial asset hit to prevent light flash flickering layouts
  applyTheme();

  // Small-screen sidebar: open with the menu button, close with ✕, the dark backdrop, Esc or any link.
  // Listeners sit on document, so they keep working across Turbo page changes.
  function setSidebar(open) {
    const sidebar = document.getElementById("app-sidebar");
    const backdrop = document.getElementById("sidebar-backdrop");
    const button = document.getElementById("sidebar-open");
    if (!sidebar) return;
    sidebar.classList.toggle("-translate-x-full", !open);
    backdrop?.classList.toggle("hidden", !open);
    button?.setAttribute("aria-expanded", open ? "true" : "false");
    document.body.classList.toggle("overflow-hidden", open);
  }
  document.addEventListener("click", (e) => {
    if (e.target.closest("#sidebar-open")) setSidebar(true);
    else if (e.target.closest("#sidebar-close") || e.target.id === "sidebar-backdrop") setSidebar(false);
    else if (e.target.closest("#app-sidebar a")) setSidebar(false);
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setSidebar(false); });
  document.addEventListener("turbo:before-cache", () => setSidebar(false));

  // 3. Bind to Turbo page load changes (Forces it to re-evaluate on every single internal click)
  document.addEventListener("turbo:load", () => {
    applyTheme();

    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn) {
      // CRITICAL FOR TURBO: Remove any existing clone listeners to avoid stacking click events
      const newToggleBtn = toggleBtn.cloneNode(true);
      toggleBtn.parentNode.replaceChild(newToggleBtn, toggleBtn);

      newToggleBtn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
        applyTheme();
      });
    }
  });
</script>


  </head>

  <body data-role="<%= authenticated? ? Current.user.role : "guest" %>" class="bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 font-sans transition-colors duration-200 antialiased">

   <% if authenticated? %>
     <!-- Small screens: top bar with a menu button (the sidebar slides in over the page) -->
     <div class="lg:hidden sticky top-0 z-30 flex items-center gap-3 h-14 px-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800">
       <button type="button" id="sidebar-open" aria-label="Open menu" aria-controls="app-sidebar" aria-expanded="false" class="p-2 -ml-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
         <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
       </button>
       <span class="h-7 w-7 rounded-lg bg-brand-700 text-white grid place-items-center text-xs font-semibold">U</span>
       <span class="font-semibold text-slate-900 dark:text-white">UPSCOfficer</span>
       <span class="ml-auto text-xs font-medium rounded-full px-2.5 py-0.5 bg-brand-50 text-brand-800 dark:bg-brand-950 dark:text-brand-200"><%= Current.user.role.humanize %></span>
     </div>
     <div id="sidebar-backdrop" class="hidden lg:hidden fixed inset-0 z-30 bg-slate-900/50"></div>

     <!-- Left sidebar: always visible on large screens, slide-in on small screens -->
     <%= render "layouts/side_nav" %>

     <!-- Content column: pushed right by the sidebar width on large screens only -->
     <main class="lg:pl-60 min-h-screen">
       <div class="px-2 sm:px-4">
         <%= yield %>
       </div>
     </main>
   <% else %>
     <!-- Standard layout template setup for public homepage, login, and registration screens -->
     <%= render "layouts/navbar" %>
     <main class="pt-20 min-h-screen">
       <%= yield %>
     </main>
   <% end %>

 </body>
</html>
