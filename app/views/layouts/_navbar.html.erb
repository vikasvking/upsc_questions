<header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-850 fixed inset-x-0 top-0 z-50 transition-colors duration-200">
  <nav class="mx-auto flex max-w-7xl items-center justify-between p-4 lg:px-8" aria-label="Global">
    <!-- Branding -->
    <div class="flex lg:flex-1">
      <%= link_to root_path, class: "-m-1.5 p-1.5 flex items-center gap-x-2" do %>
        <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
          UPSC<span class="text-rose-800 dark:text-rose-400">Officer</span>
        </span>
      <% end %>
    </div>

    <!-- Right Side Actions & Dark Mode Toggle -->
    <div class="flex flex-1 justify-end items-center gap-x-6">
      <!-- Theme Toggle Button -->
      <button id="theme-toggle" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none" aria-label="Toggle dark mode">
        <svg id="theme-toggle-sun" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 14.121a1 1 0 010-1.414l.707-.707a1 1 0 111.414 1.414l-.707.707a1 1 0 01-1.414 0zm-9.9-4.242a1 1 0 011.415 0l.707.707a1 1 0 11-1.414 1.414l-.707-.707a1 1 0 010-1.414zm1.414-5.657a1 1 0 000 1.414l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 0z"></path></svg>
        <svg id="theme-toggle-moon" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
      </button>

      <!-- Auth Buttons -->
      <%= link_to "Log In", "#", class: "text-sm font-semibold leading-6 text-slate-900 dark:text-slate-300 hover:text-rose-800 dark:hover:text-rose-400" %>
      <%= link_to "Sign Up", "#", class: "rounded-md bg-rose-800 hover:bg-rose-900 dark:bg-rose-700 dark:hover:bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-md transition-colors" %>
    </div>
  </nav>
</header>
