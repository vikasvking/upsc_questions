<header class="fixed inset-x-0 top-0 z-30 h-16 bg-white/85 dark:bg-slate-950/85 backdrop-blur border-b border-slate-200/70 dark:border-slate-800">
  <nav class="mx-auto max-w-6xl h-full px-6 flex items-center justify-between gap-4" aria-label="Main">
    <a href="<%= root_path %>" class="flex items-center gap-2">
      <span class="h-8 w-8 rounded-lg bg-brand-700 text-white grid place-items-center text-sm font-semibold">R</span>
      <span class="font-semibold text-slate-900 dark:text-white">Rankwise</span>
    </a>

    <div class="hidden md:flex items-center gap-6 text-sm text-slate-600 dark:text-slate-400">
      <a href="<%= root_path %>#features" class="hover:text-slate-900 dark:hover:text-white">Why Rankwise</a>
      <a href="<%= root_path %>#teachers" class="hover:text-slate-900 dark:hover:text-white">For teachers</a>
      <a href="<%= root_path %>#pricing" class="hover:text-slate-900 dark:hover:text-white">Pricing</a>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <button id="theme-toggle" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer" aria-label="Toggle dark mode">
        <svg id="theme-toggle-sun" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.72 0l-.7.7M6.34 17.66l-.7.7M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg id="theme-toggle-moon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.35 15.35A9 9 0 018.65 3.65 9 9 0 1020.35 15.35z"/></svg>
      </button>
      <% if authenticated? %>
        <%= link_to "Dashboard", dashboard_path, class: "rounded-lg bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800" %>
      <% else %>
        <%= link_to "Log in", new_session_path, class: "px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white" %>
        <%= link_to "Sign up", new_registration_path, class: "rounded-lg bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800" %>
      <% end %>
    </div>
  </nav>
</header>
