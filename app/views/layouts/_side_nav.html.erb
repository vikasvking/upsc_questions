<aside class="fixed inset-y-0 left-0 z-20 w-64 bg-brand-900 dark:bg-brand-950 text-white flex flex-col justify-between border-r border-brand-950 dark:border-slate-800 transition-colors duration-200">

  <div class="p-6 space-y-8">

    <div class="space-y-4">
      <%# Links dynamically to the proper control hub root based on active roles %>
      <% brand_target_path = Current.user&.student? ? dashboard_path : test_sessions_path %>

      <%= link_to brand_target_path, class: "flex items-center gap-x-3 block group" do %>
        <div class="h-9 w-9 rounded-xl bg-white/10 flex items-center justify-center text-lg font-bold group-hover:bg-white/20 transition-colors">🎓</div>
        <div>
          <h2 class="text-sm font-black tracking-wider uppercase text-white">UPSCOfficer</h2>
          <p class="text-[9px] text-brand-200 font-semibold tracking-widest"><%= { "teacher" => "TEACHER PANEL", "admin" => "ADMIN PANEL" }.fetch(Current.user&.role.to_s, "PREP ENGINE") %></p>
        </div>
      <% end %>

      <!-- Displays Email Address and Role Status Capsule -->
      <% if Current.user %>
        <div class="bg-white/5 rounded-xl p-3 border border-white/10 shadow-inner">
          <p class="text-xs font-semibold text-brand-100 truncate w-full" title="<%= Current.user.email_address %>">
            <%= Current.user.email_address %>
          </p>
          <div class="mt-1.5 flex items-center gap-x-1.5">
            <span class="inline-flex items-center rounded-full bg-white px-2 py-0.5 text-[10px] font-black uppercase tracking-wider text-brand-900">
              <%= Current.user.role.humanize %>
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Navigation Options List Group (Dynamic Active Highlights) -->
    <nav class="space-y-1.5">
      <% if Current.user&.student? %>
        <!-- Student Dashboard Link -->
        <% dashboard_active = current_page?(dashboard_path) ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
        <%= link_to dashboard_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{dashboard_active}" do %>
          <span>📊</span> Dashboard
        <% end %>

        <!-- Student Question Bank Link -->
        <% qbank_active = current_page?(question_bank_path) ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
        <%= link_to question_bank_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{qbank_active}" do %>
          <span>📝</span> Question Bank
        <% end %>

        <!-- Student Enter Exam PIN Link -->
        <% test_join_active = current_page?(join_test_sessions_path) ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
        <%= link_to join_test_sessions_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{test_join_active}" do %>
          <span>🎟️</span> Enter Exam PIN
        <% end %>
      <% end %>

      <% if Current.user&.teacher? || Current.user&.admin? %>
        <!-- Teacher Custom Tests Manager Link -->
        <% test_manager_active = current_page?(test_sessions_path) || current_page?(new_test_session_path) ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
        <%= link_to test_sessions_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{test_manager_active}" do %>
          <span>🔐</span> Manage Custom Tests
        <% end %>

        <!-- Teacher Ingest Questions Form Link -->
        <% upload_active = current_page?(upload_form_questions_path) ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
        <%= link_to upload_form_questions_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{upload_active}" do %>
          <span>📥</span> Ingest Questions
        <% end %>

        <!-- Teacher Manage Question Bank Table Link -->
        <% manage_active = current_page?(questions_path) || (params[:controller] == 'questions' && action_name == 'edit') ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
        <%= link_to questions_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{manage_active}" do %>
          <span>🗂️</span> Manage Question Bank
        <% end %>
      <% end %>

      <!-- Common Profile Link shared across all signed-in users -->
      <% profile_active = current_page?(profile_path) || current_page?(edit_profile_path) ? "bg-white/10 text-white shadow-sm font-bold" : "text-brand-100 hover:bg-white/5 hover:text-white font-semibold" %>
      <%= link_to profile_path, class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm transition-all #{profile_active}" do %>
        <span>👤</span> Profile & Bio
      <% end %>

      <!-- Settings Link Placeholder -->
      <%= link_to "#", class: "flex items-center gap-x-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-brand-100 hover:bg-white/5 hover:text-white transition-all" do %>
        <span>⚙️</span> Settings
      <% end %>
    </nav>
  </div>

  <!-- Footer Action: Theme Toggle & Session Termination -->
  <div class="p-6 border-t border-brand-950 dark:border-slate-900 flex items-center justify-between">
    <div class="flex items-center gap-x-2.5">
      <button id="theme-toggle" class="p-2 rounded-lg text-brand-200 hover:bg-white/5 focus:outline-none cursor-pointer" aria-label="Toggle dark mode">
        <svg id="theme-toggle-sun" class="hidden h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 14.121a1 1 0 010-1.414l.707-.707a1 1 0 111.414 1.414l-.707.707a1 1 0 01-1.414 0zm-9.9-4.242a1 1 0 011.415 0l.707.707a1 1 0 11-1.414 1.414l-.707-.707a1 1 0 010-1.414zm1.414-5.657a1 1 0 000 1.414l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 0z"></path>
        </svg>
        <svg id="theme-toggle-moon" class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
    </div>
    <%= link_to session_path, data: { turbo_method: :delete }, class: "text-xs font-bold text-brand-200 hover:text-white transition-all flex items-center gap-x-1.5 cursor-pointer" do %>
      <span>🚪</span> Log Out
    <% end %>
  </div>

</aside>
