<%
  # [label, path, icon path (24x24 outline)] — shown per role
  icons = {
    home:   "M3 12l9-9 9 9M5 10v10h14V10",
    list:   "M9 6h11M9 12h11M9 18h11M5 6h.01M5 12h.01M5 18h.01",
    book:   "M4 19.5A2.5 2.5 0 016.5 17H20V3H6.5A2.5 2.5 0 004 5.5v14z",
    key:    "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.7 5.7L11 17H9v2H7v2H3v-3.6l6.3-6.3A6 6 0 1121 9z",
    lock:   "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4",
    upload: "M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0-12l-4 4m4-4l4 4",
    plus:   "M12 5v14M5 12h14",
    table:  "M3 10h18M3 14h18M10 3v18M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z",
    user:   "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
    shield: "M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z",
    check:  "M9 12l2 2 4-4M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"
  }
  links =
    if Current.user&.student?
      [["Dashboard", dashboard_path, :home, current_page?(dashboard_path)],
       ["All Tests", all_tests_dashboard_path, :list, current_page?(all_tests_dashboard_path)],
       ["My Tests", my_tests_dashboard_path, :check, controller_name == "dashboards" && action_name.in?(%w[my_tests results])],
       ["Question Bank", question_bank_path, :book, controller_name == "questionbanks"],
       ["Enter PIN", join_test_sessions_path, :key, current_page?(join_test_sessions_path)],
       ["Membership · #{Tiers.label(Current.user.tier)}", membership_path, :user, controller_name == "tiers"]]
    else
      [["Tests", test_sessions_path, :lock, controller_name == "test_sessions"],
       ["Upload Questions", upload_form_questions_path, :upload, current_page?(upload_form_questions_path)],
       ["Add Question", new_question_path, :plus, current_page?(new_question_path)],
       ["Question Bank", questions_path, :table, controller_name == "questions" && !current_page?(new_question_path) && !current_page?(upload_form_questions_path)],
       ["Institutions", institutions_path, :home, controller_name == "institutions"],
       ["Batches", batches_path, :list, controller_name == "batches"],
       ["Reports", question_reports_path, :book, controller_name == "question_reports"],
       ["School plan", payments_path, :user, controller_name == "payments"]]
    end
  links.unshift(["Admin", admin_root_path, :shield, controller_path.start_with?("admin/")]) if Current.user&.staff?
  links << ["Profile", profile_path, :user, controller_name == "profiles"]
  home_path = Current.user&.student? ? dashboard_path : test_sessions_path
%>
<aside id="app-sidebar" aria-label="Main menu"
       class="fixed inset-y-0 left-0 z-40 w-60 overflow-y-auto -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col justify-between">

  <div class="p-4 space-y-6">
    <div class="flex items-center justify-between">
      <%= link_to home_path, class: "flex items-center gap-2.5 px-2 pt-1" do %>
        <span class="h-8 w-8 rounded-lg bg-brand-700 text-white grid place-items-center text-sm font-semibold">R</span>
        <span class="font-semibold text-slate-900 dark:text-white">Rankwise</span>
      <% end %>
      <button type="button" id="sidebar-close" aria-label="Close menu" class="lg:hidden p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <% unless Current.user&.student? %>
      <p class="px-3 text-xs font-medium text-brand-700 dark:text-brand-300"><%= Current.user&.admin? ? "Admin panel" : (Current.user&.sub_admin? ? "Teacher · sub-admin" : "Teacher panel") %></p>
    <% end %>

    <nav class="space-y-0.5">
      <% links.each do |label, path, icon, active| %>
        <%= link_to path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors #{active ? "bg-brand-50 text-brand-800 font-semibold dark:bg-brand-950/60 dark:text-brand-200" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"}",
                    aria: { current: (active ? "page" : nil) } do %>
          <svg class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icons[icon] %>"/></svg>
          <%= label %>
        <% end %>
      <% end %>
    </nav>
  </div>

  <div class="p-4 border-t border-slate-100 dark:border-slate-800 space-y-3">
    <% if Current.user %>
      <div class="flex items-center gap-3 px-1">
        <span class="h-8 w-8 shrink-0 rounded-full bg-brand-100 text-brand-800 dark:bg-brand-900 dark:text-brand-100 grid place-items-center text-xs font-semibold"><%= Current.user.email_address.first.upcase %></span>
        <div class="min-w-0">
          <p class="text-sm font-medium text-slate-900 dark:text-white truncate" title="<%= Current.user.email_address %>"><%= Current.user.email_address %></p>
          <p class="text-xs text-brand-700 dark:text-brand-300"><%= Current.user.role.humanize %></p>
        </div>
      </div>
    <% end %>
    <div class="flex items-center justify-between">
      <button id="theme-toggle" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer" aria-label="Toggle dark mode">
        <svg id="theme-toggle-sun" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.72 0l-.7.7M6.34 17.66l-.7.7M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg id="theme-toggle-moon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.35 15.35A9 9 0 018.65 3.65 9 9 0 1020.35 15.35z"/></svg>
      </button>
      <%= link_to session_path, data: { turbo_method: :delete }, class: "text-sm text-slate-500 hover:text-slate-900 dark:hover:text-white px-2 py-1" do %>Log out<% end %>
    </div>
  </div>
</aside>
