<div class="min-h-[calc(100vh-4rem)] flex flex-col justify-center px-6 py-12">
  <div class="mx-auto w-full max-w-sm">
    <div class="text-center">
      <a href="<%= root_path %>" class="inline-grid h-10 w-10 place-items-center rounded-xl bg-brand-700 text-white font-semibold">R</a>
      <h1 class="mt-5 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Forgot your password?</h1>
      <p class="mt-2 text-sm text-slate-500">Enter your email and we'll send you a link to set a new one.</p>
    </div>

    <div class="mt-8 rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-slate-200/70 dark:ring-slate-800 shadow-sm px-6 py-7">
      <% if alert = flash[:alert] %>
        <div id="alert" class="mb-5 rounded-lg bg-red-50 dark:bg-red-950/40 px-3 py-2.5 text-sm text-red-800 dark:text-red-300 ring-1 ring-red-200 dark:ring-red-900/50"><%= alert %></div>
      <% end %>

      <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-1.5 block w-full rounded-lg border-0 py-2.5 px-3 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-600 bg-white dark:bg-slate-950 text-slate-900 dark:text-white" %>
        </div>
        <%= form.submit "Email me a reset link", class: "w-full rounded-lg bg-brand-700 px-3 py-2.5 text-sm font-medium text-white hover:bg-brand-800 cursor-pointer" %>
      <% end %>

      <p class="mt-6 text-center text-sm text-slate-500"><%= link_to "Back to log in", new_session_path, class: "font-medium text-brand-700 dark:text-brand-300 hover:underline" %></p>
    </div>
  </div>
</div>
