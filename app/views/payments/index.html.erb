<% content_for :title, "School plan · Rankwise" %>
<% card = "bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-6" %>
<div class="py-10 min-h-screen w-full">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">School plan</h1>
      <p class="text-sm text-slate-500 mt-1">A plan lets your school or coaching publish school tests and makes all its students Plus.</p>
    </div>

    <% if notice %>
      <p class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300"><%= alert %></p>
    <% end %>

    <% if Current.user.admin? %>
      <p class="<%= card %> text-sm text-slate-600 dark:text-slate-300">Admins set school plans on <%= link_to "Admin → Schools & coachings", admin_institutions_path, class: "font-medium text-brand-700 dark:text-brand-300 underline" %> and check payments on <%= link_to "Admin → Payments", admin_payments_path, class: "font-medium text-brand-700 dark:text-brand-300 underline" %>.</p>
    <% elsif @schools.empty? %>
      <p class="<%= card %> text-sm text-slate-600 dark:text-slate-300">You are not part of a school or coaching yet. <%= link_to "Create or join one", institutions_path, class: "font-medium text-brand-700 dark:text-brand-300 underline" %>, then come back to pay for its plan.</p>
    <% end %>

    <% @schools.each do |school| %>
      <section class="<%= card %> space-y-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-semibold text-slate-900 dark:text-white"><%= school.label %></h2>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            <%= school.plan&.name || "No plan" %> · <%= school.subscription_label %><%= " until #{l(school.subscription_renews_on, format: :long)}" if school.subscribed? && school.subscription_renews_on %>
          </p>
        </div>
        <div class="grid sm:grid-cols-3 gap-3">
          <% @plans.each do |plan| %>
            <div class="rounded-xl ring-1 <%= school.plan_id == plan.id ? "ring-2 ring-brand-600" : "ring-slate-200 dark:ring-slate-800" %> p-4 space-y-2">
              <p class="font-semibold text-slate-900 dark:text-white"><%= plan.name %><%= " · current" if school.plan_id == plan.id && school.subscribed? %></p>
              <p class="text-xs text-slate-500"><%= plan.limits_text %></p>
              <div class="flex gap-2 pt-1">
                <%= link_to "#{rupees(plan.price_month_inr)}/month", new_payment_path(plan_id: plan.id, period: "month", institution_id: school.id),
                      class: "flex-1 rounded-lg bg-brand-700 hover:bg-brand-800 px-2 py-2 text-center text-xs font-semibold text-white" %>
                <%= link_to "#{rupees(plan.price_year_inr)}/year", new_payment_path(plan_id: plan.id, period: "year", institution_id: school.id),
                      class: "flex-1 rounded-lg ring-1 ring-brand-300 dark:ring-brand-700 px-2 py-2 text-center text-xs font-semibold text-brand-800 dark:text-brand-200" %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%= render "payments/history", payments: @payments %>
  </div>
</div>
