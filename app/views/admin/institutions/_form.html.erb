<% input = "mt-1 block w-full rounded-xl border-0 py-2.5 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white" %>
<%= render "admin/shared/errors", record: @institution %>
<%= form_with model: [:admin, @institution], class: "bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-6 grid grid-cols-1 sm:grid-cols-3 gap-4 items-end" do |f| %>
  <div><%= f.label :name, "Name", class: "text-xs font-bold text-slate-500" %><%= f.text_field :name, required: true, class: input %></div>
  <div><%= f.label :kind, "Type", class: "text-xs font-bold text-slate-500" %><%= f.select :kind, [["Coaching", "coaching"], ["School", "school"]], {}, class: input %></div>
  <div><%= f.label :city, "City", class: "text-xs font-bold text-slate-500" %><%= f.text_field :city, class: input %></div>
  <div class="sm:col-span-3 flex gap-3">
    <%= link_to "Cancel", admin_institutions_path, class: "flex-1 text-center rounded-xl px-4 py-2.5 text-sm ring-1 ring-slate-200 dark:ring-slate-800 text-slate-600 dark:text-slate-300" %>
    <%= f.submit (@institution.persisted? ? "Save" : "Add"), class: "flex-1 rounded-xl bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2.5 cursor-pointer" %>
  </div>
<% end %>
