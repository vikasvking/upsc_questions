<div class="py-8 sm:py-10">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-6">
    <%= render "admin/shared/header", title: "Edit #{@user.email_address}" %>
    <%= render "admin/users/form", user: @user %>

    <% unless @user == Current.user %>
      <% has_results = @user.test_attempts.exists? || @user.user_responses.exists? %>
      <section class="rounded-2xl ring-1 ring-red-200 dark:ring-red-900/60 bg-red-50/40 dark:bg-red-950/20 p-6 space-y-3">
        <h2 class="font-semibold text-red-800 dark:text-red-300">Delete this account</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          <% if @user.faculty? %>
            Their <%= pluralize(@user.test_sessions.count, "test") %> and <%= pluralize(@user.questions.count, "question") %> are kept; tests then show their exam's name instead of the teacher.
          <% end %>
          <% if has_results %>
            This also deletes their <%= pluralize(@user.user_responses.count, "saved answer") %> and <%= pluralize(@user.test_attempts.count, "test result") %>.
          <% end %>
        </p>
        <%= form_with url: admin_user_path(@user), method: :delete, class: "flex flex-col sm:flex-row gap-2",
              data: { turbo_confirm: "Delete #{@user.email_address}? This cannot be undone." } do %>
          <% if has_results %>
            <%= text_field_tag :confirm_text, nil, placeholder: "Type #{@user.email_address}", autocomplete: "off",
                  class: "flex-1 rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-red-200 dark:ring-red-900 text-sm" %>
          <% end %>
          <%= text_field_tag :reason, nil, placeholder: "Reason (optional)", class: "flex-1 rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm" %>
          <%= submit_tag "Delete account", name: nil, class: "rounded-xl bg-red-700 hover:bg-red-800 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
