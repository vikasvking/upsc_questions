<%# locals: title, subtitle (optional), action (optional html for the right side) %>
<%
  me = Current.user
  tabs = [["Overview", admin_root_path, controller_name == "dashboard", true],
          ["People", admin_users_path, controller_name == "users", me.admin? || me.can_manage?(:students) || me.can_manage?(:teachers)],
          ["Schools & coachings", admin_institutions_path, controller_name == "institutions", me.can_manage?(:institutions)],
          ["Questions", admin_questions_path, controller_name == "questions", me.can_manage?(:questions)],
          ["Tests", admin_test_sessions_path, controller_name == "test_sessions", me.can_manage?(:tests)],
          ["Ratings & reports", admin_moderation_index_path, controller_name == "moderation", me.can_manage?(:ratings)],
          ["Email", edit_admin_mail_settings_path, controller_name == "mail_settings", me.admin?],
          ["Admin log", admin_logs_path, controller_name == "logs", me.admin?]].select(&:last)
%>
<div class="space-y-5">
  <nav class="flex flex-wrap gap-1 border-b border-slate-200 dark:border-slate-800 pb-3" aria-label="Admin sections">
    <% tabs.each do |label, path, active, _| %>
      <%= link_to label, path, class: "rounded-lg px-3 py-1.5 text-sm #{active ? "bg-brand-50 text-brand-800 font-semibold dark:bg-brand-950/60 dark:text-brand-200" : "text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"}" %>
    <% end %>
  </nav>

  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= title %></h1>
      <% if local_assigns[:subtitle] %><p class="text-sm text-slate-500 mt-1"><%= subtitle %></p><% end %>
    </div>
    <%= local_assigns[:action] %>
  </div>

  <% if notice %>
    <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 px-4 py-3 ring-1 ring-emerald-200 dark:ring-emerald-900/40 text-sm text-emerald-800 dark:text-emerald-300"><%= notice %></div>
  <% end %>
  <% if alert %>
    <div class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 ring-1 ring-red-200 dark:ring-red-900/40 text-sm text-red-800 dark:text-red-300"><%= alert %></div>
  <% end %>
</div>
