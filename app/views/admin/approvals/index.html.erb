<% card = "bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-5 space-y-3" %>
<div class="py-8 sm:py-10">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-6">
    <%= render "admin/shared/header", title: "Approvals",
          subtitle: @institutions ? "New teachers and join requests at #{@institutions.map(&:name).to_sentence.presence || "your schools/coachings (you have none yet)"}." : "All new teachers and join requests." %>

    <section class="<%= card %>">
      <h2 class="font-semibold text-slate-900 dark:text-white">New teacher accounts (<%= @pending_teachers.size %>)</h2>
      <% if @pending_teachers.any? %>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
          <% @pending_teachers.each do |t| %>
            <li class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="font-medium text-slate-900 dark:text-white"><%= t.display_name %> <span class="text-xs text-slate-500"><%= t.email_address %></span></p>
                <p class="text-xs text-slate-500"><%= t.subject_names.join(", ").presence || "No subjects given" %> · signed up <%= time_ago_in_words(t.created_at) %> ago</p>
                <p class="text-xs text-slate-500"><%= t.memberships.map { |m| "#{m.institution.name}#{" (asked to join)" if m.pending?}" }.join(" · ").presence || "No school/coaching" %></p>
                <% if t.bio.present? %><p class="text-xs text-slate-600 dark:text-slate-300 mt-1"><%= t.bio.truncate(200) %></p><% end %>
              </div>
              <%= button_to "Approve teacher", approve_teacher_admin_approval_path(t), method: :patch,
                    class: "shrink-0 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold px-3 py-1.5 cursor-pointer" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-500">No new teachers waiting.</p>
      <% end %>
    </section>

    <section class="<%= card %>">
      <h2 class="font-semibold text-slate-900 dark:text-white">Join requests (<%= @requests.size %>)</h2>
      <% if @requests.any? %>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
          <% @requests.each do |m| %>
            <li class="py-2.5 flex items-center justify-between gap-3">
              <span class="min-w-0"><span class="font-medium text-slate-900 dark:text-white"><%= m.user.display_name %></span>
                <span class="text-xs text-slate-500"><%= m.user.role %> → <%= m.institution.name %> · <%= time_ago_in_words(m.created_at) %> ago</span></span>
              <span class="flex shrink-0 gap-2">
                <%= button_to "Approve", approve_membership_path(m), method: :patch, class: "rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold px-3 py-1.5 cursor-pointer" %>
                <%= button_to "Reject", membership_path(m), method: :delete, class: "rounded-lg ring-1 ring-slate-200 dark:ring-slate-800 text-xs px-3 py-1.5 text-slate-600 dark:text-slate-300 cursor-pointer" %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-500">No join requests waiting.</p>
      <% end %>
    </section>
  </div>
</div>
