<div class="py-8 sm:py-10">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-6">
    <%= render "admin/shared/header", title: "Edit question",
          subtitle: "Added by #{@question.user&.email_address || "a deleted teacher"} · in #{pluralize(@question.test_sessions.size, "test")} · #{pluralize(@question.user_responses.count, "saved answer")}" %>
    <%= render "admin/questions/form", question: @question, locked_tests: @locked_tests %>

    <% if Current.user.admin? %>
    <% needs_confirm = @locked_tests.any? || @question.user_responses.exists? %>
    <section class="rounded-2xl ring-1 ring-red-200 dark:ring-red-900/60 bg-red-50/40 dark:bg-red-950/20 p-6 space-y-3">
      <h2 class="font-semibold text-red-800 dark:text-red-300">Delete this question</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400">It is removed from every test that uses it<%= needs_confirm ? ", and all saved answers to it are deleted (marks and ranks change)" : "" %>.</p>
      <%= form_with url: admin_question_path(@question), method: :delete, class: "flex flex-col sm:flex-row gap-2",
            data: { turbo_confirm: "Delete this question? This cannot be undone." } do %>
        <% if needs_confirm %>
          <%= text_field_tag :confirm_text, nil, placeholder: "Type delete", autocomplete: "off",
                class: "sm:w-40 rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-red-200 dark:ring-red-900 text-sm" %>
        <% end %>
        <%= text_field_tag :reason, nil, placeholder: needs_confirm ? "Reason (required)" : "Reason (optional)",
              class: "flex-1 rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm" %>
        <%= submit_tag "Delete question", name: nil, class: "rounded-xl bg-red-700 hover:bg-red-800 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
      <% end %>
    </section>
    <% end %>
  </div>
</div>
