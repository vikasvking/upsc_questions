<% sel = "rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white" %>
<div class="py-8 sm:py-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-6">
    <%= render "admin/shared/header", title: "Tests", subtitle: "Every teacher's tests. Locked tests can be changed here on a teacher's request, with a reason.",
          action: link_to("+ New test", new_admin_test_session_path, class: "rounded-lg bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2") %>

    <%= render "shared/exam_tabs", counts: @exam_counts, current: @exam %>

    <%= form_with url: admin_test_sessions_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-4 gap-2" do %>
      <%= hidden_field_tag :exam, @exam || "all", id: nil %>
      <%= hidden_field_tag :per, @per_page, id: nil %>
      <%= search_field_tag :q, params[:q], placeholder: "Search title…", class: "sm:col-span-2 #{sel}" %>
      <%= select_tag :kind, options_for_select([["🟢 Open", "open"], ["🔐 PIN", "pin"], ["🛡️ Strict", "strict"], ["⏰ Scheduled", "scheduled"], ["🎁 Free samples", "free"]], @kind), include_blank: "All types", class: sel %>
      <div class="flex gap-2">
        <%= select_tag :teacher, options_for_select([["Deleted teachers", "none"]] + @teachers.map { |t| [t.email_address, t.id] }, @teacher), include_blank: "All teachers", class: "flex-1 min-w-0 #{sel}" %>
        <%= submit_tag "Filter", name: nil, class: "rounded-xl bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold px-4 cursor-pointer" %>
      </div>
    <% end %>

    <p class="text-sm text-slate-600 dark:text-slate-300">
      🎁 <strong><%= @free_count %> of <%= Tiers::FREE_SAMPLE_TESTS %></strong> free sample tests chosen
      · <%= link_to "Show them", admin_test_sessions_path(kind: "free"), class: "text-pink-700 dark:text-pink-300 font-medium hover:underline" %>
      <% if Current.user.admin? %><span class="text-xs text-slate-500">· Use 🎁 Gift on a test to add it (tests must be visible to everyone).</span><% end %>
    </p>

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
      <% if @tests.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[1050px] table-fixed text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-950/70 dark:text-slate-400">
              <tr>
                <th scope="col" class="w-[28%] px-4 py-3 font-semibold">Test</th>
                <th scope="col" class="w-[18%] px-4 py-3 font-semibold">Teacher</th>
                <th scope="col" class="w-[16%] px-4 py-3 font-semibold">Setup</th>
                <th scope="col" class="w-[18%] px-4 py-3 font-semibold">Schedule / access</th>
                <th scope="col" class="w-[12%] px-4 py-3 font-semibold">Activity</th>
                <th scope="col" class="w-[8%] px-4 py-3 text-right font-semibold">Manage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% @tests.each do |t| %>
                <% label, label_class = window_badge_for(t) %>
                <tr class="align-top transition-colors hover:bg-slate-50/80 dark:hover:bg-slate-800/40 <%= style_for_test(t)[:stripe] %>">
                  <td class="px-4 py-4">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <%= exam_chip(t.exam_type) %>
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= label_class %>"><%= label %></span>
                      <% if t.free_sample? %><span class="rounded-full bg-pink-50 px-2 py-0.5 text-xs font-medium text-pink-700 dark:bg-pink-950/40 dark:text-pink-300">🎁 Sample</span><% end %>
                      <% if t.editing_locked? %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">🔒 Locked</span><% end %>
                    </div>
                    <p class="mt-2 truncate font-semibold text-slate-900 dark:text-white" title="<%= t.title %>"><%= t.title %></p>
                    <div class="mt-1"><%= audience_chip(t) %></div>
                  </td>
                  <td class="px-4 py-4">
                    <p class="break-all text-slate-800 dark:text-slate-200"><%= t.user&.email_address || "#{exam_name(t.exam_type)} (deleted)" %></p>
                    <% if t.institution %><p class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= t.institution.name %></p><% end %>
                  </td>
                  <td class="px-4 py-4 text-slate-600 dark:text-slate-300">
                    <p><%= pluralize(@question_counts[t.id].to_i, "question") %></p>
                    <p class="mt-1"><%= t.duration_minutes %> min · pass at <%= t.pass_mark_percentage %>%</p>
                    <p class="mt-1"><%= kind_badge_for(t) %></p>
                  </td>
                  <td class="px-4 py-4 text-slate-600 dark:text-slate-300">
                    <% if t.starts_at || t.ends_at %>
                      <p><span class="text-slate-400">From</span> <%= t.starts_at ? l(t.starts_at, format: :short) : "Now" %></p>
                      <p class="mt-1"><span class="text-slate-400">Until</span> <%= t.ends_at ? l(t.ends_at, format: :short) : "No end" %></p>
                    <% else %>
                      <p>Available anytime</p>
                    <% end %>
                    <% if t.pin_required? %><p class="mt-1 font-mono text-xs">PIN <%= t.pin_code %></p><% end %>
                    <% if t.strict_mode? %><p class="mt-1 text-xs font-medium text-amber-700 dark:text-amber-300">Strict mode</p><% end %>
                  </td>
                  <td class="px-4 py-4 tabular-nums text-slate-600 dark:text-slate-300">
                    <p><span class="font-semibold text-slate-900 dark:text-white"><%= @attempt_counts[t.id].to_i %></span> attempts</p>
                    <% if @blocked_counts[t.id].to_i.positive? %>
                      <p class="mt-1 font-semibold text-red-700 dark:text-red-400"><%= @blocked_counts[t.id] %> blocked</p>
                    <% else %>
                      <p class="mt-1 text-xs text-slate-400">No blocked students</p>
                    <% end %>
                  </td>
                  <td class="px-4 py-4">
                    <div class="flex flex-col items-end gap-2 whitespace-nowrap text-xs font-semibold">
                      <%= link_to "Results / live", test_session_path(t), class: "text-brand-700 hover:underline dark:text-brand-300" %>
                      <%= link_to (t.editing_locked? ? "Edit override" : "Edit test"), edit_admin_test_session_path(t), class: "text-slate-600 hover:underline dark:text-slate-300" %>
                      <% if Current.user.admin? %>
                        <%= button_to (t.free_sample? ? "Remove sample" : "🎁 Make sample"), toggle_gift_admin_test_session_path(t), method: :patch,
                              form_class: "inline", class: "cursor-pointer text-pink-700 hover:underline dark:text-pink-300" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="px-6 py-12 text-center text-sm text-slate-500">No tests match<%= " in #{exam_name(@exam)}" if @exam %>.</p>
      <% end %>
    </div>
    <%= render "shared/list_pager", total: (@exam ? @exam_counts[@exam] : @exam_counts.values.sum), noun: "test" %>
  </div>
</div>
