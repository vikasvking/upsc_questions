<div class="py-8 sm:py-10">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-6">
    <%= render "admin/shared/header", title: "Messages",
          subtitle: "Sent from the contact form on the home page. Each one is also emailed to every admin; reply from your email, then mark it done." %>

    <% unless Mailing.enabled? %>
      <p class="rounded-xl bg-amber-50 dark:bg-amber-950/40 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
        Email is off, so the contact form is hidden on the home page. <%= link_to "Turn email on", edit_admin_mail_settings_path, class: "font-medium underline" %> to open it.
      </p>
    <% end %>

    <div class="flex gap-2 text-sm">
      <% [["new", "New"], ["done", "Done"], ["all", "All"]].each do |value, label| %>
        <% count = value == "all" ? @counts.values.sum : @counts[value].to_i %>
        <%= link_to "#{label} (#{count})", admin_contact_messages_path(status: value),
              class: "rounded-full px-3 py-1 font-medium #{@status == value ? "bg-brand-700 text-white" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"}" %>
      <% end %>
    </div>

    <ul class="space-y-3">
      <% @messages.each do |m| %>
        <li class="bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-5 space-y-2 <%= "opacity-70" if m.done? %>">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <p class="font-semibold text-slate-900 dark:text-white"><%= m.name %>
                <span class="ml-1 inline-flex rounded-full bg-brand-50 dark:bg-brand-950/60 px-2 py-0.5 text-xs font-medium text-brand-800 dark:text-brand-200"><%= m.topic_label %></span>
              </p>
              <p class="text-xs text-slate-500">
                <%= mail_to m.email, m.email, subject: "Re: Rankwise – #{m.topic_label}", class: "text-brand-700 dark:text-brand-300 hover:underline" %>
                <% if m.phone %> · <%= m.phone %><% end %>
                <% if m.organisation %> · <%= m.organisation %><% end %>
                · <%= time_ago_in_words(m.created_at) %> ago
              </p>
            </div>
            <% if m.done? %>
              <%= button_to "Move back to new", admin_contact_message_path(m, status: "new"), method: :patch, class: "text-xs text-slate-600 dark:text-slate-300 cursor-pointer hover:underline" %>
            <% else %>
              <%= button_to "Mark done", admin_contact_message_path(m, status: "done"), method: :patch, class: "rounded-lg bg-brand-700 hover:bg-brand-800 text-white text-xs font-semibold px-3 py-1.5 cursor-pointer" %>
            <% end %>
          </div>
          <p class="text-sm text-slate-800 dark:text-slate-200 whitespace-pre-line"><%= m.message %></p>
          <% if m.done? %>
            <p class="text-xs text-slate-500">Done<%= " by #{m.handled_by.display_name}" if m.handled_by %><%= " · #{time_ago_in_words(m.handled_at)} ago" if m.handled_at %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @messages.empty? %><p class="text-sm text-slate-500 py-6 text-center">No <%= @status == "all" ? "" : "#{ContactMessage::STATUSES[@status].downcase} " %>messages.</p><% end %>
    <%= render "admin/shared/pager" %>
  </div>
</div>
