<%# locals: kind ("test" or "teacher"), id, rating (the student's existing rating or nil), title %>
<% chosen = rating&.stars %>
<div class="rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 bg-white dark:bg-slate-900 p-5 space-y-3">
  <p class="font-semibold text-slate-900 dark:text-white"><%= title %></p>
  <%= form_with url: ratings_path, class: "space-y-3" do %>
    <%= hidden_field_tag :rateable, kind, id: nil %>
    <%= hidden_field_tag :rateable_id, id, id: nil %>
    <div class="flex flex-row-reverse justify-end gap-1 text-3xl" role="radiogroup" aria-label="Stars">
      <%# reversed so :checked ~ label colours the chosen star and all before it %>
      <% 5.downto(1) do |n| %>
        <input type="radio" name="rating[stars]" value="<%= n %>" id="<%= kind %>_<%= id %>_star_<%= n %>" class="peer sr-only" <%= "checked" if chosen == n %> required>
        <label for="<%= kind %>_<%= id %>_star_<%= n %>" title="<%= pluralize(n, "star") %>"
               class="cursor-pointer text-slate-300 dark:text-slate-700 hover:text-amber-400 peer-checked:text-amber-500 [&:hover~label]:text-amber-400">★</label>
      <% end %>
    </div>
    <%= text_area_tag "rating[comment]", rating&.comment, rows: 2, maxlength: 500, placeholder: "Comment (optional)",
          class: "block w-full rounded-xl border-0 py-2 px-3 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 bg-white dark:bg-slate-950 text-sm text-slate-900 dark:text-white" %>
    <div class="flex items-center gap-3">
      <%= submit_tag (rating ? "Update my rating" : "Submit rating"), name: nil, class: "rounded-lg bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2 cursor-pointer" %>
      <% if rating&.comment_hidden_at %><span class="text-xs text-red-700 dark:text-red-400">Your comment was hidden by an admin.</span><% end %>
    </div>
  <% end %>
  <% if rating %>
    <%= button_to "Remove my rating", rating_path(rating), method: :delete, class: "text-xs text-slate-500 hover:text-red-700 cursor-pointer" %>
  <% end %>
</div>
