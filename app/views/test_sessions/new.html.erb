<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div>
      <%= link_to "← Back to Tests", test_sessions_path, class: "text-xs font-bold text-brand-800 dark:text-brand-400 hover:underline" %>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-white sm:text-3xl mt-2">Create Test</h1>
      <p class="text-sm text-slate-500 mt-1">Set the rules, choose who can take it and when, then pick the questions.</p>
    </div>

    <% if flash[:alert] %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50">
        <p class="text-xs font-bold text-red-800 dark:text-red-400 flex items-center gap-x-2"><span>✗</span> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with model: @test_session, class: "space-y-8" do |f| %>
      <%= render "test_sessions/edit_partials/settings_form", f: f %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <%= render "test_sessions/edit_partials/active_blueprint" %>
        <%= render "test_sessions/edit_partials/master_library" %>
      </div>

      <div class="flex gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
        <%= link_to "Discard", test_sessions_path, class: "flex-1 text-center font-bold text-xs border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-950 px-4 py-3 rounded-xl hover:bg-slate-100 transition-colors shadow-sm" %>
        <%= f.submit "Create Test", class: "flex-1 justify-center rounded-xl bg-brand-800 dark:bg-brand-700 px-4 py-3 text-xs font-bold text-white shadow-sm hover:bg-brand-900 dark:hover:bg-brand-600 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<%= render "test_sessions/edit_partials/search_script" %>
