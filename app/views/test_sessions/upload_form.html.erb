<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-2xl px-4 space-y-8">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <h1 class="text-2xl font-black text-slate-900 dark:text-white">Bulk Test Spreadsheet Ingestion</h1>
      <p class="text-sm text-slate-500 mt-1">Generate entire exam sessions and populate their question lists at once from an Excel file.</p>
    </div>

    <div class="bg-rose-50/50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40 rounded-xl p-4 flex justify-between items-center gap-3 shadow-sm">
      <div class="flex items-center gap-x-3">
        <span class="text-xl">📋</span>
        <p class="text-xs font-bold text-slate-900 dark:text-white">Download our custom layout format first before uploading.</p>
      </div>
      <%= link_to "Download Template File 📥", download_template_test_sessions_path, class: "text-xs font-black text-white bg-rose-800 hover:bg-rose-900 px-3.5 py-2 rounded-xl text-center" %>
    </div>

    <div class="bg-slate-50 dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800">
      <%= form_with url: import_test_sessions_path, multipart: true, local: true, class: "space-y-6" do |form| %>
        <div class="mt-2 flex justify-center rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 px-6 py-10 bg-white dark:bg-slate-950/30 relative group">
          <div class="text-center space-y-2">
            <div class="text-3xl">📊</div>
            <span class="relative text-xs font-bold text-rose-800 dark:text-rose-400 cursor-pointer block">Attach Custom Test Template File (.xls)</span>
            <%= form.file_field :file, accept: '.xls', required: true, id: "excel-uploader-input", class: "absolute inset-0 opacity-0 cursor-pointer w-full h-full" %>
          </div>
        </div>
        <p id="file-name-indicator" class="mt-3 text-xs font-mono font-bold text-rose-800 dark:text-rose-400 hidden bg-white p-2 rounded border"></p>

        <div class="flex gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <%= link_to "Cancel", test_sessions_path, class: "flex-1 text-center font-bold text-xs border border-slate-200 text-slate-600 bg-white px-4 py-3 rounded-xl shadow-sm" %>
          <%= form.submit "Execute Test Sheet Ingestion 🚀", class: "flex-1 justify-center rounded-xl bg-rose-800 px-4 py-3 text-xs font-bold text-white cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
