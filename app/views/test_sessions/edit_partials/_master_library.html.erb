<% included_ids = @test_session.question_ids.to_set %>
<div class="space-y-4 bg-slate-50/50 dark:bg-slate-900/50 p-5 rounded-2xl border border-slate-200 dark:border-slate-800">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold text-slate-900 dark:text-white">Question Library</h3>
      <p class="text-xs text-slate-400">Tick a question to move it into the test.</p>
    </div>
    <input type="text" id="library-search-field" placeholder="🔍 Search library..." class="rounded-xl border border-slate-200 dark:border-slate-800 text-xs py-1.5 px-3 bg-white dark:bg-slate-950 text-slate-900 dark:text-white w-full sm:w-48 shadow-sm focus:ring-2 focus:ring-brand-800" />
  </div>

  <div id="master-library-container" class="space-y-3 max-h-[500px] overflow-y-auto pr-2">
    <% @questions.each do |q| %>
      <% next if included_ids.include?(q.id) %>
      <label class="library-row-item flex items-start gap-4 p-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 cursor-pointer hover:border-brand-800/40 transition-colors">
        <div class="mt-1">
          <%= check_box_tag "test_session[question_ids][]", q.id, false, id: "library_q_#{q.id}", class: "question-checkbox library-repository-checkbox accent-brand-800 h-4 w-4 rounded" %>
        </div>
        <div class="space-y-1.5 flex-1">
          <div class="flex items-center gap-x-2 flex-wrap gap-y-1">
            <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"><%= exam_name(q.exam_type) %></span>
            <span class="inline-block px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 filter-topic-token"><%= q.topic %></span>
            <span class="text-xs font-bold font-mono text-slate-400 ml-auto"><%= q.year %></span>
          </div>
          <p class="text-xs font-semibold text-slate-900 dark:text-white leading-relaxed filter-content-token"><%= q.content %></p>
        </div>
      </label>
    <% end %>
  </div>
</div>
