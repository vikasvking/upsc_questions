<div class="space-y-4 bg-rose-50/20 dark:bg-rose-950/10 p-5 rounded-2xl border border-rose-100 dark:border-rose-900/30">
  <div>
    <h3 class="text-base font-extrabold text-rose-900 dark:text-rose-400 flex items-center gap-x-2">
      <span>📋</span> Active Paper Blueprint (<span id="active-selected-counter"><%= @test_session.questions.count %></span> Selected)
    </h3>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">These questions are currently part of this test paper. Uncheck a box to remove it.</p>
  </div>

  <div id="active-questions-container" class="space-y-3 max-h-[500px] overflow-y-auto pr-2 scrollbar-thin">
    <% @test_session.questions.each do |q| %>
      <label class="flex items-start gap-4 p-4 rounded-xl bg-white dark:bg-slate-900 border border-rose-200/60 dark:border-rose-900/40 cursor-pointer block hover:bg-slate-50/50 transition-colors">
        <div class="mt-1">
          <!-- 🚀 FIX: Name changed to native Rails standard format test_session[question_ids][] -->
          <%= check_box_tag "test_session[question_ids][]", q.id.to_s, true, class: "accent-rose-800 h-4 w-4 rounded" %>
        </div>
        <div class="space-y-1.5 flex-1">
          <div class="flex items-center gap-x-2 flex-wrap gap-y-1">
            <span class="inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-400"><%= q.exam_type %></span>
            <span class="inline-block px-2 py-0.5 rounded-full text-[9px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"><%= q.topic %></span>
            <span class="text-[10px] font-bold font-mono text-slate-400 ml-auto">Q.No <%= q.q_no %></span>
          </div>
          <p class="text-xs font-semibold text-slate-900 dark:text-white leading-relaxed"><%= q.content %></p>
        </div>
      </label>
    <% end %>
  </div>
</div>
