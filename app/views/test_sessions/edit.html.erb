<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div>
      <%= link_to "← Back to Tests", test_sessions_path, class: "text-[10px] font-bold uppercase tracking-wider text-brand-800 dark:text-brand-400 hover:underline" %>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white sm:text-3xl mt-2">Edit Test</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Change the rules, access, time window or questions.</p>
    </div>

    <% if flash[:alert] %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50">
        <p class="text-xs font-bold text-red-800 dark:text-red-400 flex items-center gap-x-2"><span>✗</span> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with model: @test_session, class: "space-y-8" do |f| %>
      <%= render "test_sessions/edit_partials/settings_form", f: f %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <%= render "test_sessions/edit_partials/active_blueprint" %>
        <%= render "test_sessions/edit_partials/master_library" %>
      </div>

      <%= render "test_sessions/edit_partials/form_footer", f: f %>
    <% end %>
  </div>
</div>

<%= render "test_sessions/edit_partials/search_script" %>
