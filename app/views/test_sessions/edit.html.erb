<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Header Summary Block Layout Component -->
    <div>
      <%= link_to "← Back to Test Manager", test_sessions_path, class: "text-[10px] font-bold uppercase tracking-wider text-rose-800 dark:text-rose-400 hover:underline" %>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white sm:text-3xl mt-2">Edit Test Paper Matrix</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Reconfigure time limits, passing thresholds, or modify hand-picked question sheets.</p>
    </div>

    <!-- Active Error Notification Display Banner -->
    <% if flash[:alert] %>
      <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 p-4 border border-rose-200 dark:border-rose-900/50">
        <p class="text-xs font-bold text-rose-800 dark:text-rose-400 flex items-center gap-x-2"><span>✗</span> <%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with model: @test_session, method: :patch, local: true, class: "space-y-8" do |f| %>

      <!-- Module 1: Core Parameters Settings Panel Component -->
      <%= render "test_sessions/edit_partials/settings_form", f: f %>

      <!-- Module 2: Dual Column Interactive Selection Split Grid Panel -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

        <!-- Left Sub-Module: Active Included Questions -->
        <%= render "test_sessions/edit_partials/active_blueprint" %>

        <!-- Right Sub-Module: Master Questions Repository -->
        <%= render "test_sessions/edit_partials/master_library" %>

      </div>

      <!-- Module 3: Form Button Controls Action Bar Row Footer -->
      <%= render "test_sessions/edit_partials/form_footer", f: f %>

    <% end %>
  </div>
</div>

<!-- Module 4: Client-Side Instant Live Search & Counter Tracking Engine -->
<%= render "test_sessions/edit_partials/search_script" %>
