<div class="py-16 min-h-screen flex items-center justify-center w-full">
  <div class="mx-auto max-w-sm px-6 text-center space-y-6">
    <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-950/40 border border-brand-200 dark:border-brand-900/40 text-xl shadow-sm">🎟️</div>

    <div>
      <h1 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Enter Examination PIN</h1>
      <p class="text-xs text-slate-500 mt-0.5">Input the 6-character access passcode distributed by your instructor to unlock your paper parameters.</p>
    </div>

    <!-- Active Error Notice Display Banner -->
    <% if flash[:alert] %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-3 border border-red-200 dark:border-red-900/40 text-xs text-red-800 font-bold">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: verify_pin_test_sessions_path, method: :post, local: true, class: "space-y-4" do %>
      <%= text_field_tag :pin_code, nil, placeholder: "e.g., GH8X2W", required: true, class: "block w-full rounded-xl border-0 py-3 px-4 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-800 font-mono text-center font-black uppercase text-base tracking-widest" %>
      <%= submit_tag "Authenticate and Enter Paper →", class: "w-full text-center font-bold text-xs bg-brand-800 hover:bg-brand-900 text-white py-3 rounded-xl transition-all shadow-sm cursor-pointer" %>
    <% end %>
  </div>
</div>
