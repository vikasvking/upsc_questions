<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <%= link_to "← Back to Tests", test_sessions_path, class: "text-[10px] font-bold uppercase tracking-wider text-brand-800 dark:text-brand-400 hover:underline" %>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white sm:text-3xl mt-1"><%= @test_session.title %> · Results</h1>
      <p class="text-sm text-slate-500 mt-0.5">
        <% if @test_session.pin_required? %>
          PIN: <span class="font-mono font-bold text-brand-800 bg-brand-50 dark:bg-brand-950/40 px-2 py-0.5 rounded-md select-all"><%= @test_session.pin_code %></span>
        <% else %>
          Open test (no PIN)
        <% end %>
        · Pass mark <%= @test_session.pass_mark_percentage %>%
        <% if @in_progress_count.positive? %> · <%= @in_progress_count %> student(s) still writing<% end %>
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div class="bg-slate-50 dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-center min-h-[110px]">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Submitted</p>
        <p class="text-3xl font-black text-slate-900 dark:text-white mt-1"><%= @total_participants %> students</p>
      </div>
      <div class="bg-slate-50 dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-center min-h-[110px]">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Class Average</p>
        <p class="text-3xl font-black text-brand-800 dark:text-brand-400 mt-1"><%= @class_average_pct %>%</p>
      </div>
      <div class="bg-slate-50 dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-center min-h-[110px]">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">🏆 Top Score</p>
        <p class="text-xs font-black text-emerald-600 dark:text-emerald-400 mt-2 truncate max-w-xs mx-auto" title="<%= @topper_email %>"><%= @topper_email %></p>
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-base font-extrabold text-slate-900 dark:text-white">Rankings</h3>
      <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm bg-white dark:bg-slate-900">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950 font-bold text-slate-900 dark:text-slate-300">
            <tr>
              <th class="px-6 py-3.5">Rank</th>
              <th class="px-6 py-3.5">Student</th>
              <th class="px-4 py-3.5 text-center">Correct</th>
              <th class="px-4 py-3.5 text-center">Score</th>
              <th class="px-4 py-3.5 text-center">Submitted</th>
              <th class="px-6 py-3.5 text-right">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-400">
            <% if @student_performance_list.any? %>
              <% @student_performance_list.each_with_index do |row, index| %>
                <tr>
                  <td class="px-6 py-3.5 font-bold font-mono text-slate-900 dark:text-white">#<%= index + 1 %></td>
                  <td class="px-6 py-3.5 font-semibold text-slate-800 dark:text-slate-200"><%= row[:email] %></td>
                  <td class="px-4 py-3.5 text-center font-mono"><%= row[:correct] %> / <%= row[:total] %></td>
                  <td class="px-4 py-3.5 text-center font-black text-slate-900 dark:text-white font-mono"><%= row[:percentage] %>%</td>
                  <td class="px-4 py-3.5 text-center"><%= l(row[:submitted_at], format: :short) %></td>
                  <td class="px-6 py-3.5 text-right whitespace-nowrap">
                    <% if row[:passed] %>
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 border border-emerald-200/40">✓ Passed</span>
                    <% else %>
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-red-50 dark:bg-red-950/40 text-red-700 border border-red-200/40">✗ Failed</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-12 text-slate-400 font-medium">No submissions yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
