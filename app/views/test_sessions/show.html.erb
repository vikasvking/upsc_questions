<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div class="border-b border-slate-200 dark:border-slate-800 pb-6">
      <%= link_to "← Back to Tests", test_sessions_path, class: "text-xs font-bold text-brand-800 dark:text-brand-400 hover:underline" %>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-white sm:text-3xl mt-1"><%= @test_session.title %> · Results</h1>
      <p class="text-sm text-slate-500 mt-0.5">
        <% if @test_session.pin_required? %>
          PIN: <span class="font-mono font-bold text-brand-800 bg-brand-50 dark:bg-brand-950/40 px-2 py-0.5 rounded-md select-all"><%= @test_session.pin_code %></span>
        <% else %>
          Open test (no PIN)
        <% end %>
        · Pass mark <%= @test_session.pass_mark_percentage %>%
        <% if @test_session.strict_mode? %> · <span class="font-semibold text-red-700 dark:text-red-400">🛡️ Strict mode</span><% end %>
        <% if @in_progress_count.positive? %> · <%= @in_progress_count %> student(s) still writing<% end %>
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-center min-h-[110px]">
        <p class="text-xs font-bold text-slate-400">Submitted</p>
        <p class="text-3xl font-semibold text-slate-900 dark:text-white mt-1"><%= @total_participants %> students</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-center min-h-[110px]">
        <p class="text-xs font-bold text-slate-400">Class Average</p>
        <p class="text-3xl font-semibold text-brand-800 dark:text-brand-400 mt-1"><%= marks_text(@class_average_marks) %> marks</p>
        <p class="text-xs text-slate-500"><%= @class_average_pct %>% correct</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-center min-h-[110px]">
        <p class="text-xs font-bold text-slate-400">🏆 Rank 1</p>
        <p class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 mt-2 truncate max-w-xs mx-auto" title="<%= @topper_email %>"><%= @topper_email %></p>
      </div>
    </div>

    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-3 border border-emerald-200 dark:border-emerald-900/40 text-xs text-emerald-800 dark:text-emerald-300 font-bold"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-3 border border-red-200 dark:border-red-900/40 text-xs text-red-800 dark:text-red-300 font-bold"><%= alert %></div>
    <% end %>

    <% if @test_session.live_view? %>
      <%= turbo_frame_tag "live_panel", src: live_test_session_path(@test_session),
            data: { controller: "auto-refresh", auto_refresh_interval_value: 15_000 } do %>
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 text-xs text-slate-400">Loading live view…</div>
      <% end %>
    <% end %>

    <% if @blocked_attempts.any? && !@test_session.live_view? %>
      <div class="space-y-4">
        <div>
          <h3 class="text-base font-semibold text-red-700 dark:text-red-400">🚫 Blocked students (<%= @blocked_attempts.size %>)</h3>
          <p class="text-xs text-slate-500">They left the test. Reinstate a student to let them continue with their saved answers; the time they lost while blocked is given back, up to the closing time. Blocked students are not ranked.</p>
        </div>
        <div class="overflow-x-auto rounded-xl border border-red-200 dark:border-red-900/50 shadow-sm bg-white dark:bg-slate-900">
          <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
            <thead class="bg-red-50/60 dark:bg-red-950/20 font-bold text-slate-900 dark:text-slate-300">
              <tr>
                <th class="px-4 py-3.5">Student</th>
                <th class="px-4 py-3.5">Reason</th>
                <th class="px-3 py-3.5 text-center">Blocked at</th>
                <th class="px-4 py-3.5 text-right"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-400">
              <% @blocked_attempts.each do |a| %>
                <tr>
                  <td class="px-4 py-3.5 font-semibold text-slate-800 dark:text-slate-200" title="<%= a.user.email_address %>"><%= a.user.display_name %></td>
                  <td class="px-4 py-3.5"><%= a.block_reason %></td>
                  <td class="px-3 py-3.5 text-center"><%= l(a.blocked_at, format: :short) %></td>
                  <td class="px-4 py-3.5 text-right">
                    <%= button_to "Reinstate", reinstate_test_session_path(@test_session, attempt_id: a.id), method: :post,
                                  data: { turbo_confirm: "Let #{a.user.display_name} continue this test?" },
                                  class: "rounded-lg bg-brand-800 hover:bg-brand-900 text-white font-bold text-xs px-3 py-1.5 cursor-pointer" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-3">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Students' ratings</h3>
        <span class="text-sm"><%= @rating_summary.count.positive? ? "★ #{@rating_summary.stars_text} from #{pluralize(@rating_summary.count, "student")}" : "No ratings yet" %></span>
      </div>
      <% if @rating_comments.any? %>
        <ul class="space-y-2 text-sm">
          <% @rating_comments.each do |r| %>
            <li><span class="text-amber-500"><%= "★" * r.stars %></span> <span class="text-slate-700 dark:text-slate-300"><%= r.comment %></span> <span class="text-xs text-slate-400">— <%= r.user.display_name %></span></li>
          <% end %>
        </ul>
      <% end %>
      <p class="text-xs text-slate-400">Students see the average on the test card once <%= Rating::MIN_SHOWN %> have rated.</p>
    </div>

    <div class="space-y-4">
      <div>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white">Rankings</h3>
        <p class="text-xs text-slate-500"><%= exam_name(@test_session.exam_type) %> marking: <%= @test_session.exam.marking_text %>. Equal marks → less time taken ranks higher.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm bg-white dark:bg-slate-900">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800 text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950 font-bold text-slate-900 dark:text-slate-300">
            <tr>
              <th class="px-4 py-3.5">Rank</th>
              <th class="px-4 py-3.5">Student</th>
              <th class="px-3 py-3.5 text-center">✓ / ✗ / Skip</th>
              <th class="px-3 py-3.5 text-center">Marks</th>
              <th class="px-3 py-3.5 text-center">Time taken</th>
              <th class="px-3 py-3.5 text-center">Correct %</th>
              <th class="px-3 py-3.5 text-center">Submitted</th>
              <th class="px-4 py-3.5 text-right">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-400">
            <% if @results.any? %>
              <% @results.each do |r| %>
                <tr>
                  <td class="px-4 py-3.5 font-bold font-mono text-slate-900 dark:text-white"><%= r.rank <= 3 ? %w[🥇 🥈 🥉][r.rank - 1] : "##{r.rank}" %></td>
                  <td class="px-4 py-3.5 font-semibold text-slate-800 dark:text-slate-200" title="<%= r.user.email_address %>"><%= r.user.display_name %></td>
                  <td class="px-3 py-3.5 text-center font-mono"><%= r.correct %> / <%= r.wrong %> / <%= r.skipped + r.unattempted %></td>
                  <td class="px-3 py-3.5 text-center font-semibold text-slate-900 dark:text-white font-mono"><%= marks_text(r.marks) %> / <%= marks_text(r.max_marks) %></td>
                  <td class="px-3 py-3.5 text-center font-mono"><%= duration_text(r.time_taken) %></td>
                  <td class="px-3 py-3.5 text-center"><%= r.percentage %>%</td>
                  <td class="px-3 py-3.5 text-center"><%= l(r.attempt.finished_at, format: :short) %></td>
                  <td class="px-4 py-3.5 text-right whitespace-nowrap">
                    <% if r.passed %>
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 border border-emerald-200/40">✓ Passed</span>
                    <% else %>
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 dark:bg-red-950/40 text-red-700 border border-red-200/40">✗ Failed</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="8" class="text-center py-12 text-slate-400 font-medium">No submissions yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
