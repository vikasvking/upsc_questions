<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 dark:border-slate-800 pb-6 gap-4">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl"><%= Current.user.admin? ? "All Tests" : "My Tests" %></h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Create tests, choose open or PIN access, set time windows and see results.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to "Bulk Import Excel 📥", upload_form_test_sessions_path, class: "rounded-xl border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs px-4 py-2.5 bg-white dark:bg-slate-950 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors text-center" %>
        <%= link_to "Create Test ➕", new_test_session_path, class: "rounded-xl bg-brand-800 hover:bg-brand-900 text-white font-bold text-xs px-4 py-2.5 shadow-sm transition-all text-center" %>
      </div>
    </div>

    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-900/50">
        <p class="text-xs font-bold text-emerald-800 dark:text-emerald-400 flex items-center gap-x-2"><span>✓</span> <%= notice %></p>
      </div>
    <% end %>
    <% if alert %>
      <div class="rounded-xl bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50">
        <p class="text-xs font-bold text-red-800 dark:text-red-400 flex items-center gap-x-2"><span>✗</span> <%= alert %></p>
      </div>
    <% end %>

    <%= render "shared/exam_tabs", counts: @exam_counts, current: @exam %>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <% if @test_sessions.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[1050px] table-fixed text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-950/70 dark:text-slate-400">
              <tr>
                <th scope="col" class="w-[26%] px-4 py-3 font-semibold">Test</th>
                <% if Current.user.admin? %><th scope="col" class="w-[18%] px-4 py-3 font-semibold">Teacher</th><% end %>
                <th scope="col" class="w-[16%] px-4 py-3 font-semibold">Format</th>
                <th scope="col" class="w-[18%] px-4 py-3 font-semibold">Schedule</th>
                <th scope="col" class="w-[12%] px-4 py-3 font-semibold">Access</th>
                <th scope="col" class="w-[10%] px-4 py-3 text-right font-semibold">Manage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% @test_sessions.each do |test| %>
                <% status = test.window_status %>
                <% status_label, status_class =
                  case status
                  when :upcoming then ["Opens #{l(test.starts_at, format: :short)}", "bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-900/60"]
                  when :closed then ["Closed #{l(test.ends_at, format: :short)}", "bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-400"]
                  else test.ends_at ? ["Live until #{l(test.ends_at, format: :short)}", "bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-900/60"] : ["Live · no time window", "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"]
                  end %>
                <tr class="align-top transition-colors hover:bg-slate-50/80 dark:hover:bg-slate-800/40 <%= style_for_test(test)[:stripe] %>">
                  <td class="px-4 py-4">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <%= exam_chip(test.exam_type) %>
                      <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold <%= status_class %>"><%= status_label %></span>
                      <%= audience_chip(test) %>
                    </div>
                    <p class="mt-2 truncate font-semibold text-slate-900 dark:text-white" title="<%= test.title %>"><%= test.title %></p>
                    <% if test.editing_locked? %><p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">🔒 Editing locked</p><% elsif (lock_at = test.edit_lock_at) %><p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Editable until <%= l(lock_at, format: :short) %></p><% end %>
                  </td>
                  <% if Current.user.admin? %>
                    <td class="break-all px-4 py-4 text-slate-700 dark:text-slate-300"><%= test.user&.email_address || "#{exam_name(test.exam_type)} (teacher deleted)" %></td>
                  <% end %>
                  <td class="px-4 py-4 text-slate-600 dark:text-slate-300">
                    <p><%= kind_badge_for(test) %></p>
                    <p class="mt-2"><span class="font-semibold text-slate-900 dark:text-white"><%= @question_counts[test.id].to_i %></span> questions</p>
                    <p class="mt-1"><%= test.duration_minutes %> min · pass <%= test.pass_mark_percentage %>%</p>
                    <% if test.strict_mode? %><p class="mt-1 text-xs font-medium text-amber-700 dark:text-amber-300">Strict mode</p><% end %>
                  </td>
                  <td class="px-4 py-4 text-slate-600 dark:text-slate-300">
                    <% if test.starts_at || test.ends_at %>
                      <p><span class="text-slate-400">From</span> <%= test.starts_at ? l(test.starts_at, format: :short) : "Now" %></p>
                      <p class="mt-1"><span class="text-slate-400">Until</span> <%= test.ends_at ? l(test.ends_at, format: :short) : "No end" %></p>
                    <% else %>
                      <p>Available anytime</p>
                    <% end %>
                  </td>
                  <td class="px-4 py-4">
                    <% if test.pin_required? %>
                      <p class="text-xs text-slate-500 dark:text-slate-400">PIN</p>
                      <p class="mt-1 inline-block rounded-lg border border-dashed border-brand-800/30 bg-slate-50 px-2.5 py-1 font-mono font-bold text-brand-800 select-all dark:bg-slate-950 dark:text-brand-300"><%= test.pin_code %></p>
                    <% else %>
                      <span class="text-sm font-semibold text-emerald-700 dark:text-emerald-400">Open access</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-4">
                    <div class="flex flex-col items-end gap-2 whitespace-nowrap text-xs font-semibold">
                      <%= link_to (test.live_view? && status == :live ? "Live view" : "Results"), test_session_path(test), class: "text-brand-800 hover:underline dark:text-brand-300" %>
                      <% if test.editing_locked? %>
                        <span class="text-slate-400 dark:text-slate-500" title="Locked tests cannot be edited from this page">Edit locked</span>
                      <% else %>
                        <%= link_to "Edit test", edit_test_session_path(test), class: "text-slate-600 hover:underline dark:text-slate-300" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-16 text-center">
          <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">No tests<%= " for #{exam_name(@exam)}" if @exam %> yet</p>
          <p class="mt-1 text-xs text-slate-500">Create a test or bulk-import one from Excel.</p>
        </div>
      <% end %>
    </div>
    <%= render "shared/list_pager", total: (@exam ? @exam_counts[@exam] : @exam_counts.values.sum), noun: "test" %>

  </div>
</div>
