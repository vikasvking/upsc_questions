<div class="py-10 bg-white dark:bg-slate-950 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-6">

    <!-- Workspace Title Section Header & Action Controls Row -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 dark:border-slate-800 pb-6 gap-4">
      <div>
        <h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">Custom Test Suites</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Monitor deployed classroom tests, track enrollment markers, and view student performance analytics.</p>
      </div>

      <!-- Combined Action Trigger Control Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to "Bulk Import Excel 📥", upload_form_test_sessions_path, class: "rounded-xl border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs px-4 py-2.5 bg-white dark:bg-slate-950 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors cursor-pointer text-center" %>
        <%= link_to "Compile Custom Test ➕", new_test_session_path, class: "rounded-xl bg-rose-800 hover:bg-rose-900 text-white font-bold text-xs px-4 py-2.5 shadow-md transition-all text-center transform hover:-translate-y-0.5 cursor-pointer" %>
      </div>
    </div>

    <!-- Active Ingestion Notification Alerts Banners -->
    <% if notice %>
      <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-900/50 animate-fadeIn">
        <p class="text-xs font-bold text-emerald-800 dark:text-emerald-400 flex items-center gap-x-2"><span>✓</span> <%= notice %></p>
      </div>
    <% end %>

    <% if alert %>
      <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 p-4 border border-rose-200 dark:border-rose-900/50 animate-fadeIn">
        <p class="text-xs font-bold text-rose-800 dark:text-rose-400 flex items-center gap-x-2"><span>✗</span> <%= alert %></p>
      </div>
    <% end %>

    <!-- Custom Test Grid Row Layout Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% if @test_sessions.any? %>
        <% @test_sessions.each do |session| %>

          <!-- Individual Custom Test Session Card Container -->
          <div class="bg-slate-50 dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 flex justify-between items-center shadow-sm hover:border-rose-800/40 dark:hover:border-rose-500/40 transition-all">
            <div class="space-y-3">
              <div>
                <span class="inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-rose-100 dark:bg-rose-950/50 text-rose-800 dark:text-rose-400 border border-rose-200/20">
                  <%= session.exam_type %>
                </span>
                <h4 class="text-base font-black text-slate-900 dark:text-white mt-1">
                  <%= session.title %>
                </h4>
                <p class="text-xs text-slate-400 mt-0.5">
                  Hand-Picked Pool: <strong class="text-rose-800 dark:text-rose-400"><%= session.questions.count %> Questions</strong>
                </p>
              </div>

              <!-- Direct Internal View & Edit Navigation Shortcuts Links Row -->
              <div class="flex items-center gap-x-3 text-xs font-black pt-1">
                <%= link_to "View Performance 📊", test_session_path(session), class: "text-rose-800 dark:text-rose-400 hover:text-rose-900 dark:hover:text-rose-300 transition-colors" %>
                <span class="text-slate-300 dark:text-slate-700">|</span>
                <%= link_to "Edit Paper ⚙️", edit_test_session_path(session), class: "text-slate-500 dark:text-slate-400 hover:text-rose-800 dark:hover:text-rose-400 transition-colors" %>
              </div>
            </div>

            <!-- Room Credentials Access Security PIN Token Container Block -->
            <div class="text-right flex flex-col justify-center pl-4 border-l border-slate-200/60 dark:border-slate-800">
              <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest block">Access PIN</span>
              <span class="text-lg font-black text-rose-800 dark:text-rose-400 font-mono bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 px-3 py-1 rounded-xl mt-1.5 inline-block shadow-sm border-dashed border-rose-800/30 select-all" title="Click to copy passcode">
                <%= session.pin_code %>
              </span>
            </div>
          </div>

        <% end %>
      <% else %>
        <!-- Fallback Empty State Display Box Container Matrix -->
        <div class="md:col-span-2 text-center py-16 text-slate-400 dark:text-slate-500 font-medium bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-inner">
          <div class="text-3xl mb-2">🔐</div>
          <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No Custom Test Sessions Created Yet</p>
          <p class="text-xs text-slate-400 mt-1">Compile your first test or upload an Excel format template batch file above to generate an access code.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
