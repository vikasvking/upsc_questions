<% input = "mt-1 block w-full rounded-xl border-0 py-2.5 px-3 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white text-sm" %>
<% if @batch.errors.any? %>
  <ul class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300 list-disc pl-8">
    <% @batch.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
  </ul>
<% end %>
<%= form_with model: @batch, class: "bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-6 space-y-4" do |f| %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div><%= f.label :name, "Batch name", class: "text-xs font-bold text-slate-500" %><%= f.text_field :name, required: true, placeholder: "e.g. Batch A – UPSC 2027", class: input %></div>
    <div><%= f.label :institution_id, "School or coaching (optional)", class: "text-xs font-bold text-slate-500" %>
      <%= f.select :institution_id, Current.user.institutions.ordered.map { |i| [i.label, i.id] }, { include_blank: "—" }, class: input %></div>
  </div>
  <div>
    <p class="text-xs font-bold text-slate-500">Students (from your schools and coachings)</p>
    <input type="search" placeholder="🔍 Filter by name" class="<%= input %>" oninput="this.nextElementSibling.querySelectorAll('label').forEach(l => l.classList.toggle('hidden', !l.textContent.toLowerCase().includes(this.value.toLowerCase())))">
    <div class="mt-2 rounded-xl ring-1 ring-slate-200 dark:ring-slate-800 p-3 max-h-72 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 gap-1.5">
      <%= hidden_field_tag "batch[student_ids][]", "", id: nil %>
      <% @students.each do |s| %>
        <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
          <%= check_box_tag "batch[student_ids][]", s.id, @member_ids.include?(s.id), id: "batch_student_#{s.id}" %> <%= s.display_name %>
        </label>
      <% end %>
    </div>
    <% if @students.empty? %><p class="mt-1 text-xs text-slate-500">No students at your schools or coachings yet. Add them by email below.</p><% end %>
  </div>
  <div>
    <%= label_tag "batch[emails]", "Add students by email", class: "text-xs font-bold text-slate-500" %>
    <%= text_area_tag "batch[emails]", params.dig(:batch, :emails), rows: 2, placeholder: "student1@example.com, student2@example.com", class: input %>
  </div>
  <div class="flex gap-3">
    <%= link_to "Cancel", batches_path, class: "flex-1 text-center rounded-xl px-4 py-2.5 text-sm ring-1 ring-slate-200 dark:ring-slate-800 text-slate-600 dark:text-slate-300" %>
    <%= f.submit "Save batch", class: "flex-1 rounded-xl bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2.5 cursor-pointer" %>
  </div>
<% end %>
