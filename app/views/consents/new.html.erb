<% input = "mt-1.5 block w-full rounded-lg border-0 py-2.5 px-3 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white" %>
<div class="py-12 px-6">
  <div class="mx-auto w-full max-w-md space-y-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Parent's consent needed</h1>
      <p class="mt-2 text-sm text-slate-500">You are under 18, so a parent or guardian must agree before you can keep using Rankwise. We'll email them a code together with what they are agreeing to.</p>
    </div>
    <% if alert %><p class="rounded-lg bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300"><%= alert %></p><% end %>
    <% if @consent.errors.any? %>
      <ul class="rounded-lg bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300 list-disc pl-8">
        <% @consent.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    <% end %>
    <%= form_with model: @consent, url: parent_consent_path, method: :post, class: "rounded-2xl bg-white dark:bg-slate-900 ring-1 ring-slate-200/70 dark:ring-slate-800 p-6 space-y-4" do |f| %>
      <div>
        <%= f.label :parent_email, "Parent's email", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.email_field :parent_email, required: true, class: input %>
      </div>
      <div>
        <%= f.label :parent_phone, "Parent's mobile number", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.telephone_field :parent_phone, required: true, placeholder: "98XXXXXXXX", class: input %>
      </div>
      <details class="text-xs text-slate-600 dark:text-slate-400">
        <summary class="cursor-pointer font-medium">What your parent agrees to</summary>
        <p class="mt-2 whitespace-pre-line"><%= GuardianConsent::TEXT %></p>
      </details>
      <%= f.submit "Email the code to my parent", class: "w-full rounded-lg bg-brand-700 px-3 py-2.5 text-sm font-medium text-white hover:bg-brand-800 cursor-pointer" %>
    <% end %>
    <p class="text-xs text-slate-500">Wrong date of birth? <%= link_to "Fix it in your profile", edit_profile_path, class: "text-brand-700 dark:text-brand-300" %>.</p>
  </div>
</div>
