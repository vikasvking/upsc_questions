<div class="flex min-h-[80vh] flex-col justify-center px-6 py-12 lg:px-8 bg-white dark:bg-slate-950 transition-colors duration-200 w-full">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="text-center">
      <span class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
        UPSC<span class="text-rose-800 dark:text-rose-400">Officer</span>
      </span>
      <h2 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Create your account</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Join serious aspirants and get immediate access to 3,500+ questions.
      </p>
    </div>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-slate-50 dark:bg-slate-900 px-6 py-8 shadow-xl rounded-2xl border border-slate-200/60 dark:border-slate-800/80">

      <% if @user.errors.any? %>
        <div class="mb-4 rounded-md bg-red-50 dark:bg-red-950/40 p-3 border border-red-200 dark:border-red-900/50">
          <ul class="list-disc pl-5 text-sm text-red-800 dark:text-red-400 space-y-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: sign_up_path, class: "space-y-6" do |form| %>
    <div>
      <%= form.label :email_address, "Email Address", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
      <div class="mt-2">
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "block w-full rounded-md border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-rose-800 dark:focus:ring-rose-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm sm:leading-6" %>
      </div>
    </div>

    <div>
      <%= form.label :password, "Password", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
      <div class="mt-2">
        <%= form.password_field :password, required: true, autocomplete: "new-password", class: "block w-full rounded-md border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-rose-800 dark:focus:ring-rose-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm sm:leading-6" %>
      </div>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
      <div class="mt-2">
        <%= form.password_field :password_confirmation, required: true, class: "block w-full rounded-md border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-rose-800 dark:focus:ring-rose-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm sm:leading-6" %>
      </div>
    </div>

    <div>
      <%= form.submit "Create Account & Start Free", class: "flex w-full justify-center rounded-md bg-rose-800 dark:bg-rose-700 px-3 py-3 text-sm font-bold text-white shadow-md hover:bg-rose-900 dark:hover:bg-rose-600 transition-colors cursor-pointer transform hover:-translate-y-0.5" %>
    </div>
  <% end %>


      <div class="mt-6 text-center text-sm">
        <span class="text-slate-500 dark:text-slate-400">Already have an account?</span>
        <%= link_to "Log in instead", new_session_path, class: "font-semibold leading-6 text-rose-800 dark:text-rose-400 hover:text-rose-900" %>
      </div>
    </div>
  </div>
</div>
