<div class="py-10 min-h-screen w-full">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Reported problems</h1>
      <p class="text-sm text-slate-500 mt-1">Students' reports on your questions. Correcting an answer key re-marks everyone's saved answers automatically.</p>
    </div>
    <% if notice %><div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300"><%= notice %></div><% end %>
    <% if alert %><div class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300"><%= alert %></div><% end %>
    <div class="flex gap-2 text-sm">
      <% [[nil, "All"], ["open", "Open"], ["fixed", "Fixed"], ["dismissed", "No change needed"]].each do |value, label| %>
        <%= link_to label, question_reports_path(status: value), class: "rounded-full px-3 py-1 font-medium #{@status == value ? "bg-brand-700 text-white" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"}" %>
      <% end %>
    </div>
    <%= render "question_reports/list", reports: @reports %>
  </div>
</div>
