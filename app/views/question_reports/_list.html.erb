<%# locals: reports, show_teacher (bool) %>
<% status_class = { "open" => "bg-amber-50 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300", "fixed" => "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300", "dismissed" => "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300" } %>
<ul class="space-y-3">
  <% reports.each do |r| %>
    <li class="bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-5 space-y-2">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="rounded-full px-2 py-0.5 font-semibold <%= status_class[r.status] %>"><%= r.status_label %></span>
        <span class="font-semibold text-slate-900 dark:text-white"><%= r.kind_label %></span>
        <span class="text-slate-500">by <%= r.user.display_name %> · <%= time_ago_in_words(r.created_at) %> ago</span>
        <% if local_assigns[:show_teacher] %><span class="text-slate-500">· question by <%= r.question.user&.display_name || "a deleted teacher" %></span><% end %>
      </div>
      <p class="text-sm text-slate-700 dark:text-slate-300"><span class="text-xs text-slate-400"><%= exam_name(r.question.exam_type) if r.question.exam_type.present? %> · <%= r.question.topic %> · answer <%= r.question.correct_answer %></span><br><%= r.question.content.truncate(240) %></p>
      <% if r.message %><p class="text-sm text-slate-900 dark:text-white">“<%= r.message %>”</p><% end %>
      <% if r.response %><p class="text-xs text-slate-500">Reply: <%= r.response %></p><% end %>
      <div class="flex flex-wrap items-center gap-2 pt-1">
        <%= link_to "Edit question", (local_assigns[:show_teacher] ? edit_admin_question_path(r.question) : edit_question_path(r.question)), class: "text-xs font-semibold text-brand-700 dark:text-brand-300" %>
        <% if r.open? %>
          <%= form_with url: question_report_path(r), method: :patch, class: "flex flex-1 flex-wrap gap-2" do %>
            <%= text_field_tag :response, nil, placeholder: "Reply to the student (optional)", class: "flex-1 min-w-40 rounded-lg border-0 py-1.5 px-2 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 bg-white dark:bg-slate-950 text-xs" %>
            <%= button_tag "Fixed", name: "status", value: "fixed", class: "rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold px-3 py-1.5 cursor-pointer" %>
            <%= button_tag "No change needed", name: "status", value: "dismissed", class: "rounded-lg ring-1 ring-slate-200 dark:ring-slate-800 text-xs px-3 py-1.5 text-slate-600 dark:text-slate-300 cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
<% if reports.empty? %><p class="text-sm text-slate-500">No reports.</p><% end %>
