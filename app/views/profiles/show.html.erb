<%
  card = "bg-white dark:bg-slate-900 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 p-6"
  sel  = "rounded-xl border-0 py-2 px-3 bg-white dark:bg-slate-950 ring-1 ring-inset ring-slate-200 dark:ring-slate-800 text-sm text-slate-900 dark:text-white"
  status_badge = { "approved" => ["Member", "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300"],
                   "pending"  => ["Waiting for approval", "bg-amber-50 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300"] }
%>
<div class="py-10 min-h-screen w-full">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="h-14 w-14 rounded-full bg-brand-100 dark:bg-brand-900 text-brand-800 dark:text-brand-100 grid place-items-center text-xl font-semibold"><%= @user.display_name.first.upcase %></div>
        <div>
          <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white"><%= @user.display_name %></h1>
          <p class="text-sm text-slate-500"><%= @user.role.humanize %><%= " · awaiting admin approval" if @user.pending_teacher? %> · joined <%= l(@user.created_at.to_date, format: :long) %></p>
        </div>
      </div>
      <%= link_to "Edit profile", edit_profile_path, class: "rounded-lg bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2 text-center" %>
    </div>

    <% if notice %><div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-300"><%= notice %></div><% end %>
    <% if alert %><div class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300"><%= alert %></div><% end %>

    <section class="<%= card %> grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
      <div>
        <p class="text-xs font-bold text-slate-400">Email</p>
        <p class="mt-1 text-slate-900 dark:text-white"><%= @user.email_address %></p>
        <% if @user.email_confirmed? %>
          <p class="mt-1 text-xs text-emerald-600">✓ Confirmed</p>
        <% else %>
          <div class="mt-1 flex items-center gap-2 text-xs">
            <span class="text-amber-700 dark:text-amber-400">Not confirmed yet</span>
            <% if Mailing.enabled? %>
              <%= button_to "Send link again", resend_email_confirmation_path, method: :post, class: "text-brand-700 dark:text-brand-300 underline cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @user.student? %>
        <div>
          <p class="text-xs font-bold text-slate-400">Date of birth</p>
          <p class="mt-1 text-slate-900 dark:text-white"><%= @user.date_of_birth ? l(@user.date_of_birth, format: :long) : "—" %></p>
        </div>
        <div class="sm:col-span-2">
          <p class="text-xs font-bold text-slate-400">Preparing for</p>
          <div class="mt-1.5 flex flex-wrap gap-1.5"><% @user.exam_codes.each do |c| %><%= exam_chip(c) %><% end %></div>
          <% if @user.exam_codes.size > 1 %>
            <%= form_with url: profile_exam_path, method: :patch, class: "mt-3 flex gap-2 items-center" do %>
              <span class="text-xs text-slate-500">Rank on my dashboard by</span>
              <%= select_tag :target_exam, options_for_select(@user.exam_codes.map { |c| [exam_name(c), c] }, @user.ranking_exam_code), class: sel %>
              <%= submit_tag "Save", name: nil, class: "rounded-lg bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold px-3 py-2 cursor-pointer" %>
            <% end %>
          <% end %>
        </div>
        <% if @user.minor? %>
          <div class="sm:col-span-2">
            <p class="text-xs font-bold text-slate-400">Parent's consent</p>
            <% if @consent %>
              <p class="mt-1 text-slate-900 dark:text-white">Given on <%= l(@consent.consented_at.to_date, format: :long) %> by <%= mask(@consent.parent_email) %></p>
              <p class="text-xs text-slate-500">To change your parent's details, ask the Rankwise admin.</p>
            <% else %>
              <p class="mt-1 text-amber-700 dark:text-amber-400">Not given yet. <%= link_to "Ask your parent", new_parent_consent_path, class: "underline" %></p>
            <% end %>
          </div>
        <% end %>
      <% elsif @user.teacher? %>
        <div>
          <p class="text-xs font-bold text-slate-400">Subjects</p>
          <p class="mt-1 text-slate-900 dark:text-white"><%= @user.subject_names.join(", ").presence || "—" %></p>
        </div>
        <div class="sm:col-span-2">
          <p class="text-xs font-bold text-slate-400">About me</p>
          <p class="mt-1 text-slate-700 dark:text-slate-300 whitespace-pre-line"><%= @user.bio.presence || "—" %></p>
        </div>
      <% end %>
    </section>

    <% if @my_reports.any? %>
      <section class="<%= card %> space-y-3">
        <h2 class="font-semibold text-slate-900 dark:text-white">Problems I reported</h2>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
          <% @my_reports.each do |r| %>
            <li class="py-2.5 space-y-0.5">
              <p class="text-slate-900 dark:text-white"><%= r.question.content.truncate(120) %></p>
              <p class="text-xs text-slate-500"><%= r.kind_label %> · <%= time_ago_in_words(r.created_at) %> ago · <span class="font-semibold <%= r.open? ? "text-amber-700 dark:text-amber-400" : "text-emerald-700 dark:text-emerald-400" %>"><%= r.status_label %></span></p>
              <% if r.response %><p class="text-xs text-slate-600 dark:text-slate-300">Teacher's reply: <%= r.response %></p><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% unless @user.admin? %>
      <section class="<%= card %> space-y-4">
        <div class="flex items-baseline justify-between">
          <h2 class="font-semibold text-slate-900 dark:text-white">My schools and coachings</h2>
          <% if @user.faculty? %><%= link_to "Manage requests and join codes →", institutions_path, class: "text-sm text-brand-700 dark:text-brand-300" %><% end %>
        </div>

        <% if @memberships.any? %>
          <ul class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
            <% @memberships.each do |m| %>
              <% label, klass = status_badge.fetch(m.status) %>
              <li class="py-2.5 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-medium text-slate-900 dark:text-white truncate"><%= m.institution.label %></p>
                  <span class="inline-block mt-0.5 rounded-full px-2 py-0.5 text-xs font-semibold <%= klass %>"><%= label %></span>
                </div>
                <%= button_to (m.approved? ? "Leave" : "Cancel request"), membership_path(m), method: :delete,
                      data: { turbo_confirm: "#{m.approved? ? "Leave" : "Cancel your request to join"} #{m.institution.name}?" },
                      class: "shrink-0 text-xs text-slate-500 hover:text-red-700 cursor-pointer" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-slate-500">You haven't joined a school or coaching yet.</p>
        <% end %>

        <% if @institutions.any? %>
          <%= form_with url: memberships_path, class: "grid grid-cols-1 sm:grid-cols-4 gap-2 pt-2 border-t border-slate-100 dark:border-slate-800" do %>
            <%= select_tag :institution_id, options_for_select(@institutions.map { |i| [i.label, i.id] }), include_blank: "Join a school or coaching…", required: true, class: "sm:col-span-2 #{sel}" %>
            <%= text_field_tag :join_code, nil, placeholder: "Join code (optional)", autocomplete: "off", class: "uppercase #{sel}" %>
            <%= submit_tag "Join", name: nil, class: "rounded-xl bg-brand-800 hover:bg-brand-900 text-white text-xs font-bold px-4 py-2 cursor-pointer" %>
          <% end %>
          <p class="text-xs text-slate-500">With the join code from your teacher you join straight away; without it, a teacher there approves you.<% if @user.faculty? %> Not listed? <%= link_to "Add it", institutions_path, class: "text-brand-700 dark:text-brand-300" %>.<% end %></p>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
