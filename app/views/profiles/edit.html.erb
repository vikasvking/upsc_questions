<div class="py-10 min-h-screen w-full transition-colors duration-200">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 space-y-8">

    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Modify Profile</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Update your email coordinates and change encryption keys.</p>
    </div>

    <div class="bg-white dark:bg-slate-900 px-6 py-8 shadow-sm rounded-2xl border border-slate-200 dark:border-slate-800">

      <% if @user.errors.any? %>
        <div class="mb-6 rounded-xl bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50">
          <ul class="list-disc pl-5 text-xs text-red-800 dark:text-red-400 space-y-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :email_address, "Update Email Address", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
          <div class="mt-2">
            <%= form.email_field :email_address, required: true, class: "block w-full rounded-xl border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-800 dark:focus:ring-brand-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm" %>
          </div>
        </div>

        <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
          <p class="text-xs font-bold text-slate-400 mb-4">Change Password (Leave blank to keep unchanged)</p>

          <div class="space-y-4">
            <div>
              <%= form.label :password, "New Secure Password", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
              <div class="mt-2">
                <%= form.password_field :password, autocomplete: "new-password", class: "block w-full rounded-xl border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-brand-800 dark:focus:ring-brand-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= form.label :password_confirmation, "Confirm New Password", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
              <div class="mt-2">
                <%= form.password_field :password_confirmation, class: "block w-full rounded-xl border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-brand-800 dark:focus:ring-brand-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm" %>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-200 dark:border-slate-800 pt-6">
          <%= label_tag "user[current_password]", "Current Password (required to save changes)", class: "block text-sm font-semibold leading-6 text-slate-900 dark:text-slate-200" %>
          <div class="mt-2">
            <%= password_field_tag "user[current_password]", nil, required: true, autocomplete: "current-password", class: "block w-full rounded-xl border-0 py-2.5 px-3 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-slate-700 focus:ring-2 focus:ring-inset focus:ring-brand-800 dark:focus:ring-brand-500 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm" %>
          </div>
        </div>

        <div class="flex gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <%= link_to "Cancel Changes", profile_path, class: "flex-1 text-center font-bold text-xs border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-950 px-4 py-3 rounded-xl hover:bg-slate-100 transition-colors shadow-sm" %>
          <%= form.submit "Apply Profile Changes", class: "flex-1 justify-center rounded-xl bg-brand-800 dark:bg-brand-700 px-4 py-3 text-xs font-bold text-white shadow-sm hover:bg-brand-900 dark:hover:bg-brand-600 transition-colors cursor-pointer" %>
        </div>
      <% end %>

    </div>
  </div>
</div>
