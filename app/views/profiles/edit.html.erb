<%
  input = "mt-1.5 block w-full rounded-xl border-0 py-2.5 px-3 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white sm:text-sm focus:ring-2 focus:ring-brand-700"
  label = "block text-sm font-semibold text-slate-900 dark:text-slate-200"
  card  = "bg-white dark:bg-slate-900 px-6 py-7 rounded-2xl ring-1 ring-slate-200/70 dark:ring-slate-800 space-y-5"
  missing = @user.missing_profile_items
%>
<div class="py-10 min-h-screen w-full">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 space-y-6">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Edit profile</h1>
      <% if missing.any? %>
        <p class="mt-2 rounded-xl bg-amber-50 dark:bg-amber-950/30 px-4 py-3 text-sm text-amber-900 dark:text-amber-200">Please add <%= missing.to_sentence %> to continue.</p>
      <% end %>
    </div>

    <% if alert %><div class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300"><%= alert %></div><% end %>
    <% if @user.errors.any? %>
      <ul class="rounded-xl bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-800 dark:text-red-300 list-disc pl-8 space-y-1">
        <% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    <% end %>

    <%# Details: no password needed %>
    <%= form_with model: @user, url: profile_details_path, method: :patch, class: card do |f| %>
      <h2 class="font-semibold text-slate-900 dark:text-white">About you</h2>
      <div>
        <%= f.label :name, "Full name", class: label %>
        <%= f.text_field :name, required: true, class: input %>
      </div>

      <% if @user.student? %>
        <div>
          <%= f.label :date_of_birth, "Date of birth", class: label %>
          <% if @user.date_of_birth_in_database.present? %>
            <p class="mt-1.5 text-sm text-slate-700 dark:text-slate-300"><%= l(@user.date_of_birth_in_database, format: :long) %> <span class="text-xs text-slate-500">· to correct it, ask the Lakshyank admin</span></p>
          <% else %>
            <%= f.date_field :date_of_birth, required: true, max: Date.current - 5.years, class: input %>
            <p class="mt-1 text-xs text-slate-500">Students under 18 need a parent's consent (a code is emailed to the parent).</p>
          <% end %>
        </div>
        <fieldset>
          <legend class="<%= label %>">Exams I'm preparing for</legend>
          <% chosen = params.dig(:user, :exam_codes) ? Array(params.dig(:user, :exam_codes)) : @user.exam_codes %>
          <div class="mt-2 grid grid-cols-2 sm:grid-cols-3 gap-2">
            <% Exam.all.each do |e| %>
              <label class="flex items-center gap-2 rounded-lg px-3 py-2 ring-1 ring-slate-200 dark:ring-slate-800 text-sm cursor-pointer has-[:checked]:ring-2 has-[:checked]:ring-brand-600">
                <%= check_box_tag "user[exam_codes][]", e.code, chosen.include?(e.code), id: "profile_exam_#{e.code}", class: "accent-brand-700" %>
                <span class="text-slate-900 dark:text-white"><%= e.name %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% elsif @user.teacher? %>
        <div>
          <%= label_tag "user[subjects]", "Subjects I teach", class: label %>
          <%= text_field_tag "user[subjects]", params.dig(:user, :subjects) || @user.subject_names.join(", "), list: "subject-suggestions", placeholder: "e.g. Polity, Modern History", class: input %>
          <datalist id="subject-suggestions"><% @subject_suggestions.each do |s| %><option value="<%= s %>"></option><% end %></datalist>
          <p class="mt-1 text-xs text-slate-500">Separate several subjects with commas.</p>
        </div>
        <div>
          <%= f.label :bio, "About me", class: label %>
          <%= f.text_area :bio, rows: 4, maxlength: 1000, class: input %>
        </div>
      <% end %>

      <div class="flex gap-3 pt-2">
        <%= link_to "Cancel", profile_path, class: "flex-1 text-center rounded-xl px-4 py-2.5 text-sm ring-1 ring-slate-200 dark:ring-slate-800 text-slate-600 dark:text-slate-300" %>
        <%= f.submit "Save", class: "flex-1 rounded-xl bg-brand-700 hover:bg-brand-800 text-white text-sm font-medium px-4 py-2.5 cursor-pointer" %>
      </div>
    <% end %>

    <%# Email and password: current password required %>
    <%= form_with model: @user, url: profile_path, method: :patch, class: card do |f| %>
      <h2 class="font-semibold text-slate-900 dark:text-white">Email and password</h2>
      <div>
        <%= f.label :email_address, "Email", class: label %>
        <%= f.email_field :email_address, required: true, class: input %>
        <p class="mt-1 text-xs text-slate-500">A new email must be confirmed again.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :password, "New password (leave blank to keep)", class: label %>
          <%= f.password_field :password, autocomplete: "new-password", class: input %>
          <p class="mt-1 text-xs text-slate-500">At least <%= PasswordPolicy::MIN_LENGTH %> characters, with letters and numbers.</p>
        </div>
        <div>
          <%= f.label :password_confirmation, "Repeat new password", class: label %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input %>
        </div>
      </div>
      <div>
        <%= label_tag "user[current_password]", "Current password (required to save these)", class: label %>
        <%= password_field_tag "user[current_password]", nil, required: true, autocomplete: "current-password", class: input %>
      </div>
      <%= f.submit "Save email and password", class: "w-full rounded-xl bg-slate-800 hover:bg-slate-900 dark:bg-slate-700 text-white text-sm font-medium px-4 py-2.5 cursor-pointer" %>
    <% end %>
  </div>
</div>
